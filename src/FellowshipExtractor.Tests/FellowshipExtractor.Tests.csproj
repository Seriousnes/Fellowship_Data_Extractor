<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Fellowship.SDK" />
    <Using Include="Fellowship.SDK.Calculations" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FellowshipExtractor\FellowshipExtractor.csproj" />
    <ProjectReference Include="..\Fellowship.Codex\Fellowship.Codex.csproj" />
    <ProjectReference Include="..\Fellowship.SDK\Fellowship.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TooltipAuditBaseline.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>