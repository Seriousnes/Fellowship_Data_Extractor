<Table Items="Rows" Group="Grouped" SortLink="Link" SortState="State">
    <Columns>
        <Column T="Probe" Head="" Class="cx-art">
            <Content Context="row">
                <i>@row.Art</i>
            </Content>
        </Column>
        <Column T="Probe" Head="Name" Key="name" Value="row => row.Name" />
        <Column T="Probe" Head="ILvl" Key="ilvl" Numeric Value="row => row.Level" />
        <Column T="Probe" Head="Cast" Unit="s" Value="row => row.Cast" />
    </Columns>
</Table>

@code {
    public sealed record Probe(string Art, string Name, int Level, double? Cast, string? Slot);

    [Parameter] public IReadOnlyList<Probe> Rows { get; set; } = [];

    [Parameter] public bool Grouping { get; set; }

    private Func<Probe, string?>? Grouped => Grouping ? row => row.Slot : null;

    private static string Link(string key) => $"/browse?sort={key}";

    private static string? State(string key) => key == "name" ? "ascending" : null;
}
