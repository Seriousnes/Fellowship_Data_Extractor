@inject ICodexViewService Ui

<Table Items="Documents" SortLink="View.SortLink" SortState="View.SortState"
       Group="Grouped.By<EntityDocument>(View, Ui.Codex)">
    <Columns>
        <Column Head="" Class="cx-texture">
            <Content Context="row"><Texture Entity="row" /></Content>
        </Column>
        <Column Head="Name" Key="SortingType.Name">
            <Content Context="row"><EntityLink Entity="row" Class="cx-nm" /></Content>
        </Column>
        <Column Head="Type" Key="SortingType.Type" Class="cx-tags">
            <Content Context="row">
                <a href="@View.OfType(EntityTypes.TypeOf(row))">
                    @PublicTypes.Label(EntityTypes.TypeOf(row))
                </a>
            </Content>
        </Column>
        <Column Head="Source" Key="SortingType.Source" Class="cx-tags">
            <Content Context="row">
                @foreach (var source in Sources(row))
                {
                    <Chip>@source</Chip>
                }
            </Content>
        </Column>
    </Columns>
</Table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<EntityDocument> Rows { get; set; } = [];

    [Parameter, EditorRequired] public BrowseView View { get; set; } = default!;

    private IReadOnlyList<EntityDocument> Documents = [];

    protected override void OnParametersSet() => Documents = Rows;

    private IEnumerable<string> Sources(EntityDocument row) =>
        Ui.Codex.Facet(FacetType.Source).Values(row);
}
