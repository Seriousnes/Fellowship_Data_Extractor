<DynamicComponent Type="Component(Type)" Parameters="Knobs" />

@code {
    [Parameter] public EntityType? Type { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<EntityDocument> Documents { get; set; } = [];

    [Parameter, EditorRequired] public BrowseView View { get; set; } = default!;

    private Dictionary<string, object?> Knobs =>
        new(StringComparer.Ordinal) { [nameof(Everything.Rows)] = Documents, [nameof(Everything.View)] = View };

    private static System.Type Component(EntityType? type) => type switch
    {
        null => typeof(Everything),
        EntityType.Item => typeof(Items),
        EntityType.Ability => typeof(Abilities),
        EntityType.Effect => typeof(Effects),
        EntityType.Talent => typeof(Talents),
        EntityType.Glyph => typeof(Glyphs),
        EntityType.GemAbility => typeof(GemAbilities),
        EntityType.Sigil or EntityType.Aspect or EntityType.ProtectiveEnchant => typeof(Augmentations),
        EntityType.Enchant => typeof(Enchants),
        EntityType.Gem => typeof(Gems),
        EntityType.Creature => typeof(Creatures),
        EntityType.Dungeon => typeof(Dungeons),
        EntityType.Mount => typeof(Mounts),
        EntityType.CompanionPet => typeof(CompanionPets),
        EntityType.Currency => typeof(Currencies),
        EntityType.LegendaryPower => typeof(LegendaryPowers),
        EntityType.WeaponPower => typeof(WeaponPowers),
        EntityType.RelicPower => typeof(RelicPowers),
        EntityType.RelicPassive => typeof(RelicPassives),
        _ => throw new InvalidOperationException(
            $"{PublicTypes.Label(type.Value)} is not a type the codex lists, so no browse component draws it."),
    };
}
