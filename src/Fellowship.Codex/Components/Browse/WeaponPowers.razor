@inject ICodexViewService Ui

<Table Items="Documents" SortLink="View.SortLink" SortState="View.SortState"
       Group="Grouped.By<WeaponPowerDocument>(View, Ui.Codex)">
    <Columns>
        <Column Head="" Class="cx-art">
            <Content Context="row"><Art Entity="row" /></Content>
        </Column>
        <Column Head="Name" Key="name">
            <Content Context="row"><EntityLink Entity="row" Class="cx-nm" /></Content>
        </Column>
        <Column Head="Cooldown" Key="cooldown" Unit="s" Numeric Value="row => row.Cooldown" />
        <Column Head="Cast" Key="cast" Unit="s" Numeric Value="row => row.CastTime" />
        <Column Head="Channel" Key="channel" Unit="s" Numeric Value="row => row.ChannelTime" />
        <Column Head="Range" Key="range" Numeric Value="row => row.Range" />
        <Column Head="Duration" Key="duration" Unit="s" Numeric Value="row => row.Duration" />
        <Column Head="School" Key="school" Class="cx-tags">
            <Content Context="row">
                @foreach (var school in row.Schools ?? [])
                {
                    <Chip>@school</Chip>
                }
            </Content>
        </Column>
    </Columns>
</Table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<EntityDocument> Rows { get; set; } = [];

    [Parameter, EditorRequired] public BrowseView View { get; set; } = default!;

    private IReadOnlyList<WeaponPowerDocument> Documents = [];

    protected override void OnParametersSet() => Documents = [.. Rows.OfType<WeaponPowerDocument>()];
}
