@inject ICodexViewService Ui

<Table Items="Documents" SortLink="View.SortLink" SortState="View.SortState"
       Group="Grouped.By<WeaponPowerDocument>(View, Ui.Codex)">
    <Columns>
        <Column Head="" Class="cx-texture">
            <Content Context="row"><Texture Entity="row" /></Content>
        </Column>
        <Column Head="Name" Key="SortingType.Name">
            <Content Context="row"><EntityLink Entity="row" Class="cx-nm" /></Content>
        </Column>
        <Column Head="Cooldown" Key="MeasureType.Cooldown" Unit="s" Numeric Value="row => row.Cooldown" />
        <Column Head="Cast" Key="MeasureType.Cast" Unit="s" Numeric Value="row => row.CastTime" />
        <Column Head="Channel" Key="MeasureType.Channel" Unit="s" Numeric Value="row => row.ChannelTime" />
        <Column Head="Range" Key="MeasureType.Range" Numeric Value="row => row.Range" />
        <Column Head="Duration" Key="MeasureType.Duration" Unit="s" Numeric Value="row => row.Duration" />
        <Column Head="School" Key="SortingType.School" Class="cx-tags">
            <Content Context="row">
                @foreach (var school in row.Schools ?? [])
                {
                    <Chip>@school</Chip>
                }
            </Content>
        </Column>
    </Columns>
</Table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<EntityDocument> Rows { get; set; } = [];

    [Parameter, EditorRequired] public BrowseView View { get; set; } = default!;

    private IReadOnlyList<WeaponPowerDocument> Documents = [];

    protected override void OnParametersSet() => Documents = [.. Rows.OfType<WeaponPowerDocument>()];
}
