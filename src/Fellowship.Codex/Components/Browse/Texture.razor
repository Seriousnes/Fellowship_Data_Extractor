@inject ICodexViewService Ui

@if (Entity is GlyphDocument glyph)
{
    <GlyphCrest Entity="glyph" Width="Width" />
}
else if (Entity is DungeonDocument dungeon)
{
    <img class="cx-banner-texture" alt="" loading="lazy" src="@Ui.Icon(dungeon.Icon)" />
}
else
{
    <Icon Src="@Ui.Icon(Entity)"
          Rarity="@Ui.RarityName(Entity)" Width="Width" />
}

@code {
    [Parameter, EditorRequired] public EntityDocument Entity { get; set; } = default!;

    [Parameter] public int Width { get; set; } = 34;
}
