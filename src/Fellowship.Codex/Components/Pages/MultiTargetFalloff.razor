@page "/tools/multi-target-falloff"
@using Fellowship.SDK.Models
@inject ICodexViewService Ui
@inject IEntityStoreService Store

<PageTitle>Multi-target damage falloff - Fellowship Codex</PageTitle>

<Crumbs Trail="@Trail" />

<h1>Multi-target damage falloff</h1>

@if (Formula.DisplayText.Length > 0)
{
    <Panel Head="Formula">
        <div class="cx-fo-formula" role="img" aria-label="@Formula.DisplayText"
             data-latex="@Formula.Latex">@Formula.DisplayText</div>

        @if (Formula.Symbols.Count > 0)
        {
            <div class="cx-fo-symbols">
                <Facts>
                    @foreach (var symbol in Formula.Symbols)
                    {
                        <Fact>
                            <Head><var>@symbol.Symbol</var></Head>
                            <ChildContent>@symbol.Meaning</ChildContent>
                        </Fact>
                    }
                </Facts>
            </div>
        }
    </Panel>
}

<Panel Head="Ability or talent">
    <FalloffPicker Type="Picked?.Type" Id="Picked?.Document.Id" />

    @if (Entries.Count > 1)
    {
        <div class="cx-fo-entries">
            <Knob Caption="Effect" As="div">
                <div class="cx-roster">
                    @for (var at = 0; at < Entries.Count; at++)
                    {
                        var entry = Entries[at];

                        <a href="@Address(Picked!, at, Damage, Targets)"
                           aria-current="@(at == Chosen ? "page" : null)">
                            <span class="cx-who">@Named(at)</span>
                            <span class="cx-fo-at">@CodexView.Number(entry.Threshold)</span>
                        </a>
                    }
                </div>
            </Knob>
        </div>
    }
</Panel>

@if (Picked is not { } source || Entry is not { } falloff)
{
    <Panel>
        <Empty Message="No ability or talent picked.">Choose one above.</Empty>
    </Panel>
}
else
{
    var split = DamageFalloff.Split(falloff.Threshold, source.MaxTargets, Damage, Targets);

    <Panel Head="@Named(Chosen)">
        <form class="cx-fo-form" method="get" action="@Page">
            <input type="hidden" name="@source.Key" value="@source.Document.Id" />
            @if (Entries.Count > 1)
            {
                <input type="hidden" name="@QueryKeys.Key(FalloffParameter.Entry)" value="@Chosen" />
            }

            <Knob Caption="Single-target damage">
                <input type="number" name="@QueryKeys.Key(FalloffParameter.Damage)" min="0" step="any" required
                       value="@Damage.ToString(CultureInfo.InvariantCulture)" />
            </Knob>

            <Knob Caption="Targets">
                <input type="number" name="@QueryKeys.Key(FalloffParameter.Targets)" min="0" step="1" required
                       value="@Targets" />
            </Knob>

            <button type="submit">Calculate</button>
        </form>

        <div class="cx-pairs">
            <Facts>
                <Fact Label="Threshold">@split.Threshold</Fact>
                @if (source.MaxTargets is { } cap)
                {
                    <Fact Label="Max targets">@CodexView.Number(cap)</Fact>
                }
                <Fact Label="Targets hit">@CodexView.Number(split.Targets)</Fact>
            </Facts>
            <Facts>
                <Fact Label="Scaler">@Scaled(split.Scaler)</Fact>
                <Fact Label="Damage per target">@CodexView.Number(split.PerTarget)</Fact>
                <Fact Label="Total damage">@CodexView.Number(split.Total)</Fact>
            </Facts>
        </div>
    </Panel>
}

@code {
    [SupplyParameterFromQuery(Name = nameof(FalloffParameter.Ability))] public string? Ability { get; set; }

    [SupplyParameterFromQuery(Name = nameof(FalloffParameter.Talent))] public string? Talent { get; set; }

    [SupplyParameterFromQuery(Name = nameof(FalloffParameter.Entry))] public string? Index { get; set; }

    [SupplyParameterFromQuery(Name = nameof(FalloffParameter.Damage))] public string? Given { get; set; }

    [SupplyParameterFromQuery(Name = nameof(FalloffParameter.Targets))] public string? Hit { get; set; }

    private const string Page = "/tools/multi-target-falloff";

    private const double StartingDamage = 1000;

    private const int StartingTargets = 1;

    private const string Unestablished = "Threshold";

    private static readonly IReadOnlyList<(string Label, string? Href)> Trail =
        [("Tools", null), ("Multi-target damage falloff", null)];

    private FalloffSource? Picked;

    private IReadOnlyList<TargetCountFalloff> Entries = [];

    private int Chosen;

    private TargetCountFalloff? Entry => Chosen < Entries.Count ? Entries[Chosen] : null;

    private MultiTargetDamageFalloff Formula => Store.Settings.MultiTargetDamageFalloff;

    private double Damage =>
        double.TryParse(Given, NumberStyles.Float, CultureInfo.InvariantCulture, out var amount) &&
        double.IsFinite(amount) && amount >= 0
            ? amount
            : StartingDamage;

    private int Targets => Whole(Hit) is { } count && count >= 0 ? count : StartingTargets;

    protected override void OnParametersSet()
    {
        Picked = DamageFalloff.Source(Store, EntityType.Ability, Whole(Ability)) ??
            DamageFalloff.Source(Store, EntityType.Talent, Whole(Talent));
        Entries = Picked?.Entries ?? [];
        Chosen = Whole(Index) is { } at && at >= 0 && at < Entries.Count ? at : 0;
    }

    private static int? Whole(string? value) =>
        int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed) ? parsed : null;

    private string Named(int at) =>
        Entries[at].Effect is { } effect
            ? Ui.Name(effect.Type, effect.Id)
            : Entries.Count(entry => entry.Effect is null) > 1
                ? $"{Unestablished} {at + 1}"
                : Unestablished;

    private static string Scaled(double scaler) =>
        Math.Round(scaler, 6).ToString(CultureInfo.InvariantCulture);

    private static string Address(FalloffSource source, int entry, double damage, int targets) =>
        $"{Page}?{source.Key}={source.Document.Id}&{QueryKeys.Key(FalloffParameter.Entry)}={entry}" +
        $"&{QueryKeys.Key(FalloffParameter.Damage)}={damage.ToString(CultureInfo.InvariantCulture)}&{QueryKeys.Key(FalloffParameter.Targets)}={targets}";
}
