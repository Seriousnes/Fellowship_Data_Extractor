@page "/{slug}/{id:int}"
@page "/{slug}/{id:int}/{named}"
@inject ICodexViewService Ui
@inject ICodexService Catalog
@inject IEntityStoreService Store
@inject NavigationManager Nav
@inject ICardService CardRenderer
@inject IExportHistoryService History

@if (Readings.Count > 0)
{
    <PageTitle>@Name - Fellowship Codex</PageTitle>
    <HeadContent>
        <meta property="og:site_name" content="Fellowship Codex" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="@Name" />
        <meta property="og:url" content="@Nav.ToAbsoluteUri(Ui.Href(Entity))" />
        @if (Card?.Summary() is { } summary)
        {
            <meta property="og:description" content="@summary" />
        }
        <meta property="og:image" content="@Nav.ToAbsoluteUri(Cards.Address(Ui, Entity, Search, Reading, History.Builds[0]))" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="@CardRenderer.Width" />
        <meta property="og:image:height" content="@CardRenderer.Height" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="theme-color" content="@(Card?.Colour ?? Ui.NameColour(Entity))" />
    </HeadContent>
    <Crumbs Trail="@(new List<(string, string?)> { (PublicTypes.Label(type), Under), (Name, null) })" />

    <h1 class="cx-entity-name"
        style="--cx-name:@Ui.NameColour(Entity);@(Rarity is null ? null : $"--cx-rarity:{Rarity};")color:var(--cx-rarity, var(--cx-name))">@Name</h1>

    <CascadingValue Value="Here">
        <div class="cx-entity">
            <Craft Slug="@Slug" Id="Id" Page="@Ui.Path(Entity)" Search="@Search" Hero="@Reading" />

            <div class="cx-entity-side">
                <Versions />
            </div>

            <Detail Entity="Entity" />

            <Nearby />
        </div>
    </CascadingValue>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    [Parameter] public int Id { get; set; }

    [Parameter] public string? Named { get; set; }

    [SupplyParameterFromQuery(Name = "hero")] public string? Hero { get; set; }

    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }

    private EntityType type;

    private IReadOnlyList<EntityDocument> Readings = [];

    private EntityDocument Entity = default!;

    private Bearings Here = new();

    private string Name => Ui.Name(Entity);

    private string Under => PublicTypes.Where(type);

    private IReadOnlyDictionary<string, string> Values
    {
        get
        {
            var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

            foreach (var (key, found) in Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(
                new Uri(Nav.Uri).Query))
            {
                if (found.FirstOrDefault() is { Length: > 0 } value) values[key] = value;
            }

            return values;
        }
    }

    private string Search => new Uri(Nav.Uri).Query;

    private string? Rarity =>
        Values.GetValueOrDefault("rarity") is { Length: > 0 } request &&
        Store.Rarity(request, Entity is GemDocument) is { } rarity
            ? CodexView.Readable(Ui.Tokens.Rarity(rarity.Name))
            : null;

    private TooltipLink Tip => Ui.Tip(Entity);

    private Fellowship.Codex.Embeds.CardModel? Card;

    private bool PicksHero => Readings.Count > 1 || (Entity as ItemDocument)?.Heroes is { Count: > 1 };

    private string? Reading
    {
        get
        {
            if (!PicksHero) return null;

            return Store.Hero(Hero) is { } hero && EntityStore.Reads(Entity, hero)
                ? hero.Name
                : Ui.Reading(Entity);
        }
    }

    protected override void OnParametersSet()
    {
        var resolved = EntityTypes.TryParse(Slug, out var parsed) && PublicTypes.IsListed(parsed)
            ? parsed
            : (EntityType?)null;
        type = resolved ?? default;
        Readings = resolved is { } t ? Store.All(t, Id) : [];

        if (Readings.Count == 0)
        {
            Entity = default!;
            Here = new Bearings();
            Nav.NotFound();
            return;
        }

        var wearer = Hero is null ? null : Store.Hero(Hero);

        Entity = (wearer is null ? null : Readings.FirstOrDefault(reading => EntityStore.Reads(reading, wearer)))
            ?? Readings.FirstOrDefault(reading => PublicTypes.Segment(reading) == Named)
            ?? Readings[0];

        var addressed = Ui.AddressedHero(Entity, wearer?.Name);

        if (Named != PublicTypes.Segment(Entity) || Hero != addressed)
        {
            var parameters = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
            parameters.Remove("hero");

            Nav.NavigateTo(Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(
                Ui.Href(Entity, wearer?.Name), parameters), replace: true);
            Readings = [];
            return;
        }

        Here = new Bearings
        {
            Entity = Entity,
            Readings = Readings,
            Reading = Reading,
            Tip = Tip,
            Page = Ui.Path(Entity),
            Under = Under,
            Label = PublicTypes.Label(type),
            Noun = PublicTypes.Noun(type),
            Id = Id,
            Related = Nearby(),
            Values = Values,
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        Card = Readings.Count == 0
            ? null
            : await CardRenderer.Card(Entity, PageQuery.Read(
                Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Search), Store, Reading, Entity));
    }

    private IReadOnlyList<(string, string)> Nearby()
    {
        var nearby = new List<(string, string)>();
        void Add(string facet, string? value)
        {
            if (value is null) return;
            if (Catalog.Facet(facet) is not { } definition) return;

            var count = Store.Entities.Count(row =>
                EntityTypes.TypeOf(row) == type && PublicTypes.IsListed(row) &&
                definition.Matches(row, [value]) &&
                Catalog.Flags.All(flag => flag.Admits(row)));

            if (count < 2) return;

            nearby.Add((
                $"{definition.Label}: {Catalog.Printed(definition, value)}",
                $"{Under}&{facet}={Uri.EscapeDataString(value)}"));
        }

        string? First(string key) => Catalog.Facet(key)?.Values(Entity).FirstOrDefault();

        Add("slot", First("slot"));
        Add("gem", First("gem"));

        var heroes = Catalog.Facet("hero")?.Values(Entity).ToArray() ?? [];
        Add("hero", heroes.Length == 1 ? heroes[0] : null);

        Add("school", First("school"));

        return nearby;
    }
}
