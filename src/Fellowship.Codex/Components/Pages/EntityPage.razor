@page "/{slug}/{id:int}"
@inject ICodexViewService Ui
@inject ICodexService Catalog
@inject IEntityStoreService Store
@inject ITooltipViewService Cards
@inject NavigationManager Nav

@if (Readings.Count > 0)
{
    <PageTitle>@Name - Fellowship Codex</PageTitle>
    <Crumbs Trail="@(new List<(string, string?)> { (PublicTypes.Label(type), Under), (Name, null) })" />

    <h1 class="cx-entity-name" style="--cx-name:@Ui.NameColour(Shown);color:var(--cx-rung, var(--cx-name))">@Name</h1>

    <CascadingValue Value="Here">
        <div class="cx-entity">
            <div class="cx-entity-top">
                <div class="cx-entity-tip" data-stage="@Address" data-restage="@Restage" aria-live="polite">
                    <Tooltip Entity="Shown" Query="Asking" Hero="Wearer" />
                </div>

                <div class="cx-entity-side">
                    <Knobs />
                    <Versions />
                    <Identity />
                </div>
            </div>

            <Detail Entity="Shown" />

            <Nearby />
        </div>
    </CascadingValue>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    [Parameter] public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "hero")] public string? Asked { get; set; }

    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }

    private EntityType type;

    private IReadOnlyList<EntityDocument> Readings = [];

    private EntityDocument Shown = default!;

    private Bearings Here = new();

    private string Name => Ui.Name(Shown);

    private string Under => $"/browse?type={EntityTypes.Slug(type)}";

    private static readonly string[] Own = ["hero", "state"];

    private IReadOnlyDictionary<string, string> Asked_
    {
        get
        {
            var asked = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

            foreach (var (key, values) in Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(
                new Uri(Nav.Uri).Query))
            {
                if (values.FirstOrDefault() is { Length: > 0 } value) asked[key] = value;
            }

            return asked;
        }
    }

    private IReadOnlyDictionary<string, string> Forwarded =>
        Asked_.Where(pair => !Own.Contains(pair.Key, StringComparer.OrdinalIgnoreCase))
            .ToDictionary(pair => pair.Key, pair => pair.Value, StringComparer.OrdinalIgnoreCase);

    private string? Restage => Forwarded.Count > 0 ? string.Empty : null;

    private string Address
    {
        get
        {
            var where = Ui.Tip(Shown);

            var carried = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase)
            {
                ["hero"] = where.Contains('?') ? null : Drawn,
                ["state"] = Cards.DrawsState(Shown) && !string.IsNullOrWhiteSpace(State) ? State : null,
            };

            foreach (var (key, value) in Forwarded) carried[key] = value;

            return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(where, carried);
        }
    }

    private bool PicksHero => Readings.Count > 1 || (Shown as ItemDocument)?.Heroes is { Count: > 1 };

    private TooltipQuery Asking => new() { Hero = Drawn, State = State };

    private HeroEntry? Wearer => Drawn is null ? null : Store.Hero(Drawn);

    private string? Drawn
    {
        get
        {
            if (!PicksHero) return null;

            return Store.Hero(Asked) is { } named && EntityStore.Reads(Shown, named)
                ? named.Name
                : Ui.Reading(Shown);
        }
    }

    protected override void OnParametersSet()
    {
        var resolved = EntityTypes.TryParse(Slug, out var named) && PublicTypes.Listed(named)
            ? named
            : (EntityType?)null;
        type = resolved ?? default;
        Readings = resolved is { } t ? Store.All(t, Id) : [];

        if (Readings.Count == 0)
        {
            Shown = default!;
            Here = new Bearings();
            Nav.NotFound();
            return;
        }

        Shown = Asked is not null && Store.Hero(Asked) is { } wearer
            ? Readings.FirstOrDefault(reading => EntityStore.Reads(reading, wearer)) ?? Readings[0]
            : Readings[0];

        Here = new Bearings
        {
            Shown = Shown,
            Readings = Readings,
            Reading = Drawn,
            Address = Address,
            Page = Ui.Href(type, Id),
            Under = Under,
            Label = PublicTypes.Label(type),
            Noun = PublicTypes.Noun(type),
            Id = Id,
            Related = Nearby(),
            Asked = Asked_,
        };
    }

    private IReadOnlyList<(string, string, int)> Nearby()
    {
        var nearby = new List<(string, string, int)>();
        var named = Catalog.Flag(CodexQuery.NamedFlag);

        void Add(string facet, string? value)
        {
            if (value is null) return;
            if (Catalog.Facet(facet) is not { } definition) return;

            var count = Store.Entities.Count(row =>
                EntityTypes.TypeOf(row) == type &&
                definition.Matches(row, [value]) &&
                (named is null || named.Predicate(row)));

            if (count < 2) return;

            nearby.Add((
                $"{definition.Label}: {Catalog.Printed(definition, value)}",
                $"{Under}&{facet}={Uri.EscapeDataString(value)}",
                count));
        }

        string? First(string key) => Catalog.Facet(key)?.Values(Shown).FirstOrDefault();

        Add("slot", First("slot"));
        Add("set", First("set"));
        Add("gem", First("gem"));
        Add("trait", First("trait"));

        var heroes = Catalog.Facet("hero")?.Values(Shown).ToArray() ?? [];
        Add("hero", heroes.Length == 1 ? heroes[0] : null);

        Add("school", First("school"));

        return nearby;
    }
}
