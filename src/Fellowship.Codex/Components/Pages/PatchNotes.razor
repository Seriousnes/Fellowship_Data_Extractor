@using System.Text
@using System.Text.Encodings.Web
@page "/patch-notes"
@page "/patch-notes/{Build}"
@inject IPatchNotesService Notes
@inject ICodexViewService Ui
@inject IEntityStoreService Store
@inject ITextureSource Textures
@inject IRichTextService Text
@inject NavigationManager Nav

<PageTitle>@Heading - Fellowship Codex</PageTitle>

<Crumbs Trail="@Trail" />

@if (Here is not { } here)
{
    <h1 id="@Top">@Label</h1>
    <Panel>
        <Empty Message="No patch notes." />
    </Panel>
}
else
{
    <div class="cx-pn-title" id="@Top">
        <p class="cx-pn-eyebrow">@Label</p>
        <h1>Build @here.Build</h1>
        <p class="cx-pn-dates">
            @Dated(here.Build), compared with build <a href="@Address(here.Previous)">@here.Previous</a>
        </p>
    </div>

    <div class="cx-pn">
        <aside class="cx-pn-rail">
            <Panel As="aside" Aria="Builds" Head="Builds" Class="cx-pn-builds">
                <nav id="@BuildsAnchor" aria-label="Builds">
                    @foreach (var build in Notes.Builds)
                    {
                        <a href="@Address(build)" aria-current="@(build == here.Build ? "page" : null)">
                            <span class="cx-pn-build">@build</span>
                            @if (Notes.Date(build) is { } date)
                            {
                                <span class="cx-pn-day">@Day(date)</span>
                            }
                        </a>
                    }
                </nav>
            </Panel>

            <Panel As="aside" Class="cx-rail cx-pn-contents" Aria="Contents" Head="Contents" Collapsible="true">
                <ol class="cx-pn-toc">
                    @foreach (var category in Sections)
                    {
                        <li>
                            <a class="cx-pn-toc-head" href="@Nav.Fragment(category.Anchor)">
                                <span>@category.Label</span>
                                <span>@category.Count.ToString("N0")</span>
                            </a>
                            <ol>
                                @foreach (var group in category.Groups)
                                {
                                    <li>
                                        <a href="@Nav.Fragment(group.Anchor)" style="@Tone(group.Colour)">
                                            <span>@group.Label</span>
                                            <span class="cx-pn-count">@group.Count.ToString("N0")</span>
                                        </a>
                                    </li>
                                }
                            </ol>
                        </li>
                    }
                </ol>
            </Panel>
        </aside>

        <section class="cx-pn-main">
            @if (Sections.Count == 0)
            {
                <Panel>
                    <Empty Message="Nothing changed." />
                </Panel>
            }
            else
            {
                <div class="cx-pn-bar">
                    <div class="cx-pn-show" role="radiogroup" aria-label="Show">
                        @foreach (var (key, label) in Shows)
                        {
                            <label class="cx-pn-show-@key">
                                <input type="radio" name="cx-pn-show" value="@key" checked="@(key == AllChanges)" />
                                <span>@(key == AllChanges ? $"{label} {Total:N0}" : label)</span>
                            </label>
                        }
                    </div>
                    <p class="cx-pn-kinds">
                        @foreach (var (label, count) in Kinds)
                        {
                            <span><b>@count.ToString("N0")</b> @label</span>
                        }
                    </p>
                </div>
            }

            @foreach (var category in Sections)
            {
                <h2 id="@category.Anchor" class="cx-pn-category">@category.Label</h2>

                @foreach (var group in category.Groups)
                {
                    <details id="@group.Anchor" class="cx-pn-group" open>
                        <summary>
                            @if (Portrait(group.Label) is { } portrait)
                            {
                                <img class="cx-pn-portrait" alt="" src="@portrait" />
                            }
                            <span class="cx-pn-group-name" style="@Tone(group.Colour)">@group.Label</span>
                            <span class="cx-pn-group-count">@group.Count.ToString("N0")</span>
                        </summary>
                        @foreach (var kind in group.Kinds)
                        {
                            <ul class="cx-pn-list">@Entries(kind)</ul>
                        }
                    </details>
                }
            }
        </section>
    </div>

    <a class="cx-pn-top" href="@Nav.Fragment(Top)" aria-label="Back to top">Top</a>
}

@code {
    [Parameter] public string? Build { get; set; }

    public const string Href = "/patch-notes";

    public const string Label = "Patch Notes";

    private const string Top = "pn-top";

    private const string BuildsAnchor = "pn-builds";

    private const string AllChanges = "all";

    private static readonly (string Key, string Label)[] Shows =
        [(AllChanges, "All"), ("added", "Added"), ("changed", "Changed"), ("removed", "Removed")];

    private int Total => Sections.Sum(category => category.Count);

    private IReadOnlyList<(string Label, int Count)> Kinds =>
    [
        .. Sections
            .SelectMany(category => category.Groups)
            .SelectMany(group => group.Kinds)
            .GroupBy(kind => kind.Label, StringComparer.Ordinal)
            .Select(kinds => (kinds.Key, kinds.Sum(kind => kind.Entries.Count)))
            .OrderByDescending(kind => kind.Item2),
    ];

    private IReadOnlyDictionary<string, string>? portraits;

    private string? Portrait(string label) =>
        (portraits ??= Store.Entities
            .OfType<HeroDocument>()
            .Where(hero => hero.Name is not null && hero.Portrait is not null)
            .DistinctBy(hero => hero.Name)
            .ToDictionary(
                hero => hero.Name!,
                hero => Textures.Address(hero.Portrait!, TextureSize.Small),
                StringComparer.OrdinalIgnoreCase))
        .GetValueOrDefault(label);

    public static string Address(string build) => $"{Href}/{Uri.EscapeDataString(build)}";

    public static string Address(string build, DocumentKey key) => $"{Address(build)}#{Anchor(key)}";

    private BuildNotes? Here;

    private IReadOnlyList<PatchNoteCategory> Sections = [];

    private HashSet<string> anchored = [];

    private string Heading => Here is { } here ? $"{Label}: Build {here.Build}" : Label;

    private IReadOnlyList<(string Label, string? Href)> Trail =>
        Here is { } here ? [(Label, Href), ($"Build {here.Build}", null)] : [(Label, null)];

    protected override void OnParametersSet()
    {
        anchored = new HashSet<string>(StringComparer.Ordinal);

        Here = Build is null
            ? Notes.Builds is [var newest, ..] ? Notes.Of(newest) : null
            : Notes.Of(Build);

        if (Build is not null && Here is null)
        {
            Nav.NotFound();
            return;
        }

        Sections = Here is null ? [] : PatchNoteSections.Of(Here.Notes, Ui);
    }

    private string Dated(string build) =>
        Notes.Date(build) is { } date
            ? $"Build {build}, {Day(date)} {date.UtcDateTime.ToString("HH:mm", CultureInfo.InvariantCulture)} UTC"
            : $"Build {build}";

    private static string Day(DateTimeOffset date) =>
        date.UtcDateTime.ToString("d MMM yyyy", CultureInfo.InvariantCulture);

    private static string? Tone(string? colour) => colour is null ? null : $"color:{colour}";

    private static string Anchor(DocumentKey key) => $"{key.Slug}-{key.Id.ToString(CultureInfo.InvariantCulture)}";

    private string? Anchor(PatchNote note) => anchored.Add(Anchor(note.Key)) ? Anchor(note.Key) : null;

    // A build can note thousands of entities, and their render tree frames alone exhaust the heap, so
    // each list is one markup frame.
    private MarkupString Entries(PatchNoteKind kind)
    {
        var html = new StringBuilder();

        foreach (var entry in kind.Entries)
        {
            html.Append("<li").Append(Attribute("id", Anchor(entry.Note))).Append('>');

            Entity(html, entry);

            if (entry.Note.Fields.Count > 0)
            {
                html.Append("<div class=\"cx-pn-lines\">");

                foreach (var run in Runs(entry.Note.Fields))
                {
                    if (Modifier(run) is { } modifier)
                    {
                        html.Append("<div class=\"cx-pn-line\"").Append(Attribute("data-change", modifier.Change)).Append('>')
                            .Append("<span class=\"cx-pn-target\">").Append(Encoded(modifier.Target)).Append("</span>")
                            .Append("<span class=\"cx-pn-field\">").Append(Encoded(modifier.Field)).Append("</span>")
                            .Append("<span class=\"cx-pn-value\">")
                            .Append(modifier.Change == "removed" ? "<del>" : "<ins>").Append(Encoded(modifier.Value))
                            .Append(modifier.Change == "removed" ? "</del>" : "</ins>").Append("</span>");

                        if (modifier.While is { } condition)
                        {
                            html.Append("<span class=\"cx-pn-note\">while ").Append(Encoded(condition)).Append("</span>");
                        }

                        html.Append("<span class=\"cx-pn-badge\">").Append(Encoded(Titled(modifier.Change))).Append("</span></div>");
                        continue;
                    }

                    foreach (var field in run)
                    {
                        var change = Change(field);

                        html.Append("<div class=\"cx-pn-line\"").Append(Attribute("data-change", change)).Append('>')
                            .Append("<span class=\"cx-pn-field\">").Append(Encoded(field.Label)).Append("</span>");
                        Value(html, field);
                        html.Append("<span class=\"cx-pn-badge\">").Append(Encoded(Titled(change))).Append("</span></div>");
                    }
                }

                html.Append("</div>");
            }

            html.Append("</li>");
        }

        return new MarkupString(html.ToString());
    }

    private static string Encoded(string? text) => text is null ? string.Empty : HtmlEncoder.Default.Encode(text);

    private static string Attribute(string name, string? value) =>
        value is null ? string.Empty : $" {name}=\"{Encoded(value)}\"";

    private void Entity(StringBuilder html, PatchNoteEntry entry)
    {
        var document = entry.Document;
        var icon = Ui.Icon(entry.Note.Icon);
        var linked = document is not null && PublicTypes.IsSearched(document);
        var tip = document is not null && PublicTypes.IsListed(entry.Type)
            ? ExportTooltipEndpoint.Address(Here!.Build, entry.Type, entry.Note.Key.Id)
            : null;

        html.Append("<div class=\"cx-pn-entity\">");

        if (icon is not null)
        {
            html.Append("<img class=\"cx-pn-icon\" alt=\"\" loading=\"lazy\"").Append(Attribute("src", icon)).Append(" />");
        }

        else
        {
            html.Append("<span class=\"cx-pn-icon\" aria-hidden=\"true\"></span>");
        }

        html.Append("<span class=\"cx-pn-named\">");

        if (linked)
        {
            html.Append("<a").Append(Attribute("href", Ui.Href(document!)))
                .Append(Attribute("data-tip", tip))
                .Append(Attribute("data-tip-request", tip is null ? null : Ui.Tip(document!, true).Body))
                .Append(Attribute("style", Tone(Ui.LinkColour(document!))))
                .Append('>').Append(Encoded(entry.Name)).Append("</a>");
        }
        else
        {
            html.Append("<span>").Append(Encoded(entry.Name)).Append("</span>");
        }

        html.Append("<span class=\"cx-pn-kind\">").Append(Encoded(Titled(PublicTypes.Noun(entry.Type))));

        if (entry.Note.Added) html.Append(" <span class=\"cx-pn-new\" data-change=\"added\">New</span>");

        html.Append("</span></span></div>");
    }

    private const string Step = " › ";

    private sealed record ModifierLine(string Change, string Target, string Field, string Value, string? While);

    // A change record diffs into one field per member, under a label shared up to its last step.
    private static IEnumerable<IReadOnlyList<PatchNoteField>> Runs(IReadOnlyList<PatchNoteField> fields)
    {
        var run = new List<PatchNoteField>();
        string? owner = null;

        foreach (var field in fields)
        {
            var at = field.Label.LastIndexOf(Step, StringComparison.Ordinal);
            var head = at < 0 ? null : field.Label[..at];

            if (run.Count > 0 && (head is null || head != owner))
            {
                yield return run;
                run = [];
            }

            owner = head;
            run.Add(field);
        }

        if (run.Count > 0) yield return run;
    }

    private static ModifierLine? Modifier(IReadOnlyList<PatchNoteField> run)
    {
        if (run.Count < 4) return null;

        var changes = run.Select(Change).Distinct().ToArray();
        if (changes is not [var change] || change == "changed") return null;

        var members = run.DistinctBy(field => field.Label).ToDictionary(
            field => field.Label[(field.Label.LastIndexOf(Step, StringComparison.Ordinal) + Step.Length)..],
            field => change == "removed" ? field.Older : field.Newer,
            StringComparer.Ordinal);

        string? Member(string name) => members.GetValueOrDefault(PatchNoteDiff.Spaced(name));

        if (Member(nameof(Fellowship.SDK.Models.Change.Target)) is not { } target ||
            Member(nameof(Fellowship.SDK.Models.Change.Field)) is not { } field ||
            Member(nameof(Fellowship.SDK.Models.Change.Op)) is not { } op ||
            !double.TryParse(Member(nameof(Fellowship.SDK.Models.Change.Value)), NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
        {
            return null;
        }

        var percent = Member(nameof(Fellowship.SDK.Models.Change.Percent)) == "true";

        return new ModifierLine(
            change, target, Titled(FellowshipCodex.Spaced(field)), CodexView.Modifier(op, value, percent),
            Member(nameof(Fellowship.SDK.Models.Change.While)) ?? members
                .Where(member => member.Key.StartsWith(PatchNoteDiff.Spaced(nameof(Fellowship.SDK.Models.Change.While)) + " ", StringComparison.Ordinal) && member.Key[^1..].All(char.IsDigit))
                .Select(member => member.Value).FirstOrDefault());
    }

    private static string Change(PatchNoteField field) =>
        field.Older is null ? "added" : field.Newer is null ? "removed" : "changed";

    private static string Titled(string text) =>
        text.Length == 0 ? text : char.ToUpperInvariant(text[0]) + text[1..];

    private void Value(StringBuilder html, PatchNoteField field)
    {
        var older = field.Older is null ? null : Text.Plain(field.Older);
        var newer = field.Newer is null ? null : Text.Plain(field.Newer);

        if (older is null)
        {
            html.Append($"<span class=\"cx-pn-value\"><ins>{Encoded(newer)}</ins></span>");
        }
        else if (newer is null)
        {
            html.Append($"<span class=\"cx-pn-value\"><del>{Encoded(older)}</del></span>");
        }
        else if (WordDiff.Reads(older, newer))
        {
            html.Append("<span class=\"cx-pn-value cx-pn-prose\">");

            foreach (var word in WordDiff.Between(older, newer))
            {
                html.Append(word.Change switch
                {
                    WordChange.Removed => $"<del>{Encoded(word.Text)}</del>",
                    WordChange.Added => $"<ins>{Encoded(word.Text)}</ins>",
                    _ => Encoded(word.Text),
                });
            }

            html.Append("</span>");
        }
        else
        {
            html.Append($"<span class=\"cx-pn-value\"><del>{Encoded(older)}</del> <span class=\"cx-pn-arrow\" aria-label=\"to\">&rarr;</span> <ins>{Encoded(newer)}</ins></span>");
        }
    }
}
