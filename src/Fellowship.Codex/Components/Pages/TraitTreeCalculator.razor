@page "/tools/trait-trees"
@using Fellowship.SDK.Models
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Primitives
@inject ICodexViewService Ui
@inject IEntityStoreService Store

<PageTitle>Trait trees - Fellowship Codex</PageTitle>

<Crumbs Trail="@Trail" />

<h1>Trait trees</h1>

<Panel Head="Item" Badge="@Roster">
    @foreach (var slot in Slots)
    {
        <SubHead>@slot.Key</SubHead>
        <div class="cx-roster cx-tree-roster">
            @foreach (var choice in slot)
            {
                <a href="@Address(choice.Id)"
                   aria-current="@(choice.Id == Chosen?.Id ? "page" : null)"
                   style="color:@Colour(choice)">
                    @if (Ui.Icon(choice.Icon) is { } icon)
                    {
                        <img class="cx-tree-roster-icon" alt="" src="@icon" />
                    }
                    <span class="cx-who">@PublicTypes.NameOf(choice)</span>
                </a>
            }
        </div>
    }
</Panel>

@if (Chosen is not { } item || Tree is not { Layout: { } layout } tree)
{
    <Panel>
        <Empty Message="No item picked.">Choose one above to lay its trait tree out.</Empty>
    </Panel>
}
else
{
    <Panel Head="@($"{PublicTypes.NameOf(item)}’s trait tree")">
        <div class="cx-tal-bar">
            <p class="cx-tal-spend">
                <b>@Picks.Count</b> of @Capacity traits infused
            </p>

            @if (Picks.Count == 0)
            {
                <span class="cx-tal-act" aria-disabled="true">Reset</span>
            }
            else
            {
                <a class="cx-tal-act" href="@Address(item.Id)">Reset</a>
            }

            <button type="button" class="cx-tal-act" data-copy>Copy link</button>
        </div>

        <div class="cx-tree" style="@Board(layout)">
            <svg class="cx-tree-edges" viewBox="@ViewBox(layout)" preserveAspectRatio="none" aria-hidden="true">
                @foreach (var node in tree.Nodes)
                {
                    foreach (var parent in node.ParentNodes)
                    {
                        var from = Point(tree, layout, parent);
                        var to = Point(tree, layout, node.UITreeIndex);

                        <line class="@(Picks.ContainsKey(node.UITreeIndex) && TraitTrees.Lit(Node(tree, parent)!, Picks) ? "on" : null)"
                              x1="@Coordinate(from.X)" y1="@Coordinate(from.Y)" x2="@Coordinate(to.X)" y2="@Coordinate(to.Y)" />
                    }
                }
            </svg>

            <span class="cx-tree-root" style="@($"{Placed(layout, layout.Root)};{Spread(layout)}")"
                  data-tip="@ItemTip.Address" data-tip-request="@ItemTip.Body">
                @foreach (var layer in layout.RootLayers)
                {
                    if (layer.Item)
                    {
                        <img class="cx-tree-layer item" alt="" src="@Ui.Icon(item.Icon)" style="@Sized(layout, layer)" />
                    }
                    else if (layer.Texture is { } texture)
                    {
                        <img class="cx-tree-layer" alt="" src="@Ui.Chrome.Texture(texture)" style="@Sized(layout, layer)" />
                    }
                }
            </span>

            @foreach (var node in tree.Nodes.Where(node => !TraitTrees.Root(node)))
            {
                var mine = node;

                if (!layout.Nodes.TryGetValue(mine.UITreeIndex, out var spot)) continue;

                if (Picks.TryGetValue(mine.UITreeIndex, out var trait))
                {
                    var tip = Ui.Tip(trait);

                    <a class="cx-tree-node" href="@Address(item.Id, Picks, mine.UITreeIndex)" style="@Placed(layout, spot)"
                       aria-current="@(At == mine.UITreeIndex ? "true" : null)"
                       data-tip="@tip.Address" data-tip-request="@tip.Body">@Face(mine, trait, Selected)</a>
                }
                else if (TraitTrees.Allocatable(tree, Picks, mine))
                {
                    <a class="cx-tree-node" href="@Address(item.Id, Picks, mine.UITreeIndex)" style="@Placed(layout, spot)"
                       aria-current="@(At == mine.UITreeIndex ? "true" : null)"
                       title="@Offer(mine)">@Face(mine, null, Available)</a>
                }
                else
                {
                    <span class="cx-tree-node" aria-disabled="true" tabindex="0" style="@Placed(layout, spot)"
                          title="@Offer(mine)">@Face(mine, null, Unavailable)</span>
                }
            }
        </div>

        <div class="cx-tree-item">
            @if (Ui.Icon(item.Icon) is { } icon)
            {
                <img alt="" src="@icon" />
            }
            <div>
                <b>@PublicTypes.NameOf(item)</b>
                <span>@item.Slot</span>
            </div>
        </div>

        <Note>Choose a lit node to infuse a trait into it. Each row takes one trait, and a node opens once a node it follows is infused.</Note>
    </Panel>

    @if (Choosing is { } choosing)
    {
        <Panel Head="@($"Node {choosing.UITreeIndex}: {Categories(choosing)}")" Badge="@Offered.Count.ToString()">
            <div class="cx-tree-choices">
                @if (Picks.ContainsKey(choosing.UITreeIndex))
                {
                    <a class="cx-tal-act" href="@Address(item.Id, Without(tree, choosing.UITreeIndex))">Remove</a>
                }

                @foreach (var offered in Offered)
                {
                    var choice = offered;
                    var tip = Ui.Tip(choice);

                    if (Picks.TryGetValue(choosing.UITreeIndex, out var current) && current.Id == choice.Id)
                    {
                        <span class="cx-tree-choice" aria-current="true"
                              data-tip="@tip.Address" data-tip-request="@tip.Body">@Choice(choosing, choice)</span>
                    }
                    else if (Picks.Values.Any(taken => taken.Id == choice.Id))
                    {
                        <span class="cx-tree-choice" aria-disabled="true" tabindex="0"
                              data-tip="@tip.Address" data-tip-request="@tip.Body">@Choice(choosing, choice)</span>
                    }
                    else
                    {
                        <a class="cx-tree-choice" href="@Address(item.Id, With(tree, choosing.UITreeIndex, choice))"
                           data-tip="@tip.Address" data-tip-request="@tip.Body">@Choice(choosing, choice)</a>
                    }
                }
            </div>
        </Panel>
    }

    @if (Store.Settings.TraitNodeUpgradeCosts.Count > 0)
    {
        <Panel Head="Upgrade costs">
            <KeyValues>
                @foreach (var cost in Store.Settings.TraitNodeUpgradeCosts)
                {
                    <KeyValue Key="@($"Rank {cost.Rank}")">
                        @cost.Cost.ToString("N0", CultureInfo.InvariantCulture) <Ref Entity="new EntityReference(EntityType.Currency, cost.Currency, null)" />
                    </KeyValue>
                }
            </KeyValues>
        </Panel>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "item")] public int? Item { get; set; }

    [SupplyParameterFromQuery(Name = "picks")] public string? Picked { get; set; }

    [SupplyParameterFromQuery(Name = "at")] public int? At { get; set; }

    private const string Page = "/tools/trait-trees";

    private const double Scale = 1.25;

    private const string Selected = "selected";

    private const string Available = "available";

    private const string Unavailable = "unavailable";

    private static readonly IReadOnlyList<(string Label, string? Href)> Trail =
        [("Tools", null), ("Trait trees", null)];

    private IReadOnlyList<ItemDocument> Choices = [];

    private IReadOnlyList<IGrouping<string, ItemDocument>> Slots = [];

    private ItemDocument? Chosen;

    private TraitTreeEntry? Tree;

    private IReadOnlyDictionary<int, TraitDocument> Picks = new Dictionary<int, TraitDocument>();

    private TraitTreeNode? Choosing;

    private IReadOnlyList<TraitDocument> Offered = [];

    private TooltipLink ItemTip = default!;

    private string Roster => $"{Choices.Count} items";

    private int Capacity => TraitTrees.Capacity(Tree?.Tag, Store.Settings) ?? 0;

    protected override void OnParametersSet()
    {
        Choices = TraitTrees.Items(Store);

        Slots =
        [
            .. Choices
                .OrderBy(choice => choice.Hero?.ToString(), StringComparer.OrdinalIgnoreCase)
                .ThenBy(choice => PublicTypes.NameOf(choice), StringComparer.OrdinalIgnoreCase)
                .GroupBy(choice => choice.Slot ?? string.Empty),
        ];

        Chosen = Item is { } id ? Choices.FirstOrDefault(choice => choice.Id == id) : null;
        Tree = TraitTrees.Find(Chosen?.TraitTree, Store.Settings);
        Picks = Tree is null ? new Dictionary<int, TraitDocument>() : TraitTrees.Read(Picked, Tree, Store);

        Choosing = Tree?.Nodes.FirstOrDefault(node =>
            node.UITreeIndex == At && (Picks.ContainsKey(node.UITreeIndex) || TraitTrees.Allocatable(Tree, Picks, node)));

        Offered = Choosing is null ? [] : TraitTrees.Offered(Choosing, Store);

        if (Chosen is not null) ItemTip = Ui.Tip(Chosen, showIcon: true);
    }

    private RenderFragment Face(TraitTreeNode node, TraitDocument? trait, string state) =>
        @<span class="cx-tree-face">
            <img class="cx-tree-frame" alt="" src="@Ui.Chrome.TraitNode(state)" />
            @if (trait is not null && Ui.Icon(trait.Icon) is { } icon)
            {
                <span class="cx-tree-well"><img alt="" src="@icon" /></span>
            }
            <img class="cx-tree-tint" alt=""
                 src="@Ui.Chrome.TraitNodeColor(state == Unavailable ? [] : node.TraitCategories)" />
        </span>;

    private RenderFragment Choice(TraitTreeNode node, TraitDocument trait) =>
        @<span class="cx-tree-option">
            <span class="cx-tree-face">
                <img class="cx-tree-frame" alt="" src="@Ui.Chrome.TraitNode(Selected)" />
                @if (Ui.Icon(trait.Icon) is { } icon)
                {
                    <span class="cx-tree-well"><img alt="" src="@icon" /></span>
                }
                <img class="cx-tree-tint" alt="" src="@Ui.Chrome.TraitNodeColor(node.TraitCategories)" />
            </span>
            <span class="cx-tree-option-name">@Ui.Name(trait)</span>
        </span>;

    private string Colour(ItemDocument choice) =>
        Store.All(EntityType.Item, choice.Id).Count() == 1 && choice.Hero is { } hero
            ? Ui.HeroColour(hero.ToString()) ?? "var(--muted)"
            : "var(--muted)";

    private string Categories(TraitTreeNode node) =>
        string.Join(" or ", node.TraitCategories.Select(category =>
            TraitTrees.CategoryName(category, Store) ?? category[(category.LastIndexOf('.') + 1)..]));

    private string Offer(TraitTreeNode node) =>
        $"{Categories(node)}: one of {TraitTrees.Offered(node, Store).Count} traits";

    private static TraitTreeNode? Node(TraitTreeEntry tree, int index) =>
        tree.Nodes.FirstOrDefault(node => node.UITreeIndex == index);

    private static TraitTreePoint Point(TraitTreeEntry tree, TraitTreeLayout layout, int index) =>
        Node(tree, index) is { } node && TraitTrees.Root(node)
            ? layout.Root
            : layout.Nodes.GetValueOrDefault(index, layout.Root);

    private static string Board(TraitTreeLayout layout) =>
        string.Create(
            CultureInfo.InvariantCulture,
            $"aspect-ratio:{Span(layout):0.###} / {Extent(layout):0.###};" +
            $"--cx-tree-node:{layout.NodeWidth / Span(layout) * 100:0.###}%;" +
            $"max-width:{Span(layout) * Scale:0}px");

    private static string ViewBox(TraitTreeLayout layout) =>
        string.Create(
            CultureInfo.InvariantCulture,
            $"{Left(layout):0.###} {Top(layout):0.###} {Span(layout):0.###} {Extent(layout):0.###}");

    private static string Coordinate(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private static string Placed(TraitTreeLayout layout, TraitTreePoint point) =>
        string.Create(
            CultureInfo.InvariantCulture,
            $"left:{(point.X - Left(layout)) / Span(layout) * 100:0.###}%;" +
            $"top:{(point.Y - Top(layout)) / Extent(layout) * 100:0.###}%");

    private static string Spread(TraitTreeLayout layout) =>
        string.Create(CultureInfo.InvariantCulture, $"width:{Widest(layout) / Span(layout) * 100:0.###}%");

    private static double Left(TraitTreeLayout layout) =>
        layout.Nodes.Values.Select(point => point.X - layout.NodeWidth / 2).Append(layout.Root.X - Widest(layout) / 2).Min();

    private static double Span(TraitTreeLayout layout) =>
        layout.Nodes.Values.Select(point => point.X + layout.NodeWidth / 2).Append(layout.Root.X + Widest(layout) / 2).Max() - Left(layout);

    private static string Sized(TraitTreeLayout layout, TraitTreeRootLayer layer) =>
        string.Create(CultureInfo.InvariantCulture, $"width:{layer.Width / Widest(layout) * 100:0.###}%");

    private static double Top(TraitTreeLayout layout) =>
        layout.Nodes.Values.Select(point => point.Y - layout.NodeHeight / 2).Append(layout.Root.Y - Widest(layout) / 2).Min();

    private static double Extent(TraitTreeLayout layout) =>
        layout.Nodes.Values.Select(point => point.Y + layout.NodeHeight / 2).Append(layout.Root.Y + Widest(layout) / 2).Max() - Top(layout);

    private static double Widest(TraitTreeLayout layout) =>
        layout.RootLayers.Count == 0 ? layout.Width : layout.RootLayers.Max(layer => layer.Width);

    private IReadOnlyDictionary<int, TraitDocument> With(TraitTreeEntry tree, int node, TraitDocument trait)
    {
        var asked = new Dictionary<int, TraitDocument>(Picks) { [node] = trait };

        return TraitTrees.Allocated(tree, asked);
    }

    private IReadOnlyDictionary<int, TraitDocument> Without(TraitTreeEntry tree, int node)
    {
        var asked = new Dictionary<int, TraitDocument>(Picks);
        asked.Remove(node);

        return TraitTrees.Allocated(tree, asked);
    }

    private string Address(int item, IReadOnlyDictionary<int, TraitDocument>? picks = null, int? at = null)
    {
        var values = new Dictionary<string, StringValues>(StringComparer.OrdinalIgnoreCase)
        {
            ["item"] = item.ToString(CultureInfo.InvariantCulture),
        };

        if (picks is { Count: > 0 }) values["picks"] = TraitTrees.Write(picks);
        if (at is { } node) values["at"] = node.ToString(CultureInfo.InvariantCulture);

        return QueryHelpers.AddQueryString(Page, values);
    }
}
