@page "/search"
@page "/{Slug}"
@inject ICodexService Catalog
@inject ICodexSearchService Search
@inject NavigationManager Nav

@if (Missing)
{
    return;
}

<PageTitle>@Heading - Fellowship Codex</PageTitle>

<Crumbs Trail="@(new List<(string, string?)> { (Heading, null) })" />

<h1>@Heading</h1>

@if (Error is { } error)
{
    <Panel>
        <Empty Message="That filter could not be read.">@error</Empty>
    </Panel>
}
else
{
    <Tabs Aria="Types">
        <a class="cx-tab" href="@View.OfType(null)" aria-current="@(Results.Chosen is null ? "page" : null)">
            All
            @if (Query.Text is not null)
            {
                <CountBadge Text="@Results.Types.Values.Sum().ToString("N0")" />
            }
        </a>
        @foreach (var type in Tabs)
        {
            <a class="cx-tab" href="@View.OfType(type.Type)"
               aria-current="@(Results.Chosen == type.Type ? "page" : null)">
                @type.Label
                @if (Query.Text is not null)
                {
                    <CountBadge Text="@Results.Types.GetValueOrDefault(type.Type).ToString("N0")" />
                }
            </a>
        }
    </Tabs>

    <Browsing Query="Query" Results="Results" View="View"
              Nothing="@(Query.IsEmpty
                  ? "Pick a category from the menus above, or type a name into the search box."
                  : "Remove a filter and try again.")" />
}

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }

    [Parameter] public string? Slug { get; set; }

    private CodexQuery Query = new();

    private CodexResults Results =
        new(0, 1, 1, [], [], new Dictionary<EntityType, int>(), null, [], []);

    private BrowseView View = default!;

    private Category? Here;

    private bool Missing;

    private string? Error;

    private string Where => Here is { } category ? "/" + category.Slug : "/search";

    private string Heading =>
        Query.Text is { } text
            ? $"Search results for “{text}”"
            : Results.Chosen is { } chosen
                ? FellowshipCodex.Label(chosen)
                : Here?.Label ?? "Search the codex";

    private IReadOnlyList<TypeView> Tabs
    {
        get
        {
            var types = Here is { } category
                ? Catalog.Tabs(category)
                : [.. Catalog.Types.OrderBy(type => type.Position)];

            return [.. types.Where(type => Results.Types.ContainsKey(type.Type) || Results.Chosen == type.Type)];
        }
    }

    protected override void OnParametersSet()
    {
        Here = Slug is null ? null : Categories.Find(Slug);
        Missing = Slug is not null && Here is null;

        if (Missing)
        {
            Nav.NotFound();
            return;
        }

        var request = Http?.Request.Query ?? Microsoft.AspNetCore.Http.QueryCollection.Empty;

        Query = CodexQuery.Parse(request, Catalog, RequestProperties.Of(typeof(EntitiesRequest)), Here, out Error);

        if (Error is null && request.Any(p => p.Value.All(string.IsNullOrEmpty)))
        {
            Nav.NavigateTo(Where + Query.ToQueryString(), replace: true);
            return;
        }

        if (Error is null) Results = Search.Run(Query);

        View = new BrowseView(Catalog, Query, Results, Where);
    }
}
