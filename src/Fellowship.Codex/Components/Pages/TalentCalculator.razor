@page "/tools/talents"
@page "/tools/talents/{Hero}"
@page "/tools/talents/{Hero}/{Picks}"
@rendermode InteractiveServer
@inject ICodexViewService Ui
@inject IEntityStoreService Store
@using Microsoft.JSInterop
@inject IJSRuntime Js

<PageTitle>Talent calculator - Fellowship Codex</PageTitle>

<Crumbs Trail="@Trail" />

<h1>Talent calculator</h1>

<Panel Head="Hero" Badge="@Roster">
    <div class="cx-roster">
        @foreach (var who in Heroes)
        {
            <a href="@Address(who.Name, who.Name == Wearer?.Name ? TalentPlan.Write(Tree, Taken) : null)"
               aria-current="@(who.Name == Wearer?.Name ? "page" : null)"
               style="color:@(Ui.HeroColour(who.Name) ?? "var(--muted)")">
                <span class="cx-pip" style="background:@(Ui.HeroSwatch(who.Name) ?? "var(--muted)")"></span>
                <span class="cx-who">@who.Name</span>
            </a>
        }
    </div>
</Panel>

@if (Wearer is not { } hero)
{
    <Panel>
        <Empty Message="No hero picked.">Choose one above to lay their talent tree out.</Empty>
    </Panel>
}
else
{
    <Panel Head="@($"{hero.Name}’s talents")">
        <div class="cx-tal-bar">
            <p class="cx-tal-spend">
                <b style="color:@Tone">@Spent</b> of @TalentPlan.Points points spent, @Left left
            </p>

            @if (Taken.Count == 0)
            {
                <span class="cx-tal-act" aria-disabled="true">Reset</span>
            }
            else
            {
                <button type="button" class="cx-tal-act" @onclick="() => Go(new HashSet<int>())">Reset</button>
            }

            <button type="button" class="cx-tal-act" data-copy>Copy link</button>
        </div>

        <div class="cx-talents" style="@Frame" data-hover-tip>
            @foreach (var row in Tree)
            {
                <div class="cx-tal-band">
                    <span class="cx-tal-rank" style="--cx-tal-plate:url(@Ui.Chrome.TalentTier(row.Number))">
                        <span class="cx-tal-row">@row.Numeral</span>
                    </span>

                    <div class="cx-tal-cells" style="@Columns(row)">
                        @foreach (var node in row.Nodes)
                        {
                            var mine = node;
                            var picked = Taken.Contains(mine.Id);

                            <button type="button" class="cx-tal"
                                    aria-current="@(picked ? "true" : null)"
                                    aria-disabled="@(!picked && mine.Cost > Left ? "true" : null)"
                                    title="@(!picked && mine.Cost > Left ? Beyond(mine) : null)"
                                    @onclick="() => Press(mine)"
                                    @oncontextmenu="() => Remove(mine)" @oncontextmenu:preventDefault="@picked">@Face(mine, picked ? Picked : Unpicked)</button>
                        }
                    </div>
                </div>
            }
        </div>

        <Note>Hover a talent for its full tooltip. Left click a talent to pick it, and right click a picked talent to remove it. On a touch screen, tap a talent to pick it, and the bar at the foot of the screen has its tooltip and a button to remove it. A picked talent spends its cost from the fourteen.</Note>
    </Panel>

    @if (Focused is { } focused)
    {
        <PlanBar Name="@Ui.Name(focused.Talent)" Tip="@Ui.Tip(focused.Talent)" Icon="@Ui.Icon(focused.Talent.Icon)"
                 OnShut="() => Focused = null">
            @if (Taken.Contains(focused.Id))
            {
                <button type="button" class="cx-tal-act" @onclick="() => Remove(focused)">Remove talent</button>
            }
            else if (focused.Cost <= Left)
            {
                <button type="button" class="cx-tal-act" @onclick="() => Press(focused)">Pick talent</button>
            }
            else
            {
                <span class="cx-tal-act" aria-disabled="true">@Left of @focused.Cost points left</span>
            }
        </PlanBar>
    }
}

@code {
    [Parameter] public string? Hero { get; set; }

    [Parameter] public string? Picks { get; set; }

    private const string Page = "/tools/talents";

    private const string Picked = "selected";

    private const string Unpicked = "disabled";

    private HeroEntry? Wearer;

    private IReadOnlyList<TalentRow> Tree = [];

    private IReadOnlySet<int> Taken = new HashSet<int>();

    private (string? Hero, string? Picks)? Applied;

    private TalentNode? Focused;

    private IReadOnlyList<HeroEntry> Heroes =>
        [.. Store.Settings.Heroes.OrderBy(who => who.Name, StringComparer.OrdinalIgnoreCase)];

    private string Roster => $"{Store.Settings.Heroes.Count} heroes";

    private int Spent => TalentPlan.Spent(Tree, Taken);

    private int Left => TalentPlan.Points - Spent;

    private string Tone => Wearer is null ? "var(--gold-bright)" : Ui.HeroColour(Wearer.Name) ?? "var(--gold-bright)";

    private string Frame =>
        $"--cx-hero:{Tone};" +
        $"--cx-tal-band:url({Ui.Chrome.TalentBand});" +
        $"--cx-tal-cost:url({Ui.Chrome.TalentCost});" +
        $"--cx-tal-frame:url({Ui.Chrome.TalentFrame})";

    private static string Columns(TalentRow row) =>
        $"grid-template-columns:repeat({row.Nodes.Count}, minmax(0, 1fr))";

    private static readonly IReadOnlyList<(string Label, string? Href)> Trail =
        [("Tools", null), ("Talent calculator", null)];

    protected override void OnParametersSet()
    {
        if (Applied is { } applied && applied == (Hero, Picks)) return;

        Applied = (Hero, Picks);
        Wearer = Store.Hero(Hero);

        Tree = Wearer is null || !Enum.TryParse<Hero>(Wearer.Name, out var hero)
            ? []
            : TalentPlan.Tree(Store, hero);

        Taken = TalentPlan.Read(Picks, Tree);
        Focused = null;
    }

    private Task Press(TalentNode node)
    {
        Focused = node;

        return !Taken.Contains(node.Id) && node.Cost <= Left ? Go(Toggled(node)) : Task.CompletedTask;
    }

    private Task Remove(TalentNode node) => Taken.Contains(node.Id) ? Go(Toggled(node)) : Task.CompletedTask;

    private async Task Go(IReadOnlySet<int> taken)
    {
        Taken = taken;

        await Js.InvokeVoidAsync("history.replaceState", null, string.Empty, Address(Wearer?.Name, TalentPlan.Write(Tree, taken)));
    }

    private RenderFragment Face(TalentNode node, string state)
    {
        var link = Ui.Tip(node.Talent);

        return @<span class="cx-tal-face" data-tip="@link.Address" data-tip-request="@link.Body">
            <span class="cx-tal-texture" style="--cx-tal-slot:url(@Ui.Chrome.TalentSlot(state))">
                <img class="cx-tal-icon" alt="" src="@Ui.Icon(node.Talent.Icon)" />
                <span class="cx-tal-cost">@node.Cost</span>
            </span>
            <span class="cx-tal-name">@Ui.Name(node.Talent)</span>
        </span>;
    }

    private IReadOnlySet<int> Toggled(TalentNode node)
    {
        var taken = new HashSet<int>(Taken);

        if (!taken.Remove(node.Id)) taken.Add(node.Id);

        return taken;
    }

    private string Beyond(TalentNode node) =>
        $"{Ui.Name(node.Talent)} costs {node.Cost}, and only {Left} of the " +
        $"{TalentPlan.Points} points are left.";

    private static string Address(string? hero, string? picks = null) =>
        hero is not { Length: > 0 } ? Page
        : picks is { Length: > 0 } ? $"{Page}/{Uri.EscapeDataString(hero)}/{picks}"
        : $"{Page}/{Uri.EscapeDataString(hero)}";
}
