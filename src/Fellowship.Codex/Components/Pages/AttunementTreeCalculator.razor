@page "/tools/attunement-trees"
@using Fellowship.SDK.Models
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Primitives
@inject ICodexViewService Ui
@inject IEntityStoreService Store

<PageTitle>Attunement trees - Fellowship Codex</PageTitle>

<Crumbs Trail="@Trail" />

<h1>Attunement trees</h1>

<Panel Head="Slot" Badge="@Roster">
    <div class="cx-roster cx-tree-roster">
        @foreach (var (slot, _) in Slots)
        {
            <a href="@Address(slot)" aria-current="@(slot.Equals(Chosen, StringComparison.OrdinalIgnoreCase) ? "page" : null)">
                <img class="cx-tree-roster-icon" alt="" src="@Ui.Chrome.SlotGlyph(slot)" />
                <span class="cx-who">@slot</span>
            </a>
        }
    </div>
</Panel>

@if (Chosen is not { } item || Tree is not { Layout: { } layout } tree)
{
    <Panel>
        <Empty Message="No slot picked.">Choose one above to lay its attunement tree out.</Empty>
    </Panel>
}
else
{
    <Panel Head="@($"{item} attunement tree")">
        <div class="cx-tal-bar">
            <p class="cx-tal-spend">
                <b>@Picks.Count</b> of @Capacity augmentations infused
            </p>

            @if (Picks.Count == 0)
            {
                <span class="cx-tal-act" aria-disabled="true">Reset</span>
            }
            else
            {
                <a class="cx-tal-act" href="@Address(item)">Reset</a>
            }

            <button type="button" class="cx-tal-act" data-copy>Copy link</button>
        </div>

        <div class="cx-tree" style="@Board(layout)">
            <svg class="cx-tree-edges" viewBox="@ViewBox(layout)" preserveAspectRatio="none" aria-hidden="true">
                @foreach (var node in tree.Nodes)
                {
                    foreach (var parent in node.ParentNodes)
                    {
                        var from = Point(tree, layout, parent);
                        var to = Point(tree, layout, node.UITreeIndex);

                        <line class="@(Picks.ContainsKey(node.UITreeIndex) && AttunementTrees.Lit(Node(tree, parent)!, Picks) ? "on" : null)"
                              x1="@Coordinate(from.X)" y1="@Coordinate(from.Y)" x2="@Coordinate(to.X)" y2="@Coordinate(to.Y)" />
                    }
                }
            </svg>

            <span class="cx-tree-root" style="@($"{Placed(layout, layout.Root)};{Spread(layout)}")">
                @foreach (var layer in layout.RootLayers)
                {
                    if (layer.Texture is { } texture)
                    {
                        <img class="cx-tree-layer" alt="" src="@Ui.Chrome.Texture(texture)" style="@Sized(layout, layer)" />
                    }
                }
            </span>

            @foreach (var node in tree.Nodes.Where(node => !AttunementTrees.Root(node)))
            {
                var mine = node;

                if (!layout.Nodes.TryGetValue(mine.UITreeIndex, out var spot)) continue;

                if (Picks.TryGetValue(mine.UITreeIndex, out var augmentation))
                {
                    var tip = Ui.Tip(augmentation);

                    <a class="cx-tree-node" href="@Address(item, Picks, mine.UITreeIndex)" style="@Placed(layout, spot)"
                       aria-current="@(At == mine.UITreeIndex ? "true" : null)"
                       data-tip="@tip.Address" data-tip-request="@tip.Body">@Face(mine, augmentation, Selected)</a>
                }
                else if (AttunementTrees.Allocatable(tree, Picks, mine))
                {
                    <a class="cx-tree-node" href="@Address(item, Picks, mine.UITreeIndex)" style="@Placed(layout, spot)"
                       aria-current="@(At == mine.UITreeIndex ? "true" : null)"
                       title="@Offer(mine)">@Face(mine, null, Available)</a>
                }
                else
                {
                    <span class="cx-tree-node" aria-disabled="true" tabindex="0" style="@Placed(layout, spot)"
                          title="@Offer(mine)">@Face(mine, null, Unavailable)</span>
                }
            }
        </div>

        <Note>Choose a lit node to infuse a augmentation into it. Each row takes one augmentation, and a node opens once a node it follows is infused.</Note>
    </Panel>

    @if (Choosing is { } choosing)
    {
        <Panel Head="@($"Node {choosing.UITreeIndex}: {Categories(choosing)}")" Badge="@Offered.Count.ToString()">
            <div class="cx-tree-choices">
                @if (Picks.ContainsKey(choosing.UITreeIndex))
                {
                    <a class="cx-tal-act" href="@Address(item, Without(tree, choosing.UITreeIndex))">Remove</a>
                }

                @foreach (var offered in Offered)
                {
                    var choice = offered;
                    var tip = Ui.Tip(choice);

                    if (Picks.TryGetValue(choosing.UITreeIndex, out var current) && current.Id == choice.Id)
                    {
                        <span class="cx-tree-choice" aria-current="true"
                              data-tip="@tip.Address" data-tip-request="@tip.Body">@Choice(choosing, choice)</span>
                    }
                    else if (Picks.Values.Any(taken => taken.Id == choice.Id))
                    {
                        <span class="cx-tree-choice" aria-disabled="true" tabindex="0"
                              data-tip="@tip.Address" data-tip-request="@tip.Body">@Choice(choosing, choice)</span>
                    }
                    else
                    {
                        <a class="cx-tree-choice" href="@Address(item, With(tree, choosing.UITreeIndex, choice))"
                           data-tip="@tip.Address" data-tip-request="@tip.Body">@Choice(choosing, choice)</a>
                    }
                }
            </div>
        </Panel>
    }

    @if (Store.Settings.AttunementNodeUpgradeCosts.Count > 0)
    {
        <Panel Head="Upgrade costs">
            <KeyValues>
                @foreach (var cost in Store.Settings.AttunementNodeUpgradeCosts)
                {
                    <KeyValue Key="@($"Rank {cost.Rank}")">
                        @cost.Cost.ToString("N0", CultureInfo.InvariantCulture) <Ref Entity="new EntityReference(EntityType.Currency, cost.Currency, null)" />
                    </KeyValue>
                }
            </KeyValues>
        </Panel>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "slot")] public string? Slot { get; set; }

    [SupplyParameterFromQuery(Name = "picks")] public string? Picked { get; set; }

    [SupplyParameterFromQuery(Name = "at")] public int? At { get; set; }

    private const string Page = "/tools/attunement-trees";

    private const double Scale = 1.25;

    private const string Selected = "selected";

    private const string Available = "available";

    private const string Unavailable = "unavailable";

    private static readonly IReadOnlyList<(string Label, string? Href)> Trail =
        [("Tools", null), ("Attunement trees", null)];

    private IReadOnlyList<(string Slot, AttunementTreeEntry Tree)> Slots = [];

    private string? Chosen;

    private AttunementTreeEntry? Tree;

    private IReadOnlyDictionary<int, AugmentationDocument> Picks = new Dictionary<int, AugmentationDocument>();

    private AttunementTreeNode? Choosing;

    private IReadOnlyList<AugmentationDocument> Offered = [];

    private string Roster => $"{Slots.Count} trees";

    private int Capacity => AttunementTrees.Capacity(Tree?.Tag, Store.Settings) ?? 0;

    protected override void OnParametersSet()
    {
        Slots = AttunementTrees.BySlot(Store);

        var chosen = Slots.FirstOrDefault(entry => entry.Slot.Equals(Slot, StringComparison.OrdinalIgnoreCase));

        Chosen = chosen.Slot;
        Tree = chosen.Tree;
        Picks = Tree is null ? new Dictionary<int, AugmentationDocument>() : AttunementTrees.Read(Picked, Tree, Store);

        Choosing = Tree?.Nodes.FirstOrDefault(node =>
            node.UITreeIndex == At && (Picks.ContainsKey(node.UITreeIndex) || AttunementTrees.Allocatable(Tree, Picks, node)));

        Offered = Choosing is null ? [] : AttunementTrees.Offered(Choosing, Store);
    }

    private RenderFragment Face(AttunementTreeNode node, AugmentationDocument? augmentation, string state) =>
        @<span class="cx-tree-face">
            <img class="cx-tree-frame" alt="" src="@Ui.Chrome.AttunementNode(state)" />
            @if (augmentation is not null && Ui.Icon(augmentation.Icon) is { } icon)
            {
                <span class="cx-tree-well"><img alt="" src="@icon" /></span>
            }
            <img class="cx-tree-tint" alt=""
                 src="@Ui.Chrome.AttunementNodeColor(state == Unavailable ? [] : node.AugmentationCategories)" />
        </span>;

    private RenderFragment Choice(AttunementTreeNode node, AugmentationDocument augmentation) =>
        @<span class="cx-tree-option">
            <span class="cx-tree-face">
                <img class="cx-tree-frame" alt="" src="@Ui.Chrome.AttunementNode(Selected)" />
                @if (Ui.Icon(augmentation.Icon) is { } icon)
                {
                    <span class="cx-tree-well"><img alt="" src="@icon" /></span>
                }
                <img class="cx-tree-tint" alt="" src="@Ui.Chrome.AttunementNodeColor(node.AugmentationCategories)" />
            </span>
            <span class="cx-tree-option-name">@Ui.Name(augmentation)</span>
        </span>;

    private string Categories(AttunementTreeNode node) =>
        string.Join(" or ", node.AugmentationCategories.Select(category =>
            AttunementTrees.CategoryName(category, Store) ?? category[(category.LastIndexOf('.') + 1)..]));

    private string Offer(AttunementTreeNode node) =>
        $"{Categories(node)}: one of {AttunementTrees.Offered(node, Store).Count} augmentations";

    private static AttunementTreeNode? Node(AttunementTreeEntry tree, int index) =>
        tree.Nodes.FirstOrDefault(node => node.UITreeIndex == index);

    private static AttunementTreePoint Point(AttunementTreeEntry tree, AttunementTreeLayout layout, int index) =>
        Node(tree, index) is { } node && AttunementTrees.Root(node)
            ? layout.Root
            : layout.Nodes.GetValueOrDefault(index, layout.Root);

    private static string Board(AttunementTreeLayout layout) =>
        string.Create(
            CultureInfo.InvariantCulture,
            $"aspect-ratio:{Span(layout):0.###} / {Extent(layout):0.###};" +
            $"--cx-tree-node:{layout.NodeWidth / Span(layout) * 100:0.###}%;" +
            $"max-width:{Span(layout) * Scale:0}px");

    private static string ViewBox(AttunementTreeLayout layout) =>
        string.Create(
            CultureInfo.InvariantCulture,
            $"{Left(layout):0.###} {Top(layout):0.###} {Span(layout):0.###} {Extent(layout):0.###}");

    private static string Coordinate(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private static string Placed(AttunementTreeLayout layout, AttunementTreePoint point) =>
        string.Create(
            CultureInfo.InvariantCulture,
            $"left:{(point.X - Left(layout)) / Span(layout) * 100:0.###}%;" +
            $"top:{(point.Y - Top(layout)) / Extent(layout) * 100:0.###}%");

    private static string Spread(AttunementTreeLayout layout) =>
        string.Create(CultureInfo.InvariantCulture, $"width:{Widest(layout) / Span(layout) * 100:0.###}%");

    private static double Left(AttunementTreeLayout layout) =>
        layout.Nodes.Values.Select(point => point.X - layout.NodeWidth / 2).Append(layout.Root.X - Widest(layout) / 2).Min();

    private static double Span(AttunementTreeLayout layout) =>
        layout.Nodes.Values.Select(point => point.X + layout.NodeWidth / 2).Append(layout.Root.X + Widest(layout) / 2).Max() - Left(layout);

    private static string Sized(AttunementTreeLayout layout, AttunementTreeRootLayer layer) =>
        string.Create(CultureInfo.InvariantCulture, $"width:{layer.Width / Widest(layout) * 100:0.###}%");

    private static double Top(AttunementTreeLayout layout) =>
        layout.Nodes.Values.Select(point => point.Y - layout.NodeHeight / 2).Append(layout.Root.Y - Widest(layout) / 2).Min();

    private static double Extent(AttunementTreeLayout layout) =>
        layout.Nodes.Values.Select(point => point.Y + layout.NodeHeight / 2).Append(layout.Root.Y + Widest(layout) / 2).Max() - Top(layout);

    private static double Widest(AttunementTreeLayout layout) =>
        layout.RootLayers.Count == 0 ? layout.Width : layout.RootLayers.Max(layer => layer.Width);

    private IReadOnlyDictionary<int, AugmentationDocument> With(AttunementTreeEntry tree, int node, AugmentationDocument augmentation)
    {
        var asked = new Dictionary<int, AugmentationDocument>(Picks) { [node] = augmentation };

        return AttunementTrees.Allocated(tree, asked);
    }

    private IReadOnlyDictionary<int, AugmentationDocument> Without(AttunementTreeEntry tree, int node)
    {
        var asked = new Dictionary<int, AugmentationDocument>(Picks);
        asked.Remove(node);

        return AttunementTrees.Allocated(tree, asked);
    }

    private string Address(string slot, IReadOnlyDictionary<int, AugmentationDocument>? picks = null, int? at = null)
    {
        var values = new Dictionary<string, StringValues>(StringComparer.OrdinalIgnoreCase)
        {
            ["slot"] = slot,
        };

        if (picks is { Count: > 0 }) values["picks"] = AttunementTrees.Write(picks);
        if (at is { } node) values["at"] = node.ToString(CultureInfo.InvariantCulture);

        return QueryHelpers.AddQueryString(Page, values);
    }
}
