@page "/hero/{id:int}"
@page "/hero/{id:int}/{named}"
@inject ICodexViewService Ui
@inject IEntityStoreService Store
@inject ITextureSource Textures
@inject NavigationManager Nav

@if (Entity is not null)
{
    <PageTitle>@Name - Fellowship Codex</PageTitle>
    <Crumbs Trail="@(new List<(string, string?)> { (Heroes.Label, Heroes.Href), (Name, null) })" />

    <div class="cx-hero-head">
        @if (Entity.Portrait is { } portrait)
        {
            <img class="cx-hero-portrait" alt="@Name" src="@Textures.Address(portrait, TextureSize.Large)" />
        }

        <div class="cx-hero-about">
            <div class="cx-hero-title">
                <h1 class="cx-hero-name" style="color:@Ui.NameColour(Entity)">@Name</h1>
                @if (Entity.Title is { } title)
                {
                    <p class="cx-hero-epithet">@title</p>
                }
            </div>

            <dl class="cx-hero-facts">
                @foreach (var (label, value, unit, _, _) in Facts)
                {
                    <div>
                        <dt>@label</dt>
                        <dd>
                            @if (label == RoleLabel && Entity.RoleIcon is { } role)
                            {
                                <img alt="" src="@Textures.Address(role, TextureSize.Small)" />
                            }
                            @if (label == DifficultyLabel && Stars is var (level, scale))
                            {
                                <span class="cx-hero-stars" role="img" aria-label="@level of @scale">
                                    @for (var star = 1; star <= scale; star++)
                                    {
                                        <span aria-hidden="true" data-on="@(star <= level ? "true" : null)">&#9733;</span>
                                    }
                                </span>
                            }
                            else
                            {
                                @value
                            }
                            @if (unit is not null)
                            {
                                <span class="cx-unit">@unit</span>
                            }
                        </dd>
                    </div>
                }
            </dl>

            <div class="cx-actions">
                <a class="cx-act cx-act-main" href="@Calculator">Talent Calculator</a>
                <a class="cx-act" href="@ItemsFor">Items for @Name</a>
            </div>
        </div>

        <nav class="cx-hero-roster" aria-label="@Heroes.Label">
            @foreach (var hero in Roster)
            {
                <a href="@Ui.Href(hero)" aria-label="@Ui.Name(hero)" title="@Ui.Name(hero)"
                   aria-current="@(hero.Id == Entity.Id ? "page" : null)">
                    @if (hero.Portrait is { } face)
                    {
                        <img alt="" src="@Textures.Address(face, TextureSize.Small)" />
                    }
                </a>
            }
        </nav>
    </div>

    <CascadingValue Value="Here">
        <Detail Entity="Entity" />
    </CascadingValue>
}

@code {
    [Parameter] public int Id { get; set; }

    [Parameter] public string? Named { get; set; }

    private const string RoleLabel = nameof(HeroDocument.Role);

    private static readonly string DifficultyLabel = FellowshipCodex.Spaced(nameof(HeroDocument.OverallDifficulty));

    private (int Level, int Scale)? Stars =>
        Entity is { OverallDifficulty: { } level, OverallDifficultyStars: { } scale } ? (level, scale) : null;

    private HeroDocument? Entity;

    private Bearings Here = new();

    private IReadOnlyList<HeroDocument> Roster = [];

    private IReadOnlyList<(string Label, string Value, string? Unit, string? Href, TooltipLink? Tip)> Facts = [];

    private string Name => Ui.Name(Entity!);

    private string Calculator => $"{ToolPages.Talents}/{Uri.EscapeDataString(Name.ToLowerInvariant())}";

    private string ItemsFor =>
        $"{PublicTypes.Where(EntityType.Item)}&{QueryKeys.Key(FacetType.Hero)}={Uri.EscapeDataString(Name)}";

    protected override void OnParametersSet()
    {
        Entity = Store.All(EntityType.Hero, Id).OfType<HeroDocument>().FirstOrDefault();

        if (Entity is null)
        {
            Here = new Bearings();
            Nav.NotFound();
            return;
        }

        if (Named != PublicTypes.Segment(Entity))
        {
            Nav.NavigateTo(Ui.Path(Entity) + new Uri(Nav.Uri).Query, replace: true);
            Entity = null;
            return;
        }

        Roster =
        [
            .. Store.Entities.OfType<HeroDocument>()
                .OrderBy(hero => Ui.Name(hero), StringComparer.OrdinalIgnoreCase),
        ];

        var armor = Store.Hero(Name)?.ArmorType is { } worn
            ? new[] { (FellowshipCodex.Spaced(nameof(HeroEntry.ArmorType)), worn, (string?)null, (string?)null, (TooltipLink?)null) }
            : [];

        var facts = Ui.Facts(Entity);

        Facts = [.. facts.Where(fact => fact.Label == RoleLabel), .. armor, .. facts.Where(fact => fact.Label != RoleLabel)];

        Here = new Bearings
        {
            Entity = Entity,
            Readings = [Entity],
            Tip = Ui.Tip(Entity),
            Page = Ui.Path(Entity),
            Under = Heroes.Href,
            Label = Heroes.Label,
            Noun = PublicTypes.Noun(EntityType.Hero),
            Id = Id,
        };
    }
}
