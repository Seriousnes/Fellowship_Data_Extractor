@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Fellowship.Codex.Usage.UsageExtensions.OwnerPolicy)]
@using System.Security.Claims
@using Fellowship.Codex.Usage
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Components.Forms
@inject AntiforgeryStateProvider Antiforgery

<PageTitle>Usage - Fellowship Codex</PageTitle>

<Crumbs Trail="@Trail" />

<h1>Usage</h1>

<UsageDashboard Days="UsageRanges.Pick(Requested)" Owner="@Owner" TokenName="@Token?.FormFieldName" Token="@Token?.Value" Expires="Expires" />

<script src="js/vendor/chart.umd.min.js"></script>
<script type="module" src="js/usage.js"></script>

@code {
    private static readonly IReadOnlyList<(string Label, string? Href)> Trail = [("Usage", null)];

    [CascadingParameter] public HttpContext Http { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "days")] public int? Requested { get; set; }

    private string? Owner;

    private AntiforgeryRequestToken? Token;

    private DateTimeOffset? Expires;

    protected override async Task OnInitializedAsync()
    {
        Owner = Http.User.FindFirstValue(ClaimTypes.Name) ?? Http.User.FindFirstValue(ClaimTypes.NameIdentifier);
        Token = Antiforgery.GetAntiforgeryToken();
        Expires = (await Http.AuthenticateAsync()).Properties?.ExpiresUtc;
    }
}
