    <Copy>
        We do not share any information or data with any third parties.
    </Copy>
    <Note>Last updated 8 September 2026.</Note>
</Panel>



@code {
    private static readonly IReadOnlyList<(string Label, string? Href)> Trail = [("Privacy", null)];
}
