@using Fellowship.SDK.Models
@inject ICodexViewService Ui
@inject IExportHistoryService History
@inject NavigationManager Nav

<nav class="cx-hero-tabs" aria-label="On this page">
    <a href="@Nav.Fragment("overview")">Overview</a>
    @foreach (var (anchor, label, count) in Contents)
    {
        <a href="@Nav.Fragment(anchor)">@label <span class="cx-count">@count</span></a>
    }
</nav>

<CascadingValue Value="(EntityDocument)Entity">
    <section id="overview" class="cx-hero-overview">
        @if (Lore.Count > 0)
        {
            <div class="cx-hero-lore">
                @foreach (var (head, paragraphs, references) in Lore)
                {
                    <div class="cx-hero-lore-part">
                        <h2>@head</h2>
                        @foreach (var paragraph in paragraphs)
                        {
                            <p><ReferencedText Text="@paragraph" References="references" /></p>
                        }
                    </div>
                }
            </div>
        }

        @if (Stats.Count > 0)
        {
            <div>
                <h2>Starting Stats</h2>
                <dl class="cx-hero-stats">
                    @foreach (var (label, value) in Stats)
                    {
                        <div>
                            <dt>@label</dt>
                            <dd>@value</dd>
                        </div>
                    }
                </dl>
            </div>
        }
    </section>

    @if (Abilities.Count > 0 || Folded.Count > 0)
    {
        <details id="abilities" class="cx-hero-sec" open>
            <summary class="cx-hero-sec-head">
                <h2>Abilities</h2>
                <span class="cx-count">@Abilities.Count</span>
            </summary>

            <div class="cx-hero-sec-body">
                @if (Abilities.Count > 0)
                {
                    <div class="cx-hero-board">@AbilityTable(Abilities)</div>
                }

                @foreach (var group in Folded)
                {
                    <details class="cx-hero-fold">
                        <summary><span>@group.Key</span> <span class="cx-count">@group.Count()</span></summary>
                        @AbilityTable([.. group])
                    </details>
                }
            </div>
        </details>
    }

    @if (Tiers.Count > 0)
    {
        <details id="talents" class="cx-hero-sec" open>
            <summary class="cx-hero-sec-head">
                <h2>Talents</h2>
                <span class="cx-count">@Talents.Count</span>
                <a class="cx-act" href="@Calculator">Talent Calculator</a>
            </summary>

            <div class="cx-hero-sec-body">
                <div class="cx-hero-board">
                    <Table Items="Talents" Group="row => Tier(row.Tier)">
                        <Columns>
                            <Column Head="Name" Class="cx-hero-ability">
                                <Content Context="row">
                                    <span class="cx-hero-ability-name">
                                        <Texture Entity="row.Node.Talent" Width="40" />
                                        <EntityLink Entity="row.Node.Talent" Class="cx-nm" />
                                    </span>
                                </Content>
                            </Column>
                            <Column Head="Cost">
                                <Content Context="row">
                                    @FellowshipCodex.Number(row.Node.Cost)<span class="cx-unit">@(row.Node.Cost == 1 ? "point" : "points")</span>
                                </Content>
                            </Column>
                            <Column Head="Tooltip" Class="cx-hero-tooltip">
                                <Content Context="row">
                                    <span class="cx-prose">@Ui.Text(row.Node.Talent.Description, row.Node.Talent.Placeholders, FellowshipCodex.Schools(row.Node.Talent))</span>
                                </Content>
                            </Column>
                        </Columns>
                    </Table>
                </div>
            </div>
        </details>
    }

    @if (Legendaries.Count > 0)
    {
        <details id="legendary" class="cx-hero-sec" open>
            <summary class="cx-hero-sec-head">
                <h2>Legendary Items</h2>
                <span class="cx-count">@Legendaries.Count</span>
            </summary>
            <div class="cx-hero-tiles cx-hero-sec-body">
                @foreach (var item in Legendaries)
                {
                    <div class="cx-hero-tile">
                        <Texture Entity="item" Width="44" />
                        <div>
                            <EntityLink Entity="item" Class="cx-nm" />
                            <span class="cx-hero-tile-sub">@item.Slot</span>
                        </div>
                    </div>
                }
            </div>
        </details>
    }

    @if (Effects.Count > 0)
    {
        <details id="effects" class="cx-hero-sec">
            <summary class="cx-hero-sec-head">
                <h2>Effects</h2>
                <span class="cx-count">@Effects.Count</span>
            </summary>
            <div class="cx-hero-sec-body">
                <div class="cx-hero-board">
                    <Table Items="Effects">
                        <Columns>
                            <Column Head="" Class="cx-texture">
                                <Content Context="row"><Texture Entity="row" /></Content>
                            </Column>
                            <Column Head="Name">
                                <Content Context="row"><EntityLink Entity="row" Class="cx-nm" /></Content>
                            </Column>
                            <Column Head="Applied by">
                                <Content Context="row">
                                    <Owner Holder="row.AppliedBy" />
                                </Content>
                            </Column>
                            <Column Head="Type" Class="cx-tags">
                                <Content Context="row">
                                    @foreach (var school in row.Schools ?? [])
                                    {
                                        <Chip>@school</Chip>
                                    }
                                </Content>
                            </Column>
                        </Columns>
                    </Table>
                </div>
            </div>
        </details>
    }

    <Changes ByVersion="ByVersion" Entity="Entity" Tip="Here.Tip" />
</CascadingValue>

@code {
    [Parameter, EditorRequired] public HeroDocument Entity { get; set; } = default!;

    [CascadingParameter] private Bearings Here { get; set; } = new();

    private const string Uncategorised = "Other";

    private IReadOnlyList<(string Head, IReadOnlyList<string> Paragraphs, IReadOnlyList<EntityReference>? References)> Lore = [];

    private IReadOnlyList<(string Label, string Value)> Stats = [];

    private IReadOnlyList<AbilityDocument> Abilities = [];

    private IReadOnlyList<IGrouping<string, AbilityDocument>> Folded = [];

    private IReadOnlyList<TalentRow> Tiers = [];

    private IReadOnlyList<(TalentRow Tier, TalentNode Node)> Talents = [];

    private IReadOnlyList<ItemDocument> Legendaries = [];

    private IReadOnlyList<EffectDocument> Effects = [];

    private IReadOnlyList<VersionValue> ByVersion = [];

    private IReadOnlyList<(string Anchor, string Label, int Count)> Contents = [];

    private AbilityTooltipText Words = default!;

    private string Calculator => $"{ToolPages.Talents}/{Uri.EscapeDataString(Ui.Name(Entity).ToLowerInvariant())}";

    private RenderFragment AbilityTable(IReadOnlyList<AbilityDocument> rows) =>
        @<Table Items="rows">
            <Columns>
                <Column Head="Name" Class="cx-hero-ability">
                    <Content Context="row">
                        <span class="cx-hero-ability-name">
                            <Texture Entity="row" Width="40" />
                            <EntityLink Entity="row" Class="cx-nm" />
                        </span>
                    </Content>
                </Column>
                <Column Head="Category" Value="row => Category(row)" />
                <Column Head="Cost">
                    <Content Context="row">
                        @if (row.Cost is { } cost)
                        {
                            @FellowshipCodex.Number(cost)
                            @if (row.Resource is { } resource)
                            {
                                <span class="cx-unit">@resource</span>
                            }
                        }
                    </Content>
                </Column>
                <Column Head="Cast Time">
                    <Content Context="row">
                        @if (row.CastTime is { } cast)
                        {
                            @FellowshipCodex.Number(cast)<span class="cx-unit">s</span>
                        }
                        else
                        {
                            @Words.Instant
                        }
                    </Content>
                </Column>
                <Column Head="Cooldown">
                    <Content Context="row">
                        @if (row.Cooldown is { } cooldown)
                        {
                            @FellowshipCodex.Number(cooldown)<span class="cx-unit">s</span>
                            @if (row.Charges is > 1 and var charges)
                            {
                                <span class="cx-unit">, @FellowshipCodex.Number(charges) charges</span>
                            }
                        }
                    </Content>
                </Column>
                <Column Head="Range">
                    <Content Context="row">
                        @if (row.Range is { } range && !Distance.Self(range))
                        {
                            @if (Distance.Melee(range, Words))
                            {
                                @Words.MeleeRange
                            }
                            else
                            {
                                @Distance.Yards(range, Words).Normalize().ToString(System.Globalization.CultureInfo.InvariantCulture)<span class="cx-unit">@Words.RangeUnit</span>
                            }
                        }
                    </Content>
                </Column>
                <Column Head="Tooltip" Class="cx-hero-tooltip">
                    <Content Context="row">
                        <span class="cx-prose">@Ui.Text(Description(row), row.Placeholders, FellowshipCodex.Schools(row))</span>
                    </Content>
                </Column>
            </Columns>
        </Table>;

    protected override void OnParametersSet()
    {
        var name = Ui.Name(Entity);

        Words = TooltipView.AbilityText(Ui.Store.Settings);

        Lore =
        [
            .. new (string Head, string? Text, IReadOnlyList<EntityReference>? References)[]
                {
                    ("Playstyle", Entity.Playstyle, null),
                    ("Spirit Ability", Entity.SpiritAbility, Entity.SpiritAbilityReferences),
                    ("Biography", Entity.Biography, null),
                }
                .Where(entry => entry.Text is { Length: > 0 })
                .Select(entry => (entry.Head, Paragraphs(entry.Text!), entry.References)),
        ];

        Stats = Starting();

        var owned = Owned(name);

        var abilities = owned.OfType<AbilityDocument>()
            .Where(PublicTypes.IsListed)
            .Where(ability => ability.Category is not null || PublicTypes.DisplayNameOf(ability) is not null)
            .OrderBy(ability => (int?)ability.Category ?? int.MaxValue)
            .ThenBy(ability => Ui.Name(ability), StringComparer.OrdinalIgnoreCase)
            .ToArray();

        Abilities = [.. abilities.Where(ability => !IsFolded(ability))];

        Folded =
        [
            .. abilities.Where(IsFolded)
                .GroupBy(Category)
                .OrderBy(group => group.Key == Uncategorised ? 0 : 1)
                .ThenBy(group => (int?)group.First().Category ?? 0),
        ];

        Tiers = Enum.TryParse<Fellowship.SDK.Hero>(name, out var hero) ? TalentPlan.Tree(Ui.Store, hero) : [];

        Talents = [.. Tiers.SelectMany(tier => tier.Nodes.Select(node => (tier, node)))];

        Legendaries =
        [
            .. owned.OfType<ItemDocument>()
                .Where(item => item.Rarity == Rarity.Legendary && item.EnabledInGame is not false)
                .OrderBy(item => item.Slot, StringComparer.OrdinalIgnoreCase)
                .ThenBy(item => Ui.Name(item), StringComparer.OrdinalIgnoreCase),
        ];

        Effects =
        [
            .. owned.OfType<EffectDocument>()
                .Where(effect => PublicTypes.DisplayNameOf(effect) is not null)
                .OrderBy(effect => Ui.Name(effect), StringComparer.OrdinalIgnoreCase),
        ];

        ByVersion = ReferenceEquals(Entity, Here.Entity) ? History.Of(Entity) : [];

        Contents =
        [
            .. new (string Anchor, string Label, int Count)[]
            {
                ("abilities", "Abilities", Abilities.Count),
                ("talents", "Talents", Talents.Count),
                ("legendary", "Legendary Items", Legendaries.Count),
                ("effects", "Effects", Effects.Count),
            }.Where(entry => entry.Count > 0),
        ];
    }

    private static string Tier(TalentRow tier) =>
        tier.Nodes.Select(node => node.Cost).Distinct().ToArray() is [var cost]
            ? $"Tier {tier.Numeral} · {cost} {(cost == 1 ? "point" : "points")}"
            : $"Tier {tier.Numeral}";

    private static bool IsFolded(AbilityDocument ability) =>
        ability.Category is null or AbilityCategory.None or AbilityCategory.Weapon or AbilityCategory.Relic;

    private static string Category(AbilityDocument ability) =>
        ability.Category is { } category and not AbilityCategory.None
            ? FellowshipCodex.Spaced(category.ToString())
            : Uncategorised;

    private string? Description(AbilityDocument ability) =>
        ability.DescriptionsByHero?.GetValueOrDefault(Ui.Name(Entity)) ?? ability.Description;

    private IReadOnlyList<EntityDocument> Owned(string name)
    {
        var facet = Ui.Codex.Facet(FacetType.Hero);

        return
        [
            .. Ui.Store.Entities
                .Where(document => document is AbilityDocument or ItemDocument or EffectDocument)
                .Where(document => facet.Matches(document, [name]))
                .DistinctBy(document => (EntityTypes.TypeOf(document), document.Id)),
        ];
    }

    private IReadOnlyList<(string, string)> Starting()
    {
        if (Entity.BaseAttributes is not { } own) return [];

        var heroes = Ui.Store.Entities.OfType<HeroDocument>().ToArray();
        var named = Ui.Store.Settings.StatCalculation.Attributes;

        var labelled = own.Keys
            .Select(key => (Key: key, Label: named.GetValueOrDefault(key)?.DisplayName ?? FellowshipCodex.Spaced(key)))
            .ToArray();

        var shared = labelled
            .GroupBy(entry => entry.Label, StringComparer.OrdinalIgnoreCase)
            .Where(group => group.Count() > 1)
            .SelectMany(group => group.Select(entry => entry.Key))
            .ToHashSet(StringComparer.Ordinal);

        return
        [
            .. own
                .Where(attribute => attribute.Value != 0)
                .Where(attribute => heroes
                    .Select(other => other.BaseAttributes?.GetValueOrDefault(attribute.Key))
                    .Distinct()
                    .Skip(1)
                    .Any())
                .Select(attribute => (
                    shared.Contains(attribute.Key)
                        ? FellowshipCodex.Spaced(attribute.Key)
                        : labelled.First(entry => entry.Key == attribute.Key).Label,
                    Percent(named, attribute.Key)
                        ? $"{FellowshipCodex.Number(attribute.Value * 100)}%"
                        : FellowshipCodex.Number(attribute.Value))),
        ];
    }

    private static bool Percent(IReadOnlyDictionary<string, AttributeDisplay> named, string key) =>
        (named.Values.FirstOrDefault(display => display.Attribute == key) ?? named.GetValueOrDefault(key))
            is { IsPercent: true };

    private static IReadOnlyList<string> Paragraphs(string text) =>
        [.. text.Split('\n').Select(line => line.TrimEnd('\r')).Where(line => line.Length > 0)];
}
