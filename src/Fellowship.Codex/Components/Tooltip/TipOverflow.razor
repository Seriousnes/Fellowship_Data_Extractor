@inject ITooltipViewService Ui
@inject ICodexViewService View

@if (View.Stone(Entity) is { OverflowDescription: { } description } overflow)
{
    <div class="grp">
        <div class="sec"><span>Past Max Power</span></div>
        <p class="desc">@Ui.Text(description, overflow.OverflowPlaceholders, Query, Hero, [])</p>
    </div>
}

@code {
    [Parameter, EditorRequired] public EntityDocument Entity { get; set; } = default!;

    [Parameter] public TooltipQuery Query { get; set; } = new();

    [Parameter] public HeroEntry? Hero { get; set; }
}
