@inject ICodexViewService Ui

<figure class="fx-blessing-crest" style="--fx-plate:url(@Plate);--fx-plate-width:@WidthPx">
    @if (Art is { } art) { <img alt="" src="@art"> }
</figure>

@code {
    [Parameter, EditorRequired] public BlessingDocument Entity { get; set; } = default!;

    [Parameter] public string? State { get; set; }

    [Parameter] public int Width { get; set; } = 60;

    private string Plate => Ui.Chrome.BlessingPlate(State);

    private string? Art => Ui.Chrome.BlessingArt(Entity.Icon, State) ?? Ui.Icon(Entity.Icon);

    private string WidthPx => Width.ToString(CultureInfo.InvariantCulture) + "px";
}
