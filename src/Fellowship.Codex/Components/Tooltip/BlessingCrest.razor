@inject ICodexViewService Ui

<figure class="fx-blessing-crest" style="--fx-plate:url(@Plate);--fx-plate-hover:url(@Hovered);--fx-plate-width:@WidthPx">
    @if (Texture is { } texture) { <img alt="" src="@texture"> }
</figure>

@code {
    [Parameter, EditorRequired] public BlessingDocument Entity { get; set; } = default!;

    [Parameter] public string? State { get; set; }

    [Parameter] public int Width { get; set; } = 64;

    private string Plate => Ui.Chrome.BlessingPlate(State);

    private string Hovered => Ui.Chrome.BlessingPlate(State, hovered: true);

    private string? Texture => Ui.Chrome.BlessingRune(Entity, State);

    private string WidthPx => Width.ToString(CultureInfo.InvariantCulture) + "px";
}
