@inject ITooltipViewService Ui
@inject IEntityStoreService Store

<div class="@TooltipView.Root plain fx-trait" style="@Ui.Variables(null)">
    <style>@Sheet</style>
    <div class="card">
        <header class="head">
            <p class="eyebrow">@Wording.Heading</p>
            <h3 class="title">@PublicTypes.NameOf(Entity)</h3>
        </header>
        @if (Entity.Icon is not null)
        {
            <TraitCrest Entity="Entity" State="@Query.State" />
        }
        <div class="band">
            <span class="kind">@Wording.Band</span>
            <span class="tier">@Text.EquippedRank <span class="count">@Rank</span></span>
        </div>
        @if (TraitRanks.Description(Entity, Ranked) is { } description)
        {
            <p class="prose">@Ui.Text(description, CodexView.PlaceholdersOf(Entity), Query, Hero, FellowshipCodex.Schools(Entity))</p>
        }
        <div class="sources">
            <p class="heading">@Text.RankSources</p>
            @foreach (var source in Sources)
            {
                <p class="source">@Text.GearSlot<span class="slot">@source.Printed</span></p>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter] public EntityDocument Document { get; set; } = default!;

    private ItemTraitDocument Entity => (ItemTraitDocument)Document;

    [Parameter] public TooltipQuery Query { get; set; } = new();

    [Parameter] public HeroEntry? Hero { get; set; }

    private MarkupString Sheet;

    private TraitTooltipText Text => TraitRanks.Text(Store.Settings);

    private TraitCategoryText Wording => TraitRanks.Category(Store.Settings, Entity);

    private IReadOnlyList<ItemTypeText> Sources => TraitRanks.Sources(Store.Settings, Query);

    private int Ranked => TraitRanks.Rank(Store.Settings, Query, Entity);

    private string Rank => Ranked.ToString(CultureInfo.InvariantCulture);

    protected override void OnParametersSet() => Sheet = new MarkupString(Ui.Style());
}
