@inject ITooltipViewService Ui

@if (Ui.LegendaryStats(Entity) is { Count: > 0 } rolls)
{
    <div class="grp">
        <div class="sec legendary"><img class="gi" alt="" src="@Ui.Chrome.LegendaryBadge.Url"><span>Legendary Stats</span><span class="n">(@rolls.Count)</span></div>
        @foreach (var roll in rolls)
        {
            @if (PublicTypes.DisplayNameOf(roll) is { } name)
            {
                <p class="nm">@name</p>
            }
            @if (DocumentFields.Text(roll, nameof(LegendaryStatDocument.Description)) is { } text)
            {
                <p class="desc">@Ui.Text(text, CodexView.PlaceholdersOf(roll), Query, Hero, [])</p>
            }
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public EntityDocument Entity { get; set; } = default!;

    [Parameter] public TooltipQuery Query { get; set; } = new();

    [Parameter] public HeroEntry? Hero { get; set; }
}
