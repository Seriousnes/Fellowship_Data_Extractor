@rendermode InteractiveServer
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Primitives
@using System.Text.Json
@using Microsoft.JSInterop
@using Fellowship.SDK.Client
@inject IEntityStoreService Store
@inject ITooltipViewService Cards
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IAsyncDisposable

@if (Entity is not null)
{
    <CascadingValue Value="Here">
        <div class="cx-craft">
            <div class="cx-craft-tip" aria-live="polite" @ref="layer">
                <Tooltip Entity="Entity" Query="Current" Hero="Wearer" />

                <div class="cx-craft-hits">
                    @foreach (var slot in Editable)
                    {
                        var mine = slot;

                        <button type="button" class="cx-craft-hit" @key="mine.Key"
                                data-craft="@mine.Key"
                                aria-haspopup="dialog" aria-label="@Label(mine)"
                                @ref="hits[mine.Key]"
                                @onclick="() => Open(mine)"></button>
                    }
                </div>

                <AugmentationControls OnTurn="Turn" />
            </div>

            <div class="cx-craft-side">
                <ChangedBy OnTurn="Turn" />

                <Knobs OnTurn="Turn" />

                @if (Entity is ItemDocument)
                {
                    <div class="cx-tal-bar">
                        <button type="button" class="cx-tal-act" @onclick="Copy">Copy link</button>
                        <button type="button" class="cx-tal-act" @onclick="() => pasting = true">Import</button>
                        <button type="button" class="cx-tal-act" @onclick="Export">Export</button>
                    </div>
                }

                @if (pasting || paste is { Length: > 0 })
                {
                    <textarea class="cx-craft-paste" rows="6" @bind="paste"></textarea>
                    <button type="button" class="cx-craft-read" @onclick="Import">Read</button>
                }

                @if (pieces.Count > 0)
                {
                    <ul class="cx-craft-pieces">
                        @foreach (var piece in pieces)
                        {
                            var mine = piece;

                            <li>
                                <button type="button" @onclick="() => Take(mine.Raw)">@mine.Label</button>
                            </li>
                        }
                    </ul>
                }

                @if (message is { Length: > 0 })
                {
                    <p class="cx-craft-message">@message</p>
                }
            </div>
        </div>

        @if (opened is { } editing && Entity is ItemDocument wearing)
        {
            <ModifierSelector Slot="editing" Item="wearing" Query="Current" Rarity="Cards.Rarity(wearing, Current)"
                              OnPick="candidate => Pick(editing, candidate)" OnShut="Shut" />
        }
    </CascadingValue>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    [Parameter] public int Id { get; set; }

    [Parameter] public string Page { get; set; } = string.Empty;

    [Parameter] public string? Search { get; set; }

    [Parameter] public string? Hero { get; set; }

    private EntityDocument? Entity;

    private Bearings Here = new();

    private TooltipQuery Current = new();

    private IReadOnlyDictionary<string, string> values =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

    private Dictionary<string, StringValues> raw = [];

    private ElementReference layer;

    private readonly Dictionary<string, ElementReference> hits = [];

    private IJSObjectReference? module;

    private IReadOnlyList<CraftSlot> Editable { get; set; } = [];

    private CraftSlot? opened;

    private HeroEntry? Wearer => Current.Hero is null ? null : Store.Hero(Current.Hero);

    protected override void OnParametersSet()
    {
        raw = QueryHelpers.ParseQuery(Search ?? string.Empty);
        values = PageQuery.First(raw);

        var type = EntityTypes.TryParse(Slug, out var parsed) ? parsed : (EntityType?)null;
        var readings = type is { } entityType ? Store.All(entityType, Id) : [];

        Entity = Store.Hero(Hero ?? values.GetValueOrDefault(QueryKeys.Key(ReadingParameter.Hero))) is { } wearer
            ? readings.FirstOrDefault(reading => EntityStore.Reads(reading, wearer)) ?? readings.FirstOrDefault()
            : readings.FirstOrDefault();

        if (Entity is null)
        {
            Here = new Bearings();
            Current = new TooltipQuery();
            Editable = [];
            return;
        }

        Current = PageQuery.Read(raw, Store, Hero, Entity);

        Here = new Bearings
        {
            Entity = Entity,
            Readings = readings,
            Reading = Hero,
            Page = Page,
            Id = Id,
            Values = values,
        };

        Editable = Entity is ItemDocument item
            ? [.. ItemCraft.Slots(item, Store.Settings, Cards.Rarity(item, Current)).Where(slot => slot.Accepts.Count > 0)]
            : [];
    }

    private string Label(CraftSlot slot) => slot.SlotName switch
    {
        CraftSlots.GemSocket => TooltipView.GemSocketLabel,
        CraftSlots.AttunementTree => TooltipView.TreeName(Store.Settings),
        _ => $"Modifier {slot.Ordinal + 1}",
    };

    private void Open(CraftSlot slot) => opened = slot;

    private async Task Shut()
    {
        var key = opened?.Key;
        opened = null;

        if (key is not null && hits.TryGetValue(key, out var hit)) await hit.FocusAsync();
    }

    private void Pick(CraftSlot slot, CraftCandidate candidate)
    {
        opened = null;

        var query = ItemCraft.With(Current, slot, candidate, Store.Settings);

        var (key, value) = slot.SlotName switch
        {
            CraftSlots.GemSocket => (ReadingParameter.Gem, candidate.Id.ToString(CultureInfo.InvariantCulture)),

            CraftSlots.AttunementTree => (ReadingParameter.Attunements, string.Join(
                ',', query.Attunements.Select(attuned => $"{attuned.Id}:{attuned.Rank}"))),

            _ => (ReadingParameter.Modifiers, string.Join(
                ',',
                query.Modifiers.Select(modifier =>
                    $"{modifier.Kind.ToString().ToLowerInvariant()}:{modifier.Id}:{modifier.Amount}"))),
        };

        Nav.NavigateTo(Href(key, value), replace: true);
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        module ??= await Js.InvokeAsync<IJSObjectReference>("import", "/js/craft.js");

        await module.InvokeVoidAsync("watch", layer);
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null) return;

        try
        {
            await module.InvokeVoidAsync("unwatch", layer);
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public string Href(ReadingParameter parameter, string? value)
    {
        var parameters = new Dictionary<string, StringValues>(raw, StringComparer.OrdinalIgnoreCase);
        var key = QueryKeys.Key(parameter);

        if (string.IsNullOrEmpty(value)) parameters.Remove(key); else parameters[key] = value;

        return QueryHelpers.AddQueryString(Page, parameters);
    }

    private void Turn(KnobTurn turn) => Nav.NavigateTo(Href(turn.Key, turn.Value), replace: true);

    private async Task Copy()
    {
        module ??= await Js.InvokeAsync<IJSObjectReference>("import", "/js/craft.js");

        await module.InvokeVoidAsync("copy", Nav.Uri);
    }

    private bool pasting;

    private string? paste;

    private string? message;

    private IReadOnlyList<(string Label, string Raw)> pieces = [];

    private void Import()
    {
        message = null;
        pieces = [];

        JsonDocument document;

        try
        {
            document = JsonDocument.Parse(paste ?? string.Empty);
        }
        catch (JsonException error)
        {
            message = error.Message;
            return;
        }

        using (document)
        {
            var gear = FellowshipLogs.Gear(document.RootElement);

            if (gear.Count == 0)
            {
                message = "That paste has no gear entry.";
                return;
            }

            if (gear.Count > 1)
            {
                pieces = [.. gear.Select(entry => (Name(entry), entry.GetRawText()))];
                return;
            }

            Take(gear[0].GetRawText());
        }
    }

    private void Take(string raw)
    {
        using var entry = JsonDocument.Parse(raw);

        var query = FellowshipLogs.Read(entry.RootElement, Store, out var itemId, out var unresolved);

        message = unresolved.Count == 0 ? null : string.Join(" ", unresolved);
        pieces = [];
        pasting = false;

        Nav.NavigateTo(Address(itemId, query), replace: true);
    }

    private void Export()
    {
        if (Entity is not ItemDocument item) return;

        pasting = true;
        paste = FellowshipLogs.Write(item, Current, Store).ToJsonString();
    }

    private static string Name(JsonElement entry) =>
        entry.TryGetProperty("name", out var name) && name.GetString() is { Length: > 0 } value
            ? value
            : entry.TryGetProperty("id", out var id) ? id.ToString() : "gear";

    private string Address(int itemId, TooltipQuery query)
    {
        var parameters = new Dictionary<string, StringValues>(StringComparer.OrdinalIgnoreCase)
        {
            [QueryKeys.Key(ReadingParameter.Hero)] = values.GetValueOrDefault(QueryKeys.Key(ReadingParameter.Hero)) ?? default,
            [QueryKeys.Key(ReadingParameter.Rarity)] = query.Rarity ?? default,
            [QueryKeys.Key(ReadingParameter.ItemLevel)] = Text(query.ItemLevel),
            [QueryKeys.Key(ReadingParameter.Upgrades)] = Text(query.Upgrades),
            [QueryKeys.Key(ReadingParameter.MaxUpgrades)] = Text(query.MaxUpgrades),
            [QueryKeys.Key(ReadingParameter.NoSocket)] = query.NoSocket ? "true" : default,
            [QueryKeys.Key(ReadingParameter.Gem)] = Text(query.Gem),
            [QueryKeys.Key(ReadingParameter.PotentialPower)] = Text(query.PotentialPower),
            [QueryKeys.Key(ReadingParameter.Armor)] = Text(query.Armor),
            [QueryKeys.Key(ReadingParameter.AllocatedAttunements)] = Text(query.AllocatedAttunements),
            [QueryKeys.Key(ReadingParameter.Modifiers)] = Empty(string.Join(
                ',',
                query.Modifiers.Select(modifier =>
                    $"{modifier.Kind.ToString().ToLowerInvariant()}:{modifier.Id}:{modifier.Amount}"))),
            [QueryKeys.Key(ReadingParameter.Attunements)] = Empty(string.Join(
                ',', query.Attunements.Select(attuned => $"{attuned.Id}:{attuned.Rank}"))),
        };

        foreach (var (stat, magnitudes) in query.Stats)
        {
            parameters[stat] = new StringValues(
                [.. magnitudes.Select(value => value.ToString(CultureInfo.InvariantCulture))]);
        }

        foreach (var empty in parameters.Where(pair => pair.Value.Count == 0).Select(pair => pair.Key).ToArray())
        {
            parameters.Remove(empty);
        }

        return QueryHelpers.AddQueryString($"/{Slug}/{itemId}", parameters);
    }

    private static StringValues Text(int? value) =>
        value is { } number ? number.ToString(CultureInfo.InvariantCulture) : default;

    private static StringValues Text(decimal? value) =>
        value is { } number ? number.ToString(CultureInfo.InvariantCulture) : default;

    private static StringValues Empty(string value) => value.Length == 0 ? default : value;
}
