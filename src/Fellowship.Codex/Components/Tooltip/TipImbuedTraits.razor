@inject ITooltipViewService Ui

@if (Capacity(Entity, Query) is { } total)
{
    <div class="grp">
        <div class="sec imbued"><img class="gi" alt="" src="@Ui.Chrome.TraitGlyph"><span>Imbued Traits</span><span class="n">(<span class="alloc">@Filled(Query)</span>/@total)</span></div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ItemDocument Entity { get; set; } = default!;

    [Parameter] public TooltipQuery Query { get; set; } = new();

    public static int? Capacity(ItemDocument entity, TooltipQuery query)
    {
        if (query.HasImbuedTraits == false) return null;

        if (entity.Slot is { } slot && TooltipView.ImbuedTraitCapacities.TryGetValue(slot, out var capacity))
        {
            return capacity;
        }

        return query.HasImbuedTraits == true ? TooltipView.ImbuedTraitCapacities.Values.Max() : null;
    }

    public static int Filled(TooltipQuery query) =>
        query.ImbuedTraits.Count > 0 ? query.ImbuedTraits.Count : query.AllocatedTraits ?? 0;
}
