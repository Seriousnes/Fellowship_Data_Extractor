@rendermode InteractiveServer
@inject IEntityStoreService Store
@inject ICodexViewService Ui
@inject NavigationManager Nav

<Picker TItem="FalloffSource" Items="offered" Selected="Current" Href="Href" Text="source => Ui.Name(source.Document)"
        Detail="Kind" Key="source => (source.Type, source.Document.Id)" ListId="cx-falloff-drop"
        Label="Ability or talent" Placeholder="Choose an ability or talent"
        NoMatch="No ability or talent with target count falloff matches" />

@code {
    [Parameter] public EntityType? Type { get; set; }

    [Parameter] public int? Id { get; set; }

    private IReadOnlyList<FalloffSource> offered = [];

    private FalloffSource? Current => offered.FirstOrDefault(Picked);

    private bool Picked(FalloffSource source) => source.Type == Type && source.Document.Id == Id;

    private static string Kind(FalloffSource source) =>
        $"{source.Key} {source.Document.Id.ToString(CultureInfo.InvariantCulture)}";

    private string Href(FalloffSource source) =>
        Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [QueryKeys.Key(FalloffParameter.Ability)] = source.Type == EntityType.Ability ? source.Document.Id : null,
            [QueryKeys.Key(FalloffParameter.Talent)] = source.Type == EntityType.Talent ? source.Document.Id : null,
            [QueryKeys.Key(FalloffParameter.Entry)] = null,
        });

    protected override void OnInitialized() => offered = DamageFalloff.Sources(Store);
}
