@using Fellowship.SDK.Models
@inject IEntityStoreService Store

@if (Rows.Count > 0)
{
    <Panel Head="Location / Source" Badge="@Rows.Count.ToString()" Plain="true">
        <div class="cx-sources">
            @foreach (var row in Rows)
            {
                @if (row.Place is { } place)
                {
                    <EntityLink Entity="place" Class="cx-source">@Tile(row)</EntityLink>
                }
                else
                {
                    <div class="cx-source">@Tile(row)</div>
                }
            }
        </div>
    </Panel>
}

@code {
    [CascadingParameter] private EntityDocument Entity { get; set; } = default!;

    private IReadOnlyList<Row> Rows = [];

    /// <param name="Place">The page the source has, where the export names one.</param>
    private sealed record Row(ItemSource Source, EntityDocument? Place);

    private static RenderFragment Tile(Row row) =>
        @<text>
            @if (row.Place is { } place)
            {
                <Texture Entity="place" />
            }
            <span class="cx-source-text">
                <span class="cx-source-name">@(row.Place is { } named ? named.Name ?? row.Source.Name : row.Source.Name)</span>
                <span class="cx-source-kind">@row.Source.Kind@(row.Source.Category is { } category ? $" · {category}" : null)</span>
            </span>
        </text>;

    protected override void OnParametersSet() =>
        Rows =
        [
            .. ((Entity as ItemDocument)?.Sources ?? [])
                .Select(source => new Row(source, Place(source))),
        ];

    private EntityDocument? Place(ItemSource source) =>
        source.Dungeon is { } dungeon ? Store.All(dungeon.Type, dungeon.Id).FirstOrDefault() : null;
}
