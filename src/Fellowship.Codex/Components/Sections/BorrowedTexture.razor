@if (Href is not null)
{
    <Panel Head="Borrowed texture">
        <Note>
            This record ships no texture of its own. The image above belongs to
            <a href="@Href" data-tip="@Tip?.Address" data-tip-request="@Tip?.Body">@Name</a>,
            which is where it was taken from.
        </Note>
    </Panel>
}

@code {
    [Parameter] public string? Href { get; set; }

    [Parameter] public TooltipLink? Tip { get; set; }

    [Parameter] public string? Name { get; set; }
}
