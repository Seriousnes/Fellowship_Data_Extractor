@if (Href is not null)
{
    <Panel Head="Borrowed name">
        <Note>
            This record ships no name of its own. The heading above belongs to
            <a href="@Href" data-tip="@Tip?.Address" data-tip-request="@Tip?.Body">@Name</a>,
            which is the entry that applies this one: a player reads a debuff as the ability that
            landed it, so the word is that ability's rather than this record's.
        </Note>
    </Panel>
}

@code {
    [Parameter] public string? Href { get; set; }

    [Parameter] public TooltipLink? Tip { get; set; }

    [Parameter] public string? Name { get; set; }
}
