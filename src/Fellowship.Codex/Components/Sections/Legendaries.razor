@inject ITooltipViewService Tips
@inject ICodexViewService Ui

@if (Entries.Count > 0)
{
    var badge = Entries.Count.ToString();
    <Panel Head="Legendary stats" Badge="@badge">
        @for (var index = 0; index < Entries.Count; index++)
        {
            var entry = Entries[index];

            <Rule />
            @if (entry.Roll is { } roll)
            {
                <SubHead>@PublicTypes.NameOf(roll)</SubHead>
                <Detail Entity="roll" @key="index" />
            }
            else if (entry.Untagged is { } untagged)
            {
                <SubHead>@untagged.Name</SubHead>
                @if (untagged.Description is { } description)
                {
                    <Prose>@Ui.Text(description, null, null)</Prose>
                }
            }
        }
    </Panel>
}

@code {
    [CascadingParameter] private EntityDocument Entity { get; set; } = default!;

    private IReadOnlyList<TooltipView.LegendaryEntry> Entries = [];

    protected override void OnParametersSet() => Entries = TooltipView.Legendary(Tips.LegendaryStats(Entity), Entity);
}
