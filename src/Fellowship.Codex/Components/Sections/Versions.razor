@inject ICodexViewService Ui
@inject IEntityStoreService Store

@if (Named.Count > 0)
{
    var badge = $"{Named.Count} {(Named.Count == 1 ? "version" : "versions")}";
    <Panel Head="@Head" Badge="@badge">
        @if (Here.Entity is ItemDocument)
        {
            <HeroPicker Heroes="@Wearers.Keys.ToArray()" Current="@Here.Reading" Href="@(hero => Ui.Href(Wearers[hero], hero))" />
        }
        else
        {
            @foreach (var version in Named)
            {
                <Rule />
                <SubHead Colour="@(version.OnScreen ? "var(--gold-bright)" : null)">
                    @version.Name
                    @if (version.Discriminator is { } pair)
                    {
                        <CountBadge Text="@pair" />
                    }
                </SubHead>
                <HeroPicker Heroes="@version.Heroes" Current="@Here.Reading" Href="@(hero => Ui.Href(version.Reading, hero))" />
            }
        }
    </Panel>
}

@code {
    [CascadingParameter] private Bearings Here { get; set; } = new();

    private IReadOnlyList<Version> Named = [];

    private sealed record Version(
        EntityDocument Reading, string Name, string? Discriminator, IReadOnlyList<string> Heroes, bool OnScreen);

    private SortedDictionary<string, EntityDocument> Wearers = new(StringComparer.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        Named = Split();
        Wearers = new(StringComparer.OrdinalIgnoreCase);

        foreach (var version in Named)
        {
            foreach (var hero in version.Heroes) Wearers.TryAdd(hero, version.Reading);
        }
    }

    private IReadOnlyList<Version> Split() =>
        Here.Readings.Count < 2
            ? []
            : [.. Here.Readings
                .GroupBy(reading => (
                    Name: Ui.Name(reading),
                    ArmorType: (reading as ItemDocument)?.ArmorType,
                    PrimaryStat: (reading as ItemDocument)?.PrimaryStat ?? (reading as EnchantDocument)?.PrimaryStat))
                .Select(version => new Version(
                    version.First(),
                    version.Key.Name,
                    Discriminator(version.Key.ArmorType, version.Key.PrimaryStat),
                    [.. version
                        .SelectMany(Wearing)
                        .Distinct(StringComparer.Ordinal)
                        .OrderBy(hero => hero, StringComparer.OrdinalIgnoreCase)],
                    version.Any(reading => reading == Here.Entity)))];

    private string Head => Here.Entity is AugmentationDocument ? "Versions" : $"Who can use this {Here.Noun}";

    private IEnumerable<string> Wearing(EntityDocument reading) =>
        reading is AugmentationDocument
            ? Store.Settings.Heroes.Where(hero => EntityStore.Reads(reading, hero)).Select(hero => hero.Name)
            : Ui.Codex.Facet(FacetType.Hero).Values(reading);

    private static string? Discriminator(ArmorType? armor, PrimaryStat? stat)
    {
        string?[] halves = [armor?.ToString(), stat?.ToString()];
        var pair = string.Join(" / ", halves.Where(half => !string.IsNullOrEmpty(half)));

        return pair.Length == 0 ? null : pair;
    }
}
