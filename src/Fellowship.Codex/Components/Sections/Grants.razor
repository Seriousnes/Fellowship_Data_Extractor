@inject ITooltipViewService Tips

@if (Tips.Granted(Entity) is { } grants)
{
    <section class="cx-grants" aria-label="Grants an ability">
        <div class="cx-grants-head">
            <Texture Entity="grants" Width="44" />
            <div>
                <p class="cx-grants-eyebrow">Grants an ability</p>
                <h2><EntityLink Entity="grants" /></h2>
            </div>
        </div>
        <Detail Entity="grants" />
    </section>
}

@code {
    [CascadingParameter] private EntityDocument Entity { get; set; } = default!;
}
