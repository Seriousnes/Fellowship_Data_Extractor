@inject ICodexViewService Ui
@inject IEntityStoreService Store
@inject ITooltipViewService Cards

@if (PicksHero || Wearable || IsGem || Rarities.Count > 1 || PicksDifficulty || IsItemTrait)
{
    <Panel>
        @if (PicksDifficulty)
        {
            <Knob Caption="Difficulty" As="div">
                <DifficultyKnob Difficulty="Difficulty" />
            </Knob>
        }

        @if (PicksHero)
        {
            <Knob Caption="Hero">
                <select data-knob="hero" value="@(Here.Reading ?? string.Empty)" @onchange="Wearer">
                    @if (Here.Readings.Count == 1)
                    {
                        <option value="">Any</option>
                    }
                    @foreach (var who in Store.Settings.Heroes
                        .Where(who => Here.Readings.Any(reading => EntityStore.Reads(reading, who)))
                        .OrderBy(who => who.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@who.Name" selected="@(who.Name == Here.Reading)">
                            @who.Name
                        </option>
                    }
                </select>
            </Knob>
        }

        @if (Rarities.Count > 1)
        {
            <Knob Caption="Rarity" As="div">
                <div class="cx-rarities">
                    @foreach (var rarity in Rarities)
                    {
                        var colour = CodexView.Readable(Ui.Tokens.Rarity(rarity.Name));
                        <button type="button" data-knob="rarity" data-choice="@rarity.Tier"
                                aria-pressed="@(Chosen("rarity", rarity) ? "true" : "false")"
                                data-value="@(Chosen("rarity", rarity) ? rarity.Tier.ToString() : null)"
                                style="@(colour is null ? null : $"color:{colour}")"
                                @onclick="() => Rarity(rarity)">
                            @(IsGem ? rarity.GemDisplayName : rarity.DisplayName)
                        </button>
                    }
                </div>
            </Knob>
        }

        @if (IsEnchant)
        {
            <Knob Caption="Item level">
                <input type="number" min="1" max="1000" step="1" data-knob="itemLevel"
                       value="@(Value("itemLevel") ?? Store.Settings.Items.MaxItemLevel.ToString())" @onchange="Level" />
            </Knob>
        }

        @if (IsItemTrait)
        {
            <Knob Caption="@TraitRanks.Text(Store.Settings).RankSources" As="div">
                <div class="cx-rarities">
                    @foreach (var type in TraitRanks.Text(Store.Settings).ItemTypes)
                    {
                        var mine = type;
                        var chosen = Sources.Contains(mine.Type);
                        <button type="button" data-knob="rankSources" data-choice="@mine.Type"
                                aria-pressed="@(chosen ? "true" : "false")"
                                @onclick="() => Source(mine.Type)">
                            @mine.Printed
                        </button>
                    }
                </div>
            </Knob>
        }

        @if (Wearable)
        {
            <Knob Caption="Item level">
                <input type="number" min="1" max="1000" step="1" data-knob="itemLevel"
                       value="@(Value("itemLevel") ?? DropItemLevel.ToString())" @onchange="Level" />
            </Knob>

            <Knob Caption="Tempered">
                <input type="number" min="0" max="@TemperCeiling" step="1" placeholder="none" data-knob="upgrades"
                       value="@Value("upgrades")" @onchange="Temper" />
            </Knob>
        }
    </Panel>
}

@code {
    [CascadingParameter] private Bearings Here { get; set; } = new();

    [Parameter] public EventCallback<KnobTurn> OnTurn { get; set; }

    private Task Turn(string key, string? value) => OnTurn.InvokeAsync(new KnobTurn(key, value));

    private Task Wearer(ChangeEventArgs who) => Turn("hero", who.Value?.ToString());

    private Task Rarity(RarityEntry rarity) =>
        Turn("rarity", Chosen("rarity", rarity) ? null : rarity.Tier.ToString());

    private Task Level(ChangeEventArgs level) => Turn("itemLevel", level.Value?.ToString());

    private Task Temper(ChangeEventArgs temper) => Turn("upgrades", temper.Value?.ToString());

    private bool IsGem => Here.Entity is GemDocument;

    private bool IsEnchant => Here.Entity is EnchantDocument;

    private bool IsItemTrait => Here.Entity is ItemTraitDocument;

    private IReadOnlyList<string> Sources =>
    [
        .. TraitRanks.Sources(
                Store.Settings, new TooltipQuery { RankSources = RankSources.Parse(Value("rankSources")) })
            .Select(source => source.Type),
    ];

    private Task Source(string type) =>
        Turn(
            "rankSources",
            RankSources.Write(Sources.Contains(type) ? Sources.Where(source => source != type) : [.. Sources, type]));

    private bool Wearable => (Here.Entity as ItemDocument)?.Stats is { Count: > 0 };

    private IReadOnlyList<RarityEntry> Rarities =>
        IsGem
            ? Store.Settings.Rarities
            : Here.Entity is ItemDocument { Rarities: { Count: > 0 } rarities }
                ? [.. Store.Settings.Rarities.Where(entry => rarities.Any(rarity => (int)rarity == entry.Tier))]
                : [];

    private int DropItemLevel => Here.Entity is { } entity ? Store.DropItemLevel(entity) : 0;

    private int? TemperCeiling =>
        Here.Entity is ItemDocument item
            ? Tempering.Ceiling(
                Store.Settings.MaxTempers,
                Cards.Rarity(item, new TooltipQuery { Rarity = Value("rarity") })?.Name,
                int.TryParse(Value("itemLevel"), out var level) ? level : DropItemLevel)
            : null;

    private bool PicksHero => Here.Readings.Count > 1 || (Here.Entity as ItemDocument)?.Heroes is { Count: > 1 };

    private bool PicksDifficulty => Here.Entity is CreatureDocument || Store.Menacing(Here.Entity) is not null;

    private int Difficulty => Store.Difficulty(Value(DifficultyKnob.Key));

    private string? Value(string knob) => Here.Values.GetValueOrDefault(knob);

    private bool Chosen(string knob, RarityEntry rarity) =>
        Value(knob) is { } value &&
        (value == rarity.Tier.ToString() || value.Equals(rarity.Name, StringComparison.OrdinalIgnoreCase));
}
