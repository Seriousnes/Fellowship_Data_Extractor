@inject ICodexViewService Ui
@inject IEntityStoreService Store
@inject ITooltipViewService Cards

@if (PicksHero || Wearable || IsGem || Rarities.Count > 1 || PicksDifficulty)
{
    <Panel>
        @if (PicksDifficulty)
        {
            <Knob Caption="Difficulty" As="div">
                <DifficultyKnob Difficulty="Difficulty" Ladder="Store.Ladder(Here.Entity)" />
            </Knob>
        }

        @if (PicksHero)
        {
            <Knob Caption="Hero">
                <select data-knob="@QueryKeys.Key(ReadingParameter.Hero)" value="@(Here.Reading ?? string.Empty)" @onchange="Wearer">
                    @if (Here.Readings.Count == 1)
                    {
                        <option value="">Any</option>
                    }
                    @foreach (var who in Store.Settings.Heroes
                        .Where(who => Here.Readings.Any(reading => EntityStore.Reads(reading, who)))
                        .OrderBy(who => who.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@who.Name" selected="@(who.Name == Here.Reading)">
                            @who.Name
                        </option>
                    }
                </select>
            </Knob>
        }

        @if (Rarities.Count > 1)
        {
            <Knob Caption="Rarity">
                <select class="cx-rarity" data-knob="@QueryKeys.Key(ReadingParameter.Rarity)"
                        style="@Colour(Shown)" @onchange="Rarity">
                    @foreach (var rarity in Rarities)
                    {
                        <option value="@Word(rarity)" selected="@(rarity.Tier == Shown?.Tier)" style="@Colour(rarity)">
                            @Named(rarity)
                        </option>
                    }
                </select>
            </Knob>
        }

        @if (Wearable)
        {
            <div class="cx-knob-pair">
                <Knob Caption="Item level" As="div">
                    <div class="cx-step">
                        <button type="button" aria-label="Lower item level" disabled="@(LevelBelow is null)"
                                @onclick="() => Turn(ReadingParameter.ItemLevel, LevelBelow?.ToString(CultureInfo.InvariantCulture))">&minus;</button>
                        <input type="number" inputmode="numeric" aria-label="Item level"
                               min="@LevelStep" max="@Store.Settings.Items.MaxItemLevel" step="@LevelStep"
                               data-knob="@QueryKeys.Key(ReadingParameter.ItemLevel)"
                               value="@(Typed(ReadingParameter.ItemLevel) ?? DropItemLevel.ToString())" @onchange="Level" />
                        <button type="button" aria-label="Raise item level" disabled="@(LevelAbove is null)"
                                @onclick="() => Turn(ReadingParameter.ItemLevel, LevelAbove?.ToString(CultureInfo.InvariantCulture))">+</button>
                    </div>
                </Knob>

                <Knob Caption="Tempered" Note="@(TemperCeiling is > 0 and var most ? $"0 to {most}" : null)" As="div">
                    <div class="cx-step">
                        <button type="button" aria-label="Lower tempering" disabled="@(!Tempers || Tempered is not > 0)"
                                @onclick="() => Turn(ReadingParameter.Upgrades, Tempered is > 1 ? (Tempered - 1).ToString() : null)">&minus;</button>
                        <input type="number" inputmode="numeric" aria-label="Tempered" disabled="@(!Tempers)"
                               min="0" max="@TemperCeiling" step="1" placeholder="none"
                               data-knob="@QueryKeys.Key(ReadingParameter.Upgrades)"
                               value="@Value(ReadingParameter.Upgrades)" @onchange="Temper" />
                        <button type="button" aria-label="Raise tempering" disabled="@(!Tempers || Tempered >= TemperCeiling)"
                                @onclick="() => Turn(ReadingParameter.Upgrades, ((Tempered ?? 0) + 1).ToString())">+</button>
                    </div>
                </Knob>
            </div>
        }
    </Panel>
}

@code {
    [CascadingParameter] private Bearings Here { get; set; } = new();

    [Parameter] public EventCallback<KnobTurn> OnTurn { get; set; }

    private Task Turn(ReadingParameter knob, string? value) => OnTurn.InvokeAsync(new KnobTurn(knob, value));

    private Task Wearer(ChangeEventArgs who) =>
        Turn(ReadingParameter.Hero, who.Value?.ToString() is { Length: > 0 } name ? name : null);

    private Task Rarity(ChangeEventArgs rarity) =>
        Turn(ReadingParameter.Rarity, rarity.Value?.ToString() is { Length: > 0 } tier ? tier : null);

    /// <summary>The chosen rarity, or the one the tooltip draws when none is chosen.</summary>
    private RarityEntry? Shown =>
        Rarities.FirstOrDefault(Chosen) ??
        (Here.Entity is { } entity && Cards.Rarity(entity, new TooltipQuery()) is { } drawn
            ? Rarities.FirstOrDefault(rarity => rarity.Tier == drawn.Tier)
            : null);

    private string? Colour(RarityEntry? rarity) =>
        rarity is not null && CodexView.Readable(Ui.Tokens.Rarity(rarity.Name)) is { } colour ? $"color:{colour}" : null;

    private Task Level(ChangeEventArgs level) => Turn(ReadingParameter.ItemLevel, level.Value?.ToString());

    private Task Temper(ChangeEventArgs temper) => Turn(ReadingParameter.Upgrades, temper.Value?.ToString());

    private bool IsGem => Here.Entity is GemDocument;


    private bool Wearable => (Here.Entity as ItemDocument)?.Stats is { Count: > 0 };

    private IReadOnlyList<RarityEntry> Rarities =>
        IsGem
            ? Store.Settings.Rarities
            : Here.Entity is ItemDocument { Rarities: { Count: > 0 } rarities }
                ? [.. Store.Settings.Rarities.Where(entry => rarities.Any(rarity => (int)rarity == entry.Tier))]
                : [];

    private int DropItemLevel => Here.Entity is { } entity ? Store.DropItemLevel(entity) : 0;

    private int LevelStep => Store.Settings.Items.ItemLevelsPerUpgrade;

    private int CurrentLevel =>
        int.TryParse(Value(ReadingParameter.ItemLevel), out var level) ? level : DropItemLevel;

    private int? LevelBelow =>
        (CurrentLevel - 1) / LevelStep * LevelStep is var below && below >= LevelStep ? below : null;

    private int? LevelAbove =>
        Math.Min((CurrentLevel / LevelStep + 1) * LevelStep, Store.Settings.Items.MaxItemLevel) is var above && above > CurrentLevel
            ? above
            : null;

    private int? Tempered => int.TryParse(Value(ReadingParameter.Upgrades), out var tempered) ? tempered : null;

    private bool Tempers => TemperCeiling is > 0;

    private int? TemperCeiling =>
        Here.Entity is ItemDocument item
            ? Tempering.Ceiling(
                Store.Settings.MaxTempers,
                Cards.Rarity(item, new TooltipQuery { Rarity = Value(ReadingParameter.Rarity) })?.Name,
                int.TryParse(Value(ReadingParameter.ItemLevel), out var level) ? level : DropItemLevel)
            : null;

    private bool PicksHero =>
        Here.Entity is not (AugmentationDocument or ItemDocument) &&
        (Here.Readings.Count > 1 || (Here.Entity as ItemDocument)?.Heroes is { Count: > 1 });

    private bool PicksDifficulty => Here.Entity is CreatureDocument || Store.Menacing(Here.Entity) is not null;

    private int Difficulty => Store.Difficulty(Value(ReadingParameter.Difficulty), Here.Entity);

    private string? Value(ReadingParameter knob) => Here.Values.GetValueOrDefault(QueryKeys.Key(knob));

    /// <summary>The query's text for <paramref name="knob"/>, empty for an emptied box, and null when the query has no such key.</summary>
    private string? Typed(ReadingParameter knob) =>
        Value(knob) ?? (Here.Emptied.Contains(QueryKeys.Key(knob)) ? string.Empty : null);

    private bool Chosen(RarityEntry rarity) =>
        Store.Rarity(Value(ReadingParameter.Rarity), IsGem)?.Tier == rarity.Tier;

    private string Named(RarityEntry rarity) => IsGem ? rarity.GemDisplayName : rarity.DisplayName;

    /// <summary>The query word for <paramref name="rarity"/>: its shown name, which <c>Store.Rarity</c> reads back.</summary>
    private string Word(RarityEntry rarity) => Named(rarity).ToLowerInvariant();
}
