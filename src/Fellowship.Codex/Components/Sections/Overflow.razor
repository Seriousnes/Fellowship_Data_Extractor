@inject ICodexViewService Ui

@if (Ui.Stone(Entity) is { OverflowDescription: { } description } overflow)
{
    <Panel Head="Past max power">
        <Prose>@Ui.Text(description, overflow.OverflowPlaceholders, [])</Prose>
    </Panel>
}

@code {
    [CascadingParameter] private EntityDocument Entity { get; set; } = default!;
}
