@inject ICodexViewService Ui

@if (Rows.Count > 0 || Falloff.Count > 0 || Changes.Count > 0 || Schools.Count > 0 || Tables is not null)
{
    <Panel Head="Details" Class="@(ReferenceEquals(Entity, Here.Entity) ? "cx-entity-details" : null)">
        @if (Rows.Count > 0)
        {
            <div class="cx-pairs">
                @for (var half = 0; half < 2; half++)
                {
                    var split = (Rows.Count + 1) / 2;
                    var slice = half == 0 ? Rows.Take(split) : Rows.Skip(split);

                    <Facts>
                        @foreach (var row in slice)
                        {
                            <Fact Label="@row.Label" Unit="@row.Unit">@row.Value</Fact>
                        }
                    </Facts>
                }
            </div>
        }

        @if (Falloff.Count > 0)
        {
            <Rule />
            <SubHead>Target count falloff</SubHead>
            <Facts>
                @foreach (var entry in Falloff)
                {
                    <Fact>
                        <Head>
                            @if (entry.Effect is null)
                            {
                                <text>Threshold</text>
                            }
                            else
                            {
                                <Ref Entity="entry.Effect" />
                            }
                        </Head>
                        <ChildContent>@CodexView.Number(entry.Threshold)</ChildContent>
                    </Fact>
                }
            </Facts>
        }

        @if (Changes.Count > 0)
        {
            <Rule />
            <SubHead>Changes</SubHead>
            <Facts>
                @foreach (var (target, text) in Changes)
                {
                    <Fact>
                        <Head><Ref Entity="target" /></Head>
                        <ChildContent>@text</ChildContent>
                    </Fact>
                }
            </Facts>
        }

        @if (Schools.Count > 0)
        {
            <Rule />
            <SubHead>@(Schools.Count == 1 ? "School" : "Schools")</SubHead>
            <Pills>
                @foreach (var school in Schools)
                {
                    <Pill Href="@school.Href">@school.Label</Pill>
                }
            </Pills>
        }

        @Tables
    </Panel>
}

@code {
    [CascadingParameter] private EntityDocument Entity { get; set; } = default!;

    [CascadingParameter] private Bearings Here { get; set; } = new();

    [Parameter]
    public IReadOnlyList<(string Label, string Value, string? Unit, string? Href, TooltipLink? Tip)> Facts { get; set; } = [];

    [Parameter] public IReadOnlyList<(string Label, string Href)> Schools { get; set; } = [];

    [Parameter] public RenderFragment? Tables { get; set; }

    private sealed record Row(string Label, string? Unit, RenderFragment Value);

    private IReadOnlyList<Row> Rows = [];

    private IReadOnlyList<(Fellowship.SDK.Models.EntityReference Target, string Text)> Changes => [
        .. (Entity switch
            {
                TalentDocument talent => talent.Changes ?? [],
                LegendaryPowerDocument legendary => legendary.Changes ?? [],
                _ => [],
            })
            .Select(change => (Target: Named(change.Target),
                Text: $"{Titled(FellowshipCodex.Spaced(change.Field))}: {CodexView.Modifier(change.Op, change.Value, change.Percent is true)}"))
            .DistinctBy(change => (Ui.Name(change.Target.Type, change.Target.Id), change.Text)),
    ];

    private static string Titled(string field) => field.Length == 0 ? field : char.ToUpperInvariant(field[0]) + field[1..];

    private Fellowship.SDK.Models.EntityReference Named(Fellowship.SDK.Models.EntityReference target) =>
        Ui.Store.All(target.Type, target.Id) is [AbilityDocument { Name: null, PartOf: { } part }, ..] ? part : target;

    private IReadOnlyList<Fellowship.SDK.Models.TargetCountFalloff> Falloff =>
        DamageFalloff.Source(Entity)?.Entries ?? [];

    protected override void OnParametersSet()
    {
        var rows = new List<Row>();

        foreach (var fact in Facts)
        {
            rows.Add(new Row(fact.Label, fact.Unit, fact.Href is null
                ? @<text>@fact.Value</text>
                : @<a href="@fact.Href" data-tip="@fact.Tip?.Address" data-tip-request="@fact.Tip?.Body">@fact.Value</a>));
        }

        var tokens = CodexView.PlaceholdersOf(Entity);
        var spreads = tokens.Count(token => token.Spread is not null);
        var listed = new HashSet<(string, string)>();

        foreach (var token in tokens)
        {
            foreach (var tuning in Ui.Tuning(Entity, token.Constants))
            {
                if (!listed.Add((tuning.Label, tuning.Value))) continue;

                rows.Add(new Row(tuning.Label, null, tuning.Absent
                    ? @<span class="cx-miss">@tuning.Value</span>
                    : @<text>@tuning.Value</text>));
            }

            if (token.Spread is not { } spread) continue;

            var label = spreads > 1 && token.Key is { Length: > 0 } key
                ? $"{FellowshipCodex.Spaced(key)} Spread"
                : "Spread";
            var value = CodexView.Number(spread);

            if (listed.Add((label, value))) rows.Add(new Row(label, null, @<text>@value</text>));
        }

        var constants = Entity switch
        {
            TalentDocument talent => talent.Constants,
            LegendaryPowerDocument legendary => legendary.Constants,
            _ => null,
        };

        var read = new Dictionary<string, object?>(StringComparer.Ordinal);

        foreach (var (row, value) in constants ?? new Dictionary<string, double>()) read[row] = value;

        if (Entity is EffectDocument { Talents: { } talents })
        {
            foreach (var (group, leaves) in talents)
            {
                foreach (var (leaf, value) in leaves) read[$"{group}.{leaf}"] = value;
            }
        }

        foreach (var tuning in Ui.Tuning(Entity, read))
        {
            if (listed.Add((tuning.Label, tuning.Value))) rows.Add(new Row(tuning.Label, null, @<text>@tuning.Value</text>));
        }

        var heroes = Ui.Codex.Facet(FacetType.Hero).Values(Entity).ToArray();

        if (heroes.Length > 0)
        {
            rows.Add(new Row(heroes.Length == 1 ? "Hero" : "Heroes", null, @<span class="cx-heroes">
                @foreach (var hero in heroes)
                {
                    <HeroBadge Name="@hero" />
                }
            </span>));
        }

        Rows = rows;
    }
}
