@inject ICodexViewService Ui

@if (Rows.Count > 0 || Falloff.Count > 0 || Calculations.Count > 0 || Formulas.Count > 0 || Commits.Count > 0 || LinkedBy.Count > 0 || Changes.Count > 0 || Links.Count > 0 || Schools.Count > 0 || Tables is not null)
{
    <Panel Head="Details" Class="@(ReferenceEquals(Entity, Here.Entity) ? "cx-entity-details" : null)">
        @if (Rows.Count > 0)
        {
            <div class="cx-pairs">
                @for (var half = 0; half < 2; half++)
                {
                    var split = (Rows.Count + 1) / 2;
                    var slice = half == 0 ? Rows.Take(split) : Rows.Skip(split);

                    <Facts>
                        @foreach (var row in slice)
                        {
                            <Fact Label="@row.Label" Unit="@row.Unit">@row.Value</Fact>
                        }
                    </Facts>
                }
            </div>
        }

        @if (Falloff.Count > 0)
        {
            <Rule />
            <SubHead>Target count falloff</SubHead>
            <Facts>
                @foreach (var entry in Falloff)
                {
                    <Fact>
                        <Head>
                            @if (entry.Effect is null)
                            {
                                <text>Threshold</text>
                            }
                            else
                            {
                                <Ref Entity="entry.Effect" />
                            }
                        </Head>
                        <ChildContent>@CodexView.Number(entry.Threshold)</ChildContent>
                    </Fact>
                }
            </Facts>
        }

        @if (Calculations.Count > 0)
        {
            <Rule />
            <SubHead>Calculation modifiers</SubHead>
            <Facts>
                @foreach (var modifier in Calculations)
                {
                    <Fact Label="@Ui.CalculationTarget(modifier)">@Ui.CalculationFormula(modifier)</Fact>
                }
            </Facts>
        }

        @if (Formulas.Count > 0)
        {
            <Rule />
            <SubHead>Modifiers</SubHead>
            <Facts>
                @foreach (var modifier in Formulas)
                {
                    <Fact Label="@Ui.Store.StatName(modifier.Attribute)">@Ui.ModifierFormula(modifier)</Fact>
                }
            </Facts>
        }

        @if (Commits.Count > 0)
        {
            <Rule />
            <SubHead>Applied when you use</SubHead>
            <Facts>
                @foreach (var commit in Commits)
                {
                    <Fact>
                        <Head>
                            @if (commit.Committing is { } committing)
                            {
                                @for (var at = 0; at < committing.Count; at++)
                                {
                                    @if (at > 0)
                                    {
                                        <text>, </text>
                                    }
                                    <Ref Entity="committing[at]" />
                                }
                            }
                            else
                            {
                                @Abilities(commit)
                            }
                        </Head>
                        <ChildContent>
                            @if (commit.StoppedBy is { } stopper)
                            {
                                <text>Stopped by </text>
                                <Ref Entity="stopper" />
                            }
                            else if (commit.Talent is { } talent)
                            {
                                <text>With </text>
                                <Ref Entity="talent" />
                            }
                            else
                            {
                                <text>Every use</text>
                            }
                        </ChildContent>
                    </Fact>
                }
            </Facts>
        }

        @if (LinkedBy.Count > 0)
        {
            <Rule />
            <SubHead>Applied through</SubHead>
            <Facts>
                @foreach (var link in LinkedBy)
                {
                    <Fact>
                        <Head><Ref Entity="link.Parent" /></Head>
                        <ChildContent>
                            @(link.ApplyTo == "Source" ? "Caster" : "Target")
                            @if (link.Talent is { } talent)
                            {
                                <text>, with </text>
                                <Ref Entity="talent" />
                            }
                        </ChildContent>
                    </Fact>
                }
            </Facts>
        }

        @if (Rolls.Count > 0)
        {
            <Rule />
            <SubHead>@(Rolls.Count == 1 ? "Proc rate" : "Proc rates")</SubHead>
            <Facts>
                @foreach (var roll in Rolls)
                {
                    <Fact Label="@RollLabel(roll)">@Rate(roll)</Fact>

                    @if (roll.InternalCooldown is { } cooldown)
                    {
                        <Fact Label="Internal cooldown" Unit="s">@CodexView.Number(cooldown)</Fact>
                    }

                    @if (Excluded(roll) is { Length: > 0 } excluded)
                    {
                        <Fact Label="Excludes">@excluded</Fact>
                    }
                }
                <Fact Label="Chance"><a href="@ProcChanceHref">Proc chance calculator</a></Fact>
            </Facts>
        }

        @if (Changes.Count > 0)
        {
            <Rule />
            <SubHead>Changes</SubHead>
            <Facts>
                @foreach (var (target, text) in Changes)
                {
                    <Fact>
                        <Head><Ref Entity="target" /></Head>
                        <ChildContent>@text</ChildContent>
                    </Fact>
                }
            </Facts>
        }

        @if (Links.Count > 0)
        {
            <Rule />
            <SubHead>Links</SubHead>
            <Facts>
                @foreach (var (label, targets) in Links)
                {
                    <Fact Label="@label">
                        @for (var at = 0; at < targets.Count; at++)
                        {
                            @if (at > 0)
                            {
                                <text>, </text>
                            }
                            <Ref Entity="targets[at]" />
                        }
                    </Fact>
                }
            </Facts>
        }

        @if (Schools.Count > 0)
        {
            <Rule />
            <SubHead>@(Schools.Count == 1 ? "School" : "Schools")</SubHead>
            <Pills>
                @foreach (var school in Schools)
                {
                    <Pill Href="@school.Href">@school.Label</Pill>
                }
            </Pills>
        }

        @Tables
    </Panel>
}

@code {
    [CascadingParameter] private EntityDocument Entity { get; set; } = default!;

    [CascadingParameter] private Bearings Here { get; set; } = new();

    [Parameter]
    public IReadOnlyList<(string Label, string Value, string? Unit, string? Href, TooltipLink? Tip)> Facts { get; set; } = [];

    [Parameter] public IReadOnlyList<(string Label, string Href)> Schools { get; set; } = [];

    [Parameter] public RenderFragment? Tables { get; set; }

    private sealed record Row(string Label, string? Unit, RenderFragment Value);

    private IReadOnlyList<Row> Rows = [];

    private IReadOnlyList<(Fellowship.SDK.Models.EntityReference Target, string Text)> Changes => [
        .. (Entity switch
            {
                TalentDocument talent => talent.Changes ?? [],
                LegendaryPowerDocument legendary => legendary.Changes ?? [],
                EffectDocument effect => effect.Changes ?? [],
                _ => [],
            })
            .Select(change => (Target: Named(change.Target),
                Text: $"{Titled(FellowshipCodex.Spaced(change.Field))}: {CodexView.Modifier(change.Op, change.Value, change.Percent is true)}"))
            .DistinctBy(change => (Ui.Name(change.Target.Type, change.Target.Id), change.Text)),
    ];

    private IReadOnlyList<(string Label, IReadOnlyList<Fellowship.SDK.Models.EntityReference> Targets)> Links =>
        ReferenceEquals(Entity, Here.Entity) ? Ui.Links(Entity) : [];

    private static string Titled(string field) => field.Length == 0 ? field : char.ToUpperInvariant(field[0]) + field[1..];

    private Fellowship.SDK.Models.EntityReference Named(Fellowship.SDK.Models.EntityReference target) =>
        Ui.Store.All(target.Type, target.Id) is [AbilityDocument { Name: null, PartOf: { } part }, ..] ? part : target;

    private IReadOnlyList<Fellowship.SDK.Models.TargetCountFalloff> Falloff =>
        DamageFalloff.Source(Entity)?.Entries ?? [];

    private IReadOnlyList<Fellowship.SDK.Models.CalculationModifier> Calculations =>
        Entity is EffectDocument { CalculationModifiers: { } modifiers } ? modifiers : [];

    private IReadOnlyList<Fellowship.SDK.Models.EffectModifier> Formulas =>
        Entity is EffectDocument { Modifiers: { } modifiers } ? [.. modifiers.Where(modifier => modifier.Formula is not null)] : [];

    private IReadOnlyList<Fellowship.SDK.Models.EffectLink> LinkedBy =>
        Entity is EffectDocument { LinkedBy: { } links } ? links : [];

    private IReadOnlyList<Fellowship.SDK.Models.CommitTrigger> Commits =>
        Entity is EffectDocument { AppliedOnCommitOf: { } commits } ? commits : [];

    private const string EveryCommit = "Event.CommittedAbility";

    private static string Segment(string tag) => FellowshipCodex.Spaced(tag[(tag.LastIndexOf('.') + 1)..]);

    /// <summary>The abilities a wait's tags stand for, each by its last segment, without the tags it excludes.</summary>
    private static string Abilities(Fellowship.SDK.Models.CommitTrigger commit)
    {
        var named = commit.CommittingTag is null or EveryCommit
            ? "Any ability"
            : string.Join(", ", commit.CommittingTag.Split(", ").Select(Segment));

        return commit.ExcludedTags is { Count: > 0 } excluded
            ? $"{named}, except {string.Join(", ", excluded.Select(Segment))}"
            : named;
    }

    /// <summary>The ability classes and tags whose commit leaves the roll unmade, each by its last segment.</summary>
    private static string Excluded(Fellowship.SDK.Models.ProcRoll roll) =>
        string.Join(", ", (roll.ExcludedAbilityClasses ?? []).Concat(roll.ExcludedAbilityTags ?? [])
            .Select(name => FellowshipCodex.Spaced(name[(name.LastIndexOf('.') + 1)..])));

    private IReadOnlyList<Fellowship.SDK.Models.ProcRoll> Rolls => ProcChance.Rolls(Entity) ?? [];

    /// <summary>The calculator at the proc's face: the aspect for an ability the aspect grants, the relic for a relic passive.</summary>
    private string ProcChanceHref
    {
        get
        {
            var face = ProcChance.Source(Ui.Store, EntityTypes.TypeOf(Entity), Entity.Id)?.Face ?? Entity;

            return $"/tools/proc-chance?{QueryKeys.Key(ProcParameter.Type)}={EntityTypes.Slug(EntityTypes.TypeOf(face))}" +
                   $"&{QueryKeys.Key(ProcParameter.Id)}={face.Id}";
        }
    }

    /// <summary>The row's leaf, with the talent or legendary power opening the roll where the roll is behind one.</summary>
    private string RollLabel(Fellowship.SDK.Models.ProcRoll roll)
    {
        var leaf = FellowshipCodex.Spaced(roll.Row[(roll.Row.LastIndexOf('.') + 1)..]);

        return roll.Talent is { } talent ? $"{leaf} ({Ui.Name(talent.Type, talent.Id)})" : leaf;
    }

    /// <summary>The roll's formula with the row's value in place of the rate symbol and each attribute in its display name.</summary>
    private string Rate(Fellowship.SDK.Models.ProcRoll roll) =>
        roll.ProcsPerMinute is { } rate
            ? Ui.ProcFormula(roll).Replace(Fellowship.SDK.Models.ProcRoll.Rate, CodexView.Number(rate), StringComparison.Ordinal)
            : Ui.ProcFormula(roll);

    protected override void OnParametersSet()
    {
        var rows = new List<Row>();

        foreach (var fact in Facts)
        {
            rows.Add(new Row(fact.Label, fact.Unit, fact.Href is null
                ? @<text>@fact.Value</text>
                : @<a href="@fact.Href" data-tip="@fact.Tip?.Address" data-tip-request="@fact.Tip?.Body">@fact.Value</a>));
        }

        var tokens = CodexView.PlaceholdersOf(Entity);
        var spreads = tokens.Count(token => token.Spread is not null);
        var listed = new HashSet<(string, string)>();

        foreach (var token in tokens)
        {
            foreach (var tuning in Ui.Tuning(Entity, token.Constants))
            {
                if (!listed.Add((tuning.Label, tuning.Value))) continue;

                rows.Add(new Row(tuning.Label, null, tuning.Absent
                    ? @<span class="cx-miss">@tuning.Value</span>
                    : @<text>@tuning.Value</text>));
            }

            if (token.Spread is not { } spread) continue;

            var label = spreads > 1 && token.Key is { Length: > 0 } key
                ? $"{FellowshipCodex.Spaced(key)} Spread"
                : "Spread";
            var value = CodexView.Number(spread);

            if (listed.Add((label, value))) rows.Add(new Row(label, null, @<text>@value</text>));
        }

        var constants = Entity switch
        {
            TalentDocument talent => talent.Constants,
            LegendaryPowerDocument legendary => legendary.Constants,
            _ => null,
        };

        var read = new Dictionary<string, object?>(StringComparer.Ordinal);

        foreach (var (row, value) in constants ?? new Dictionary<string, double>()) read[row] = value;

        if (Entity is not (TalentDocument or LegendaryPowerDocument))
        {
            foreach (var (row, reference) in Entity.Tuning ?? new Dictionary<string, Fellowship.SDK.Models.TuningReference>())
            {
                if (reference.Value is not null) read.TryAdd(row, reference.Value);
            }
        }

        if (Entity is EffectDocument { Talents: { } talents })
        {
            foreach (var (group, leaves) in talents)
            {
                foreach (var (leaf, value) in leaves) read[$"{group}.{leaf}"] = value;
            }
        }

        foreach (var tuning in Ui.Tuning(Entity, read))
        {
            if (listed.Add((tuning.Label, tuning.Value))) rows.Add(new Row(tuning.Label, null, @<text>@tuning.Value</text>));
        }

        var heroes = Ui.Codex.Facet(FacetType.Hero).Values(Entity).ToArray();

        if (heroes.Length > 0)
        {
            rows.Add(new Row(heroes.Length == 1 ? "Hero" : "Heroes", null, @<span class="cx-heroes">
                @foreach (var hero in heroes)
                {
                    <HeroBadge Name="@hero" />
                }
            </span>));
        }

        Rows = rows;
    }
}
