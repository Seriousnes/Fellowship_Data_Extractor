@inject ICodexViewService Ui
@inject IEntityStoreService Store

@if ((Entity as AugmentationDocument)?.RankRuns is { Count: > 0 } runs)
{
    var ranks = runs.Max(run => run.Printed.Count);

    <Rule />
    <SubHead>Per rank</SubHead>
    <div class="cx-ranks-scroll">
        <table class="cx-ranks">
            <thead>
                <tr>
                    @for (var rank = 1; rank <= ranks; rank++)
                    {
                        <th class="cx-ranks-n">Rank @rank</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var run in runs)
                {
                    <tr>
                        @for (var rank = 0; rank < ranks; rank++)
                        {
                            <td class="cx-ranks-n">
                                @if (rank < run.Printed.Count)
                                {
                                    @Ui.Text(run.Printed[rank], null, FellowshipCodex.Schools(Entity))
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Entity is EnchantDocument && AugmentationRanks.RanksByItemLevel(Store.Settings) is { Count: > 0 } levels)
{
    <Rule />
    <SubHead>Ranks per item</SubHead>
    <table class="cx-ranks">
        <thead>
            <tr><th>Item level</th><th class="cx-ranks-n">Ranks</th></tr>
        </thead>
        <tbody>
            @foreach (var (from, to, ranks) in levels)
            {
                <tr>
                    <td>@(to is { } last ? $"{from}–{last}" : $"{from}+")</td>
                    <td class="cx-ranks-n">@ranks</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [CascadingParameter] private EntityDocument Entity { get; set; } = default!;
}
