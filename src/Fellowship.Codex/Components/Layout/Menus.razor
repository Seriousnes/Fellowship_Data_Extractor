@inject ICodexViewService Ui
@inject IMenuService Nav
@inject NavigationManager Address

<nav class="cx-menus" aria-label="Site">
    <button type="button" class="cx-menus-toggle" aria-expanded="false" aria-controls="cx-menus-drawer" aria-label="Menu">
        <span class="cx-menus-bars" aria-hidden="true"></span>
    </button>

    <div class="cx-menus-drawer" id="cx-menus-drawer">
        <button type="button" class="cx-menus-shut" aria-label="Close menu">&times;</button>

        @foreach (var top in Nav.Menu)
        {
            @if (top.Sections.Count == 0)
            {
                <a class="cx-menu-open cx-menu-solo" href="@top.Href" aria-current="@Current(top.Href)">@top.Label</a>
            }
            else
            {
                <details class="cx-menu" name="cx-menu">
                    <summary class="cx-menu-open" data-here="@Current(top.Href)">@top.Label</summary>
                    <div class="cx-menu-panel">
                        @foreach (var section in top.Sections)
                        {
                            <section class="cx-menu-group">
                                @if (section.Head is { } head)
                                {
                                    <p class="cx-menu-group-head">@head</p>
                                }
                                <ul>
                                    @if (section == top.Sections[0])
                                    {
                                        <li class="cx-menu-row">
                                            <a href="@top.Href">All @top.Label</a>
                                        </li>
                                    }
                                    @foreach (var link in section.Links)
                                    {
                                        <li class="cx-menu-row">
                                            <a href="@link.Href"
                                               style="@(link.Colour is null ? null : $"color:{link.Colour}")">@link.Label</a>
                                            @Flyout(link, Keyed(top.Label))
                                        </li>
                                    }
                                </ul>
                            </section>
                        }
                    </div>
                </details>
            }
        }

        <details class="cx-menu" name="cx-menu">
            <summary class="cx-menu-open" data-here="@Current("/tools")">@ToolPages.Label</summary>
            <div class="cx-menu-panel">
                <section class="cx-menu-group">
                    <ul>
                        @foreach (var (label, href) in ToolPages.All)
                        {
                            <li class="cx-menu-row">
                                <a href="@href">@label</a>
                                @ToolFlyout(href)
                            </li>
                        }
                    </ul>
                </section>
            </div>
        </details>

        <a class="cx-menu-open cx-menu-solo" href="@PatchNotes.Href" aria-current="@Current(PatchNotes.Href)">@PatchNotes.Label</a>
    </div>
</nav>

@code {
    private string Path => "/" + Address.ToBaseRelativePath(Address.Uri).Split('?', '#')[0];

    private string? Current(string href)
    {
        var at = Segment(Path);
        var top = Segment(href);

        if (string.Equals(at, top, StringComparison.OrdinalIgnoreCase)) return "page";

        if (!EntityTypes.TryParse(at, out var type)) return null;

        var owner = type == EntityType.Hero ? Segment(Heroes.Href) : PublicTypes.Category(type).Slug;

        return string.Equals(owner, top, StringComparison.OrdinalIgnoreCase) ? "page" : null;
    }

    private static string Segment(string path) => path.Split('?', 2)[0].Trim('/').Split('/', 2)[0];

    private RenderFragment? ToolFlyout(string href) => href switch
    {
        ToolPages.AttunementTrees =>
            @<details class="cx-menu-fly" name="cx-fly-tools">
                <summary class="cx-menu-more" aria-label="Attunement Trees by slot"></summary>
                <div class="cx-menu-fly-panel">
                    <div class="cx-menu-sec">
                        <p class="cx-menu-sec-head">Slot</p>
                        <ul>
                            @foreach (var (slot, _) in AttunementTrees.BySlot(Ui.Store))
                            {
                                <li>
                                    <a href="@ToolPages.AttunementTrees/@Uri.EscapeDataString(slot.ToLowerInvariant())">@slot</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </details>,
        ToolPages.Talents =>
            @<details class="cx-menu-fly" name="cx-fly-tools">
                <summary class="cx-menu-more" aria-label="Talent Calculator by hero"></summary>
                <div class="cx-menu-fly-panel">
                    <div class="cx-menu-sec">
                        <p class="cx-menu-sec-head">Hero</p>
                        <ul>
                            @foreach (var who in Nav.Roster)
                            {
                                <li>
                                    <a href="@ToolPages.Talents/@Uri.EscapeDataString(who.ToLowerInvariant())"
                                       style="color:@(Ui.HeroColour(who) ?? "var(--muted)")">@who</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </details>,
        _ => null,
    };

    private RenderFragment? Flyout(MenuLink link, string group) =>
        link.Sections.Count == 0
            ? null
            : @<details class="cx-menu-fly" name="@("cx-fly-" + group)">
                  <summary class="cx-menu-more" aria-label="@Says(link)"></summary>
                  <div class="cx-menu-fly-panel">
                      @foreach (var section in link.Sections)
                      {
                          <div class="cx-menu-sec">
                              @if (section.Head is { } head)
                              {
                                  <p class="cx-menu-sec-head">@head</p>
                              }
                              <ul>
                                  @foreach (var under in section.Links)
                                  {
                                      <li class="cx-menu-row">
                                          <a href="@under.Href"
                                             style="@(under.Colour is null ? null : $"color:{under.Colour}")">@under.Label</a>
                                          @Flyout(under, $"{group}-{Keyed(link.Label)}")
                                      </li>
                                  }
                              </ul>
                          </div>
                      }
                  </div>
              </details>;

    private static string Says(MenuLink link) =>
        link.Sections is [{ Head: { } only }] ? $"{link.Label} by {only}" : $"More under {link.Label}";

    private static string Keyed(string label) =>
        new([.. label.Where(char.IsLetterOrDigit).Select(char.ToLowerInvariant)]);
}
