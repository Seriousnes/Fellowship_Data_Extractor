@if (As == "div")
{
    <div class="cx-knob" data-live="@Live">
        <span>@Caption</span>
        @ChildContent
    </div>
}
else
{
    <label class="cx-knob" data-live="@Live">
        <span>@Caption</span>
        @ChildContent
    </label>
}

@code {
    [Parameter, EditorRequired] public string Caption { get; set; } = string.Empty;

    [Parameter] public string As { get; set; } = "label";

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>"on" once the knob renders interactively, so input typed into it reaches the server.</summary>
    private string? Live => RendererInfo.IsInteractive ? "on" : null;
}
