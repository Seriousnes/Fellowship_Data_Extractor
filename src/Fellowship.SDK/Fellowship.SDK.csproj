<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <PropertyGroup>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <VersionPrefix>1.0.$(BuildNumber)</VersionPrefix>
    <Authors>Seriousnes</Authors>
    <Description>The documents the Fellowship data export is written as and read back through, the records the codex API answers with, a client that reads them from codex.fellowshipanalyzer.com, and the settings enums generated from the build it was extracted from.</Description>
    <PackageId>FellowshipAnalyzer.Codex.SDK</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Seriousnes/Fellowship_Data_Extractor</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Seriousnes/Fellowship_Data_Extractor</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fellowship.SDK.Generators\Fellowship.SDK.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="inputs.sha256" Pack="true" PackagePath="\" Condition="Exists('inputs.sha256')" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="settings.json" />
  </ItemGroup>

</Project>
