@inject TooltipView Ui

@* One entity as the game draws it: a self-contained, self-styled fragment.

   The same component answers both readers. The entity page places it directly, where it lands in
   the page's own DOM and the global stylesheet's @@scope (body) to (.fx-tip) stops page rules at
   its root. The API renders it to a string for callers who have no page at all, and the client
   paints that into a shadow root no stylesheet of this app enters. The <style> below is what makes
   both work, so it travels inside the fragment and this component owns no .razor.scss. *@
<div class="@TooltipView.Root" style="@Ui.Variables(Rung)">
    <style>@Sheet</style>
    @if (Art is { } art)
    {
        <figure class="slot"><img class="art" alt="" src="@art"></figure>
    }
    <div class="card">
        <header class="head">
            @* The row's public name, which for more than half of them is "Effect 2018" rather than
               a display name. Falling back to the gameplay tag put the build's own spelling in the
               one place a tooltip is certain to be read. *@
            <h3 class="title">@PublicTypes.NameOf(Entity)</h3>
            @if (Ui.Ornament(Rung) is { } ornament)
            {
                <img class="orn" alt="" src="@ornament">
            }
        </header>
        @if (shown.Count > 0)
        {
            <div class="lines">
                @if (Shows(Block.Identity))
                {
                    @if (Ruled(Block.Identity)) { <hr class="rule"> }
                    <div class="grp">
                        @if ((Entity.ArmorType ?? Entity.GemType) is { } kind)
                        {
                            <p class="kind">@kind</p>
                        }
                        @if (Entity.Slot is { } slot || Level is not null)
                        {
                            <div class="row">
                                @if (Entity.Slot is { } named)
                                {
                                    <span><img class="gi" alt="" src="@Ui.Chrome.SlotGlyph">@named</span>
                                }
                                @if (Level is { } power)
                                {
                                    <span><img class="gi" alt="" src="@Ui.Chrome.ItemPowerGlyph"><span class="power">@power</span></span>
                                }
                            </div>
                        }
                        @if (Rung is not null || Temper is not null)
                        {
                            <div class="row">
                                @if (Rung is { } rung)
                                {
                                    <span><span class="rar">@Ui.Rung(Entity, rung)</span></span>
                                }
                                @if (Temper is { } tempered)
                                {
                                    <span>@tempered</span>
                                }
                            </div>
                        }
                        @if (Entity.GemSlot == true || Entity.UniqueEquipped == true)
                        {
                            <div class="row">
                                @if (Entity.GemSlot == true)
                                {
                                    <span><span class="k">@(Query.NoSocket ? "No gem socket" : "Gem socket")</span></span>
                                }
                                @if (Entity.UniqueEquipped == true)
                                {
                                    <span><span class="k">Unique Equipped</span></span>
                                }
                            </div>
                        }
                    </div>
                }

                @if (Shows(Block.Facts))
                {
                    @if (Ruled(Block.Facts)) { <hr class="rule"> }
                    <div class="grp">
                        @* Two to a row, in the order the game prints them, with an odd one left
                           alone on the last row. *@
                        @for (var at = 0; at < facts.Count; at += 2)
                        {
                            <div class="row">
                                <span><span class="k">@facts[at].Label</span><span class="v" title="@facts[at].Title">@facts[at].Value</span></span>
                                @if (at + 1 < facts.Count)
                                {
                                    <span><span class="k">@facts[at + 1].Label</span><span class="v" title="@facts[at + 1].Title">@facts[at + 1].Value</span></span>
                                }
                            </div>
                        }
                    </div>
                }

                @if (Shows(Block.Rolls))
                {
                    @if (Ruled(Block.Rolls)) { <hr class="rule"> }
                    <div class="grp">
                        @if (Ui.Potential(Query) is { } potential)
                        {
                            <div class="row">
                                <span><span class="k">Power Potential</span></span>
                                <span><span class="pot">@potential</span></span>
                            </div>
                        }
                        @if (rolls.Count > 0)
                        {
                            <ul class="stats">
                                @foreach (var line in rolls)
                                {
                                    <li class="@TooltipView.Weight(line)"><span class="v">@TooltipView.Magnitude(line)</span><span>@line.DisplayName</span></li>
                                }
                            </ul>
                        }
                    </div>
                }

                @if (Shows(Block.Prose))
                {
                    @if (Ruled(Block.Prose)) { <hr class="rule"> }
                    <div class="grp">
                        @* .desc and .note are white-space: pre-line, so these are written on one
                           line and carry no literal text: a newline from source indentation would
                           be a rendered blank line. *@
                        @if (Entity.Description is { } description)
                        {
                            <p class="desc">@Ui.Text(description, Entity.Placeholders, Query, Hero, Entity.Tags)</p>
                        }
                        @foreach (var detail in Entity.Detail ?? [])
                        {
                            <p class="note">@Ui.Text(detail, Entity.Placeholders, Query, Hero, Entity.Tags)</p>
                        }
                    </div>
                }

                @if (Shows(Block.Overflow) && Entity.GemOverflow is { } overflow)
                {
                    @if (Ruled(Block.Overflow)) { <hr class="rule"> }
                    <div class="grp">
                        <div class="sec"><span>Past Max Power</span></div>
                        <p class="desc">@Ui.Text(overflow.Description, overflow.Placeholders, Query, Hero, Entity.Tags)</p>
                    </div>
                }

                @if (Shows(Block.Granted) && Entity.Grants is { } grants)
                {
                    @if (Ruled(Block.Granted)) { <hr class="rule"> }
                    <div class="grp">
                        <div class="sec ability"><img class="gi" alt="" src="@Ui.Chrome.AbilityBadge.Url"><span>Ability@(Granted is { } name ? ": " + name : null)</span></div>
                        @if (grants.Description is { } text)
                        {
                            <p class="desc">@Ui.Text(text, grants.Placeholders, Query, Hero, grants.Tags ?? Entity.Tags)</p>
                        }
                    </div>
                }

                @if (Shows(Block.Legendaries) && Entity.LegendaryStats is { Count: > 0 } legendaries)
                {
                    @if (Ruled(Block.Legendaries)) { <hr class="rule"> }
                    <div class="grp">
                        <div class="sec legendary"><img class="gi" alt="" src="@Ui.Chrome.LegendaryBadge.Url"><span>Legendary Stats</span><span class="n">(@legendaries.Count)</span></div>
                        @foreach (var roll in legendaries)
                        {
                            @if (PublicTypes.DisplayNameOf(roll) is { } name)
                            {
                                <p class="nm">@name</p>
                            }
                            @if (roll.Description is { } text)
                            {
                                <p class="desc">@Ui.Text(text, roll.Placeholders, Query, Hero, roll.Tags ?? Entity.Tags)</p>
                            }
                        }
                    </div>
                }

                @if (Shows(Block.Sets) && Entity.SetBonus is { Count: > 0 } sets)
                {
                    @if (Ruled(Block.Sets)) { <hr class="rule"> }
                    <div class="grp">
                        <div class="sec setbonus"><img class="gi" alt="" src="@Ui.Chrome.SetBonusBadge.Url"><span>Set Bonus</span>@if (Entity.SetCount is { } pieces)
                            {<span class="n">(@pieces pieces)</span>}</div>
                        <p class="desc">@string.Join(", ", sets)</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>The reading being drawn, already resolved to one hero's version where it has one.</summary>
    [Parameter, EditorRequired] public Entity Entity { get; set; } = new();

    /// <summary>What the caller holds: their rung, item level, temperings, stats and hero.</summary>
    [Parameter] public TooltipQuery Query { get; set; } = new();

    /// <summary>The hero whose numbers the text is substituted with, or null for nobody's.</summary>
    [Parameter] public HeroEntry? Hero { get; set; }

    /// <summary>
    /// The eight things a tooltip can say, named so the separator rule can be written against them.
    /// A rule goes above every block that renders except the first, which is what puts one between
    /// each pair of neighbours and none at the top.
    /// </summary>
    private enum Block { Identity, Facts, Rolls, Prose, Overflow, Granted, Legendaries, Sets }

    private RarityEntry? Rung;

    private string? Art;

    private int? Level;

    private string? Temper;

    private string? Granted;

    /// <summary>
    /// The fragment's stylesheet, as markup rather than as text. A string here is HTML-encoded on
    /// the way out, which turns every font-family quote into &amp;quot; and every newline into a
    /// character reference: the sheet still loads, still parses and styles nothing it should.
    /// </summary>
    private MarkupString Sheet;

    private IReadOnlyList<TooltipView.Fact> facts = [];

    private IReadOnlyList<StatLine> rolls = [];

    private List<Block> shown = [];

    private bool Shows(Block block) => shown.Contains(block);

    /// <summary>Whether a separator goes above a block, which is true of every one but the first.</summary>
    private bool Ruled(Block block) => shown.IndexOf(block) > 0;

    protected override void OnParametersSet()
    {
        Rung = Ui.Rarity(Entity, Query);
        Art = Ui.Art(Entity, Rung);
        Level = Ui.Level(Entity, Query);
        Temper = Ui.Temper(Query);
        Sheet = new MarkupString(Ui.Style());
        facts = Ui.Facts(Entity, Query);
        rolls = Ui.Rolls(Entity, Query, Rung);

        // A nested row is addressed by nothing and has no id to fall back on, so a granted ability
        // is named or it is drawn as "Ability" alone.
        Granted = Entity.Grants is null ? null : PublicTypes.DisplayNameOf(Entity.Grants);

        // Worked out before the markup runs, because Razor cannot ask whether a child rendered
        // anything and the separators are placed between the blocks that did.
        shown = [];

        if ((Entity.ArmorType ?? Entity.GemType) is not null || Entity.Slot is not null ||
            Level is not null || Rung is not null || Temper is not null ||
            Entity.GemSlot == true || Entity.UniqueEquipped == true) shown.Add(Block.Identity);

        if (facts.Count > 0) shown.Add(Block.Facts);

        if (Ui.Potential(Query) is not null || rolls.Count > 0) shown.Add(Block.Rolls);

        if (Entity.Description is not null || Entity.Detail is { Count: > 0 }) shown.Add(Block.Prose);

        if (Entity.GemOverflow is not null) shown.Add(Block.Overflow);

        if (Entity.Grants is { } grants && (Granted ?? grants.Description) is not null) shown.Add(Block.Granted);

        if (Entity.LegendaryStats is { Count: > 0 }) shown.Add(Block.Legendaries);

        if (Entity.SetBonus is { Count: > 0 }) shown.Add(Block.Sets);
    }
}
