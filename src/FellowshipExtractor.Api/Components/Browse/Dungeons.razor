@inject ICodexViewService Ui

<Table Items="Drawn" T="DungeonDocument" SortLink="View.SortLink" SortState="View.SortState"
       Group="Grouped.By<DungeonDocument>(View, Ui.Codex)">
    <Columns>
        <Column Head="" Class="cx-art">
            <Content Context="row"><Art Entity="row" /></Content>
        </Column>
        <Column Head="Name" Key="name">
            <Content Context="row"><EntityLink Entity="row" Class="cx-nm" /></Content>
        </Column>
        <Column Head="Qualifier" Key="qualifier" Numeric Unit="s" Value="row => row.QualifierTime" />
        <Column Head="Required score" Key="score" Numeric Value="row => row.RequiredScore" />
        <Column Head="Creatures" Numeric Value="row => Dwelling(row)" />
    </Columns>
</Table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<EntityDocument> Rows { get; set; } = [];

    [Parameter, EditorRequired] public BrowseView View { get; set; } = default!;

    private IReadOnlyList<DungeonDocument> Drawn = [];

    private IReadOnlyDictionary<int, int> counts = new Dictionary<int, int>();

    protected override void OnParametersSet()
    {
        Drawn = [.. Rows.OfType<DungeonDocument>()];

        counts = Ui.Codex.Of(EntityType.Creature)
            .OfType<CreatureDocument>()
            .SelectMany(creature => creature.FoundIn ?? [])
            .GroupBy(level => level.Id)
            .ToDictionary(levels => levels.Key, levels => levels.Count());
    }

    private int? Dwelling(DungeonDocument dungeon) =>
        counts.TryGetValue(dungeon.Id, out var found) ? found : null;
}
