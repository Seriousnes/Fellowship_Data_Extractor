@inject ICodexViewService Ui

<Table Items="Drawn" SortLink="View.SortLink" SortState="View.SortState"
       Group="Grouped.By<GemTraitDocument>(View, Ui.Codex)">
    <Columns>
        <Column T="GemTraitDocument" Head="" Class="cx-art">
            <Content Context="row"><Art Entity="row" /></Content>
        </Column>
        <Column T="GemTraitDocument" Head="Name" Key="name">
            <Content Context="row"><EntityLink Entity="row" Class="cx-nm" /></Content>
        </Column>
        <Column T="GemTraitDocument" Head="Power Required" Key="power" Numeric Value="row => row.RequiredPower" />
        <Column T="GemTraitDocument" Head="Type" Key="gem">
            <Content Context="row">
                <span style="color:@CodexView.Readable(Ui.Tokens.Gem(row.Gem.ToString()))">@row.Gem</span>
            </Content>
        </Column>
    </Columns>
</Table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<EntityDocument> Rows { get; set; } = [];

    [Parameter, EditorRequired] public BrowseView View { get; set; } = default!;

    private IReadOnlyList<GemTraitDocument> Drawn = [];

    protected override void OnParametersSet() => Drawn = [.. Rows.OfType<GemTraitDocument>()];
}
