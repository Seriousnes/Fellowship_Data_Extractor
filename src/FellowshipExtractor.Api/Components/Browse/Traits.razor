@inject ICodexViewService Ui

<Table Items="Drawn" SortLink="View.SortLink" SortState="View.SortState"
       Group="Grouped.By<TraitDocument>(View, Ui.Codex)">
    <Columns>
        <Column T="TraitDocument" Head="" Class="cx-art">
            <Content Context="row"><Art Entity="row" /></Content>
        </Column>
        <Column T="TraitDocument" Head="Name" Key="name">
            <Content Context="row"><EntityLink Entity="row" Class="cx-nm" /></Content>
        </Column>
        <Column T="TraitDocument" Head="Category" Key="category" Value="row => row.Category" />
        <Column T="TraitDocument" Head="Max Rank" Key="rank" Numeric Value="row => row.MaxRank" />
        <Column T="TraitDocument" Head="Random Chance" Numeric Unit="%" Value="row => row.RandomChance" />
    </Columns>
</Table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<EntityDocument> Rows { get; set; } = [];

    [Parameter, EditorRequired] public BrowseView View { get; set; } = default!;

    private IReadOnlyList<TraitDocument> Drawn = [];

    protected override void OnParametersSet() => Drawn = [.. Rows.OfType<TraitDocument>()];
}
