@inject ICodexViewService Ui

<Table Items="Drawn" SortLink="View.SortLink" SortState="View.SortState"
       Group="Grouped.By<SetBonusDocument>(View, Ui.Codex)">
    <Columns>
        <Column T="SetBonusDocument" Head="" Class="cx-art">
            <Content Context="row"><Art Entity="row" /></Content>
        </Column>
        <Column T="SetBonusDocument" Head="Name" Key="name">
            <Content Context="row"><EntityLink Entity="row" Class="cx-nm" /></Content>
        </Column>
        <Column T="SetBonusDocument" Head="Required" Key="pieces" Numeric Value="row => row.Pieces" />
        <Column T="SetBonusDocument" Head="Attribute" Key="attribute" Class="cx-tags">
            <Content Context="row">
                @foreach (var allowed in row.AllowedAttributes ?? [])
                {
                    <Chip>@allowed</Chip>
                }
            </Content>
        </Column>
        <Column T="SetBonusDocument" Head="Role" Key="role" Class="cx-tags">
            <Content Context="row">
                @foreach (var role in row.AllowedRoles ?? [])
                {
                    <Chip Colour="@CodexView.Readable(Ui.Tokens.Role(role))">@role</Chip>
                }
            </Content>
        </Column>
    </Columns>
</Table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<EntityDocument> Rows { get; set; } = [];

    [Parameter, EditorRequired] public BrowseView View { get; set; } = default!;

    private IReadOnlyList<SetBonusDocument> Drawn = [];

    protected override void OnParametersSet() => Drawn = [.. Rows.OfType<SetBonusDocument>()];
}
