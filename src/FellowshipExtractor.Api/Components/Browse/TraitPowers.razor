@inject ICodexViewService Ui

<Table Items="Drawn" SortLink="View.SortLink" SortState="View.SortState"
       Group="Grouped.By<TraitPowerDocument>(View, Ui.Codex)">
    <Columns>
        <Column T="TraitPowerDocument" Head="" Class="cx-art">
            <Content Context="row"><Art Entity="row" /></Content>
        </Column>
        <Column T="TraitPowerDocument" Head="Name" Key="name">
            <Content Context="row"><EntityLink Entity="row" Class="cx-nm" /></Content>
        </Column>
        <Column T="TraitPowerDocument" Head="Duration" Key="duration" Unit="s" Numeric Value="row => row.Duration" />
    </Columns>
</Table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<EntityDocument> Rows { get; set; } = [];

    [Parameter, EditorRequired] public BrowseView View { get; set; } = default!;

    private IReadOnlyList<TraitPowerDocument> Drawn = [];

    protected override void OnParametersSet() => Drawn = [.. Rows.OfType<TraitPowerDocument>()];
}
