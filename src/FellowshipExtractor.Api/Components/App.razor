@inject ICodexViewService Ui
<!DOCTYPE html>
<html lang="en" data-theme="fellowship">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />

    <style>@((MarkupString)Palette)</style>

    <link rel="stylesheet" href="css/codex.css" />
    <link rel="stylesheet" href="FellowshipExtractor.Api.styles.css" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ctext y='26' font-size='26'%3E%F0%9F%9B%A1%3C/text%3E%3C/svg%3E" />

    <HeadOutlet />
</head>
<body>
    <Routes />

    <script src="_framework/blazor.web.js"></script>
    <script type="module" src="js/codex.js"></script>
</body>
</html>

@code {
    private string Palette =>
        $$"""
        :root{
        {{Ui.Tokens.CssVariables()}}
        --chrome-panel:url("{{Ui.Chrome.Panel}}");
        --chrome-rule:url("{{Ui.Chrome.Rule}}");
        --chrome-header:url("{{Ui.Chrome.Header(null)}}");
        --chrome-arrow:url("{{Ui.Chrome.SlotGlyph(null)}}");
        }
        {{Ui.RichTextCss("cx-prose")}}
        """;
}
