@if (Rows.Count > 0)
{
    var badge = Rows.Count.ToString();
    <Panel Head="Tuning" Badge="@badge">
        <Note>
            Every shipped tuning number this entry reaches that no field above already states, under
            the words it tunes. The asset a number belongs to is not part of what it tunes and is
            left off; the hero one is written for is, and is named. A stat a row names is printed the
            way the game prints it.
        </Note>
        <KeyValues>
            @foreach (var row in Rows)
            {
                <KeyValue Key="@row.Label" Missing="row.Absent">@row.Value</KeyValue>
            }
        </KeyValues>
    </Panel>
}

@code {
    /// <summary>
    /// The shipped tuning numbers this entry reaches, under the words each one tunes, resolved by
    /// Detail because reading them needs the view.
    /// </summary>
    [Parameter] public IReadOnlyList<TuningRow> Rows { get; set; } = [];
}
