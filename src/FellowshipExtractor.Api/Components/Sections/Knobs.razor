@inject ICodexViewService Ui
@inject IEntityStoreService Store

@if (PicksHero || Wearable || IsGem || PicksDifficulty)
{
    <Panel>
        @if (PicksDifficulty)
        {
            <Knob Caption="Difficulty" As="div">
                <DifficultyKnob Difficulty="Difficulty" />
            </Knob>
        }

        @if (PicksHero)
        {
            <Knob Caption="Hero">
                <select data-knob="hero"
                        onchange="location.search = '?hero=' + encodeURIComponent(this.value)">
                    @if (Here.Readings.Count == 1)
                    {
                        <option value="">Any</option>
                    }
                    @foreach (var who in Store.Settings.Heroes
                        .Where(who => Here.Readings.Any(reading => EntityStore.Reads(reading, who)))
                        .OrderBy(who => who.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@who.Name" selected="@(who.Name == Here.Reading)">
                            @who.Name (@who.ArmorType, @who.PrimaryStat)
                        </option>
                    }
                </select>
            </Knob>
        }

        @if (Wearable || IsGem)
        {
            <Knob Caption="Rarity" As="div">
                <div class="cx-rungs">
                    @foreach (var rung in Store.Settings.Rarities)
                    {
                        var colour = CodexView.Readable(Ui.Tokens.Rarity(rung.Name));
                        <button type="button" data-knob="rarity" data-choice="@rung.Tier"
                                aria-pressed="@(Chosen("rarity", rung) ? "true" : "false")"
                                data-value="@(Chosen("rarity", rung) ? rung.Tier.ToString() : null)"
                                style="@(colour is null ? null : $"color:{colour}")">
                            @(IsGem ? rung.GemDisplayName : rung.DisplayName)
                        </button>
                    }
                </div>
            </Knob>
        }

        @if (Wearable)
        {
            <Knob Caption="Item level">
                <input type="number" min="1" max="1000" step="1"
                       value="@(Given("itemLevel") ?? DropItemLevel.ToString())" data-knob="itemLevel" />
            </Knob>

            <Knob Caption="Tempered">
                <input type="number" min="0" max="20" step="1" placeholder="none"
                       value="@Given("upgrades")" data-knob="upgrades" />
            </Knob>

            <Knob Caption="Random stats">
                <input type="text" placeholder="@RollablePlaceholder"
                       value="@Given("randomStats")" data-knob="randomStats" />
            </Knob>
        }
    </Panel>
}

@code {
    [CascadingParameter] private Bearings Here { get; set; } = new();

    private bool IsGem => Here.Shown is GemDocument;

    private bool Wearable => (Here.Shown as ItemDocument)?.Stats is { Count: > 0 };

    private int DropItemLevel => Here.Shown is { } shown ? Store.DropItemLevel(shown) : 0;

    private bool PicksHero => Here.Readings.Count > 1 || (Here.Shown as ItemDocument)?.Heroes is { Count: > 1 };

    private bool PicksDifficulty => Here.Shown is CreatureDocument || Store.Menacing(Here.Shown) is not null;

    private int Difficulty => Store.Difficulty(Given(DifficultyKnob.Asked));

    private string? Given(string knob) => Here.Asked.GetValueOrDefault(knob);

    private bool Chosen(string knob, RarityEntry rung) =>
        Given(knob) is { } value &&
        (value == rung.Tier.ToString() || value.Equals(rung.Name, StringComparison.OrdinalIgnoreCase));

    private string RollablePlaceholder =>
        string.Join(", ", Store.Settings.StatCalculation.RandomStatPool.Take(2)) + ", one per roll";
}
