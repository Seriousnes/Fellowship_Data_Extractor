@if (Tokens.Count > 0)
{
    var badge = Tokens.Count.ToString();
    <Panel Head="Substitutions" Badge="@badge">
        <Note>
            Where each number in the text above comes from, in the order the text spends them. A
            coefficient is multiplied by the attribute it names; a band is the width the roll lands
            in, so the printed range is the mean less and plus half of it.
        </Note>
        @foreach (var token in Tokens)
        {
            <div class="cx-token">
                <span class="cx-token-name">#@token.Ordinal</span>
                <div class="cx-token-read">
                    @if (token.Resolved)
                    {
                        @token.Reading
                    }
                    else
                    {
                        <span class="cx-miss">@token.Reading</span>
                    }
                </div>
                @if (token.Working.Length > 0)
                {
                    <div class="cx-token-work">@token.Working</div>
                }
                @if (token.Tuning.Count > 0)
                {
                    <KeyValues>
                        @foreach (var row in token.Tuning)
                        {
                            <KeyValue Key="@row.Label" Missing="row.Absent">@row.Value</KeyValue>
                        }
                    </KeyValues>
                }
            </div>
        }
    </Panel>
}

@code {
    [Parameter] public IReadOnlyList<TokenReading> Tokens { get; set; } = [];
}
