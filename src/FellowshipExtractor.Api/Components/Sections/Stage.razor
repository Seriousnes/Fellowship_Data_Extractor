@* The caption is a sibling of the stage rather than a child of it: the client paints the fetched
   tooltip into a shadow root on the staged element, which stops anything in that element's own
   markup from being drawn once the first answer lands. So .cx-entity-tip sizes the outer div and
   data-stage marks the inner one, which is the element codex.js attaches the root to.

   data-stage and aria-live are plain HTML attributes and are emitted verbatim. The div carries no
   @key and its element type never changes, so its shadow root survives an enhanced navigation. *@
<div class="cx-entity-tip">
    <div data-stage="@Here.Address" aria-live="polite">
        <Empty>Loading...</Empty>
    </div>
</div>

@code {
    /// <summary>
    /// The page's own facts. The address is complete, including any hero the page wants carried
    /// into the request, and is never recomputed from a nested record.
    /// </summary>
    [CascadingParameter] private Bearings Here { get; set; } = new();
}
