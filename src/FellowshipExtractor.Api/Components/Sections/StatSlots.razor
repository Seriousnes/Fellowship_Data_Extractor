@inject CodexView Ui

@if (Entity.Stats is { Count: > 0 } slots)
{
    var badge = slots.Count.ToString();
    <Panel Head="Stat slots" Badge="@badge">
        <Note>
            A slot's weight is its share of the item's stat budget. The magnitude is not in the build:
            a dynamic item rolls it from its level and rarity when it drops, which is what the tooltip
            above computes.
        </Note>
        <ul class="cx-stat-lines">
            @foreach (var slot in slots)
            {
                <li class="@(Major(slot) ? "cx-primary" : "cx-secondary")">
                    <span>@Ui.Store.StatName(slot.Stat)</span>
                    <span class="cx-w">@slot.Kind &middot; weight @slot.Weight</span>
                </li>
            }
        </ul>
    </Panel>
}

@code {
    /// <summary>The record this panel draws, re-supplied by every Detail.</summary>
    [CascadingParameter] private Entity Entity { get; set; } = new();

    /// <summary>
    /// Whether a slot draws on the primary pool, which is what the game draws its line in the
    /// heavier colour for. The wearer's own attributes are the ones the roster names, so the split
    /// comes from the export beside stamina, which draws on that pool without being anyone's.
    /// </summary>
    private bool Major(StatSlot slot) =>
        Ui.Store.PrimaryAttributes.Contains(slot.Stat) || slot.Stat == "Stamina";
}
