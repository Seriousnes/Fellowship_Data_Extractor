@inject TooltipView Tips

@if (Rolls.Count > 0)
{
    var badge = Rolls.Count.ToString();
    <Panel Head="Legendary stats" Badge="@badge">
        @for (var index = 0; index < Rolls.Count; index++)
        {
            var roll = Rolls[index];

            <Rule />
            <SubHead>@PublicTypes.NameOf(roll)</SubHead>
            <Detail Entity="roll" @key="index" />
        }
    </Panel>
}

@code {
    /// <summary>The record this panel draws, re-supplied by every Detail.</summary>
    [CascadingParameter] private EntityDocument Entity { get; set; } = default!;

    /// <summary>
    /// Resolved through <see cref="TooltipView.LegendaryStats"/> rather than cascaded, because a
    /// document carries its own bonus stats by id, resolved against the store, rather than nesting
    /// the rolls' full records.
    ///
    /// The loop below is a for rather than a foreach so the key has a value, the index into the
    /// list. The rolls are drawn in export order and never sorted.
    /// </summary>
    private IReadOnlyList<EntityDocument> Rolls => Tips.LegendaryStats(Entity);
}
