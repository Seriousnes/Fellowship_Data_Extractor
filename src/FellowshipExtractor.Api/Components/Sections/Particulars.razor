@inject CodexView Ui

@if (Facts.Count > 0 || Schools.Count > 0 || Heroes.Count > 0 ||
     SetBonus.Count > 0 || Scaling.Count > 0 ||
     AllowedRoles.Count > 0 || AllowedAttributes.Count > 0)
{
    <Panel Head="Details">
        @if (Facts.Count > 0)
        {
            <div class="cx-pairs">
                @for (var half = 0; half < 2; half++)
                {
                    var split = (Facts.Count + 1) / 2;
                    var slice = half == 0 ? Facts.Take(split) : Facts.Skip(split);

                    <Facts>
                        @foreach (var fact in slice)
                        {
                            <Fact Label="@fact.Label" Unit="@fact.Unit">
                                @if (fact.Href is null)
                                {
                                    @fact.Value
                                }
                                else
                                {
                                    <a href="@fact.Href" data-tip="@fact.Tip">@fact.Value</a>
                                }
                            </Fact>
                        }
                    </Facts>
                }
            </div>
        }

        @if (Schools.Count > 0)
        {
            <Rule />
            <SubHead>@(Schools.Count == 1 ? "School" : "Schools")</SubHead>
            <Pills>
                @foreach (var school in Schools)
                {
                    <Pill Href="@school.Href">@school.Label</Pill>
                }
            </Pills>
        }

        @if (Heroes.Count > 0)
        {
            <Rule />
            <SubHead>Heroes</SubHead>
            <Pills>
                @foreach (var hero in Heroes)
                {
                    var where = $"/browse?hero={Uri.EscapeDataString(hero)}";
                    <Pill Href="@where" Colour="@Ui.HeroColour(hero)">@hero</Pill>
                }
            </Pills>
        }

        @if (SetBonus.Count > 0)
        {
            <Rule />
            <SubHead>Set</SubHead>
            <Pills>
                @foreach (var set in SetBonus)
                {
                    var where = $"/browse?set={Uri.EscapeDataString(set)}";
                    <Pill Href="@where">@set</Pill>
                }
            </Pills>
        }

        @if (Scaling.Count > 0)
        {
            <Rule />
            <SubHead>Scales off</SubHead>
            <Pills>
                @foreach (var stat in Scaling)
                {
                    <Pill>@stat</Pill>
                }
            </Pills>
        }

        @if (AllowedRoles.Count > 0)
        {
            <Rule />
            <SubHead>Offered to</SubHead>
            <Pills>
                @foreach (var role in AllowedRoles)
                {
                    var tone = Ui.Tokens.Role(role) ?? "inherit";
                    <Pill Colour="@tone">@role</Pill>
                }
                @foreach (var stat in AllowedAttributes)
                {
                    <Pill>@stat</Pill>
                }
            </Pills>
        }
    </Panel>
}

@code {
    /// <summary>The record this panel draws, re-supplied by every Detail.</summary>
    [CascadingParameter] private EntityDocument Entity { get; set; } = default!;

    /// <summary>
    /// The scalar facts, already formatted and already carrying any address they link to, because
    /// a nested row carries no table and no id of its own to build one from.
    /// </summary>
    [Parameter]
    public IReadOnlyList<(string Label, string Value, string? Unit, string? Href, string? Tip)> Facts { get; set; } = [];

    /// <summary>
    /// The damage schools this entry is, each with the filter it links into, built by Detail
    /// through the school facet's own selector.
    /// </summary>
    [Parameter] public IReadOnlyList<(string Label, string Href)> Schools { get; set; } = [];

    /// <summary>
    /// The attributes this entry's numbers grow with, under the words the game prints for them.
    /// Resolved by Detail through the catalogue, which is what takes the run-together spelling off,
    /// so a pill reads Damage Scale and never DamageScale.
    /// </summary>
    [Parameter] public IReadOnlyList<string> Scaling { get; set; } = [];

    /// <summary>
    /// Every hero a row is for, read through the catalogue's own "hero" facet rather than a second
    /// copy of the same switch: an item's own list, or the single hero a talent slot names.
    /// </summary>
    private IReadOnlyList<string> Heroes => [.. Ui.Codex.Facet("hero")?.Values(Entity) ?? []];

    private IReadOnlyList<string> SetBonus => (Entity as Item)?.SetBonus ?? [];

    private IReadOnlyList<string> AllowedRoles => (Entity as Fellowship.SDK.Documents.SetBonus)?.AllowedRoles ?? [];

    // PrimaryStat's own members are Agility, Intellect and Strength, already the word the game
    // prints for each - the same reading Codex.cs's own "stat" facet takes - so this needs no pass
    // through the shipped attribute table.
    private IReadOnlyList<string> AllowedAttributes =>
        (Entity as Fellowship.SDK.Documents.SetBonus)?.AllowedAttributes is { } attributes
            ? [.. attributes.Select(stat => stat.ToString())]
            : [];
}
