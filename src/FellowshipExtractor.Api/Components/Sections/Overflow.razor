@inject CodexView Ui

@if (Entity is GemType { OverflowDescription: { } description } overflow)
{
    <Panel Head="Past max power">
        <Prose>@Ui.Text(description, overflow.OverflowPlaceholders, [])</Prose>
    </Panel>
}

@code {
    /// <summary>
    /// The record this panel draws, re-supplied by every Detail. A gem type carries no tags of its
    /// own, so the sentence speaks no damage school, matching <see cref="PublicGemOverflow"/>'s own
    /// reading of the same field.
    /// </summary>
    [CascadingParameter] private EntityDocument Entity { get; set; } = default!;
}
