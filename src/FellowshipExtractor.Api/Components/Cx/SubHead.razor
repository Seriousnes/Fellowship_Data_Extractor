<p class="cx-sub-head" style="@Tone">@ChildContent</p>

@code {
    /// <summary>
    /// The sub-head's text. Child content rather than a string because several call sites compose it
    /// from an expression: the school count picks singular or plural, a set trails its piece count,
    /// and a talent group trails a conditional badge.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The ink colour, on the same terms as a Pill's: null omits the style attribute entirely. The
    /// versions panel lights the one named version the tooltip above is currently showing.
    /// </summary>
    [Parameter] public string? Colour { get; set; }

    private string? Tone => Colour is null ? null : $"color:{Colour}";
}
