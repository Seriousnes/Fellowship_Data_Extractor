@typeparam T
@implements IDisposable

@code {
    [CascadingParameter] public Table<T> Table { get; set; } = default!;

    [Parameter, EditorRequired] public string Head { get; set; } = string.Empty;

    [Parameter] public Func<T, object?>? Value { get; set; }

    [Parameter] public RenderFragment<T>? Content { get; set; }

    [Parameter] public string? Key { get; set; }

    [Parameter] public string? Unit { get; set; }

    [Parameter] public bool Numeric { get; set; }

    [Parameter] public string? Class { get; set; }

    protected override void OnInitialized() => Table.Add(this);

    public void Dispose() => Table.Remove(this);
}
