@page "/"
@inject CodexView Ui
@inject EntityStore Store

<PageTitle>Fellowship Codex</PageTitle>

<section class="cx-hero-band">
    <h1>The Fellowship Codex</h1>
    <p>
        @Entries.ToString("N0") entries read straight out of the shipped build: every item, ability,
        effect, talent, trait and creature in it, with the art, the tuning numbers and the tooltip the
        game draws from them.
    </p>
</section>

<Panel Head="The roster" Badge="@Roster">
    <div class="cx-roster">
        @foreach (var hero in Store.Vocabulary.Heroes.OrderBy(h => h.Name, StringComparer.OrdinalIgnoreCase))
        {
            <a href="/browse?type=@ItemSlug&hero=@Uri.EscapeDataString(hero.Name)"
               style="color:@(Ui.HeroColour(hero.Name) ?? "var(--muted)")">
                <span class="cx-pip" style="background:@(Ui.HeroSwatch(hero.Name) ?? "var(--muted)")"></span>
                <span class="cx-who">@hero.Name</span>
                <span class="cx-code">@hero.ArmorType &middot; @hero.PrimaryStat</span>
            </a>
        }
    </div>
</Panel>

@foreach (var group in Ui.Codex.Menu)
{
    <Panel Head="@group.Label">
        <div class="cx-cards">
            @foreach (var entry in group.Entries)
            {
                <a class="cx-card" href="/browse@(entry.Query)">
                    <span class="cx-card-name">@entry.Label</span><br />
                    <span class="cx-card-count">@entry.Count.ToString("N0") entities</span>
                    @if (entry.Sections.Count > 0)
                    {
                        <ul class="cx-card-links">
                            @foreach (var link in entry.Sections[0].Links.Take(8))
                            {
                                <li>@link.Label</li>
                            }
                        </ul>
                    }
                </a>
            }
        </div>
    </Panel>
}

@if (Showcase.Count > 0)
{
    <Panel Head="A sample of what is in there">
        <div class="cx-cards">
            @foreach (var entity in Showcase)
            {
                <EntityLink Entity="entity" Class="cx-card" Tint="false">
                    <span class="cx-linked">
                        <Icon Src="@Ui.Icon(DocumentFields.Text(entity, nameof(Item.Icon)))" />
                        <span>
                            <span class="cx-card-name" style="color:@Ui.NameColour(entity)">@PublicTypes.NameOf(entity)</span><br />
                            <span class="cx-card-count">@Codex.Label(EntityTypes.TypeOf(entity))</span>
                        </span>
                    </span>
                </EntityLink>
            }
        </div>
    </Panel>
}

@code {
    private int Entries => Ui.Codex.Count;

    /// <summary>The roster's badge, which counts heroes rather than entries.</summary>
    private string Roster => $"{Store.Vocabulary.Heroes.Count} heroes";

    private static readonly string ItemSlug = EntityTypes.Slug(EntityType.Item);

    /// <summary>
    /// A sample row of each type, richest first. Every row the extractor writes is one a reader can
    /// meet - the drop rules already keep the rest out of the export - so there is no narrower
    /// "public" test left to run, unlike the flat model's own table check.
    ///
    /// "Richest" is a description's length alone: the flat model's own scoring also weighted a row's
    /// shipped tuning-knob count, which no document class carries any more.
    /// </summary>
    private IReadOnlyList<EntityDocument> Showcase =>
    [
        .. Store.Entities
            .Where(e => PublicTypes.DisplayNameOf(e) is not null &&
                DocumentFields.Text(e, nameof(Item.Icon)) is not null &&
                DocumentFields.Text(e, nameof(Ability.Description)) is not null)
            .GroupBy(EntityTypes.TypeOf)
            .SelectMany(group => group
                .OrderByDescending(e => DocumentFields.Text(e, nameof(Ability.Description))?.Length ?? 0)
                .Take(2))
            .OrderBy(e => Codex.Label(EntityTypes.TypeOf(e)), StringComparer.OrdinalIgnoreCase)
            .ThenBy(e => PublicTypes.NameOf(e), StringComparer.OrdinalIgnoreCase)
            .Take(8),
    ];
}
