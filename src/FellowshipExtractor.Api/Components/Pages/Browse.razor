@page "/browse"
@inject Codex Catalog
@inject CodexSearch Search
@inject CodexView Ui
@inject NavigationManager Nav

<PageTitle>@Heading - Fellowship Codex</PageTitle>

<Crumbs Trail="@(new List<(string, string?)> { (Heading, null) })" />

<h1>@Heading</h1>

@if (Error is { } error)
{
    <Panel>
        <Empty Said="That filter could not be read.">@error</Empty>
    </Panel>
}
else
{
    <div class="cx-tabs">
        @{
            var across = Results.AcrossTypes.ToString("N0");
        }
        <a class="cx-tab" href="@View.Replace("type", null)"
           aria-current="@(Query.Types.Count == 0 ? "page" : null)">
            All <CountBadge Text="@across" />
        </a>
        @foreach (var type in Catalog.Types.Where(t => Results.Types.ContainsKey(t.Type) || Query.ChosenType(t.Type)))
        {
            var counted = Results.Types.GetValueOrDefault(type.Type).ToString("N0");

            <a class="cx-tab" href="@View.Replace("type", type.Slug)"
               aria-current="@(Query.ChosenType(type.Type) ? "page" : null)">
                @type.Label <CountBadge Text="@counted" />
            </a>
        }
    </div>

    <div class="cx-browse">
        <Panel As="aside" Class="cx-rail" Aria="Filters" Head="Refine">
            @if (View.Chosen.Count > 0)
            {
                <ul class="cx-chosen">
                    @foreach (var (label, href) in View.Chosen)
                    {
                        <li><a href="@href" title="Remove this filter">@label</a></li>
                    }
                    <li class="cx-clear-all"><a href="@View.Bare">clear all</a></li>
                </ul>
            }

            <details class="cx-facet" open>
                <summary>Group results by</summary>
                <ul class="cx-facet-values">
                    <li>
                        <a href="@View.Replace("group", null)" class="@BrowseView.On(Query.Group is null)">Nothing</a>
                    </li>
                    @foreach (var facet in View.Rail)
                    {
                        var grouping = string.Equals(Query.Group, facet.Key, StringComparison.OrdinalIgnoreCase);
                        <li>
                            <a href="@View.Replace("group", facet.Key)" class="@BrowseView.On(grouping)">@facet.Label</a>
                        </li>
                    }
                </ul>
            </details>

            @foreach (var facet in View.Rail)
            {
                <details class="cx-facet" open="@(Query.Selections.ContainsKey(facet.Key) || facet.Values.Count <= 8)">
                    <summary>@facet.Label</summary>
                    <ul class="cx-facet-values">
                        @foreach (var value in facet.Values)
                        {
                            var chosen = Query.Chosen(facet.Key, value.Value);
                            var counted = value.Count.ToString("N0");

                            <li>
                                <a href="@View.Toggle(facet.Key, value.Value)" class="@BrowseView.On(chosen)"
                                   style="@(chosen || value.Colour is null ? null : $"color:{value.Colour}")">
                                    @value.Label <CountBadge Text="@counted" />
                                </a>
                            </li>
                        }
                    </ul>
                </details>
            }

            @if (View.Ranges.Count > 0)
            {
                <details class="cx-facet" open="@(Query.Ranges.Count > 0)">
                    <summary>Between</summary>
                    <form class="cx-ranges" method="get" action="/browse">
                        @foreach (var (name, value) in Query.Fields())
                        {
                            <input type="hidden" name="@name" value="@value" />
                        }
                        @foreach (var measure in View.Ranges)
                        {
                            <div class="cx-range">
                                <span>@measure.Label@(measure.Unit is null ? null : $" ({measure.Unit})")</span>
                                <input type="number" step="any" name="@(measure.Key)Min" placeholder="min"
                                       value="@(Query.Bound(measure.Key, false) is { } low ? Codex.Number(low) : null)" />
                                <input type="number" step="any" name="@(measure.Key)Max" placeholder="max"
                                       value="@(Query.Bound(measure.Key, true) is { } high ? Codex.Number(high) : null)" />
                            </div>
                        }
                        <button type="submit">Apply</button>
                    </form>
                </details>
            }

            <details class="cx-facet" open>
                <summary>Only rows that</summary>
                <ul class="cx-facet-values">
                    @foreach (var flag in Catalog.Flags)
                    {
                        var state = Query.Flags.TryGetValue(flag.Key, out var wanted) ? wanted : (bool?)null;
                        var next = state is null ? "1" : state.Value ? "0" : null;
                        <li>
                            <a href="@View.Replace(flag.Key, next)" class="@BrowseView.On(state is not null)">
                                @(state == false ? "Not: " : null)@flag.Label
                            </a>
                        </li>
                    }
                </ul>
            </details>
        </Panel>

        <section>
            <div class="cx-results-head">
                <span class="cx-count">
                    <b>@Results.Total.ToString("N0")</b> @(Results.Total == 1 ? "entity" : "entities")
                    @if (Results.Pages > 1)
                    {
                        <span>&middot; page @Results.Page of @Results.Pages</span>
                    }
                </span>
                @if (Grouping is { } grouped)
                {
                    <span>grouped by @grouped.Label</span>
                }
            </div>

            @if (Results.Rows.Count == 0)
            {
                <Panel>
                    <Empty Said="Nothing in the build answers that.">
                        @(Query.IsEmpty
                            ? "Pick a category from the menus above, or type a name into the search box."
                            : "Remove a filter and try again.")
                    </Empty>
                </Panel>
            }
            else
            {
                <div class="cx-table-scroll">
                    <table class="cx-rows">
                        <thead>
                            <tr>
                                <th class="cx-art"></th>
                                <th aria-sort="@View.SortState("name")"><a href="@View.SortLink("name")">Name</a></th>
                                <th aria-sort="@View.SortState("type")"><a href="@View.SortLink("type")">Type</a></th>
                                @if (ShowSlot) { <th>Slot</th> }
                                @if (ShowWorn) { <th>Worn by</th> }
                                @if (ShowSchools) { <th>School</th> }
                                @foreach (var measure in Columns)
                                {
                                    <th class="cx-numeric" aria-sort="@View.SortState(measure.Key)">
                                        <a href="@View.SortLink(measure.Key)">@measure.Label</a>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{ string? lastGroup = null; }
                            @foreach (var row in Results.Rows)
                            {
                                if (Grouping is { } group)
                                {
                                    var value = group.Values(row).FirstOrDefault();
                                    if (value != lastGroup)
                                    {
                                        lastGroup = value;
                                        <tr class="cx-group-head">
                                            <td colspan="12">@(value is null ? "Carries none" : Catalog.Printed(group, value))</td>
                                        </tr>
                                    }
                                }

                                <tr>
                                    @{ var item = row as ItemDocument; }
                                    <td class="cx-art"><Icon Src="@Ui.Icon(DocumentFields.Text(row, nameof(ItemDocument.Icon)))" /></td>
                                    <td><EntityLink Entity="row" Class="cx-nm" /></td>
                                    <td>@Codex.Label(EntityTypes.TypeOf(row))</td>
                                    @if (ShowSlot)
                                    {
                                        <td>@item?.Slot</td>
                                    }
                                    @if (ShowWorn)
                                    {
                                        <td>
                                            @if (item?.ArmorType is { } armor)
                                            {
                                                <Chip>@armor</Chip>
                                            }
                                            @if (item?.PrimaryStat is { } stat)
                                            {
                                                <Chip>@stat</Chip>
                                            }
                                            @foreach (var hero in (item?.Heroes ?? []).Take(3))
                                            {
                                                <Chip Colour="@Ui.HeroColour(hero.ToString())">@hero</Chip>
                                            }
                                            @if (item?.Heroes is { Count: > 3 } heroes)
                                            {
                                                <Chip>+@(heroes.Count - 3)</Chip>
                                            }
                                        </td>
                                    }
                                    @if (ShowSchools)
                                    {
                                        <td class="cx-tags">
                                            @foreach (var school in Codex.Schools(row))
                                            {
                                                <Chip>@school</Chip>
                                            }
                                        </td>
                                    }
                                    @foreach (var measure in Columns)
                                    {
                                        <td class="cx-numeric">
                                            @if (measure.Value(row) is { } number)
                                            {
                                                @Codex.Number(number)<span class="cx-unit">@measure.Unit</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Results.Pages > 1)
                {
                    <nav class="cx-pager" aria-label="Pagination">
                        @if (Results.Page > 1)
                        {
                            <a href="@View.PageLink(1)">&laquo; First</a>
                            <a href="@View.PageLink(Results.Page - 1)">&lsaquo; Prev</a>
                        }
                        @foreach (var number in BrowseView.Window(Results.Page, Results.Pages))
                        {
                            if (number < 0)
                            {
                                <span class="cx-gap">&hellip;</span>
                            }
                            else if (number == Results.Page)
                            {
                                <span aria-current="page">@number</span>
                            }
                            else
                            {
                                <a href="@View.PageLink(number)">@number</a>
                            }
                        }
                        @if (Results.Page < Results.Pages)
                        {
                            <a href="@View.PageLink(Results.Page + 1)">Next &rsaquo;</a>
                            <a href="@View.PageLink(Results.Pages)">Last &raquo;</a>
                        }
                    </nav>
                }
            }
        </section>
    </div>
}

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }

    private CodexQuery Query = new();

    private CodexResults Results = new(0, 1, 1, [], [], new Dictionary<EntityType, int>(), 0, []);

    private BrowseView View = default!;

    private string? Error;

    private string Heading =>
        Query.Text is { } typed
            ? $"Search results for “{typed}”"
            : Query.Types.Count == 1
                ? Codex.Label(Query.Types[0])
                : "Browse the codex";

    private Facet? Grouping => Query.Group is null ? null : Catalog.Facet(Query.Group);

    private IReadOnlyList<Measure> Columns => View.Columns;

    private bool ShowSlot => Results.Rows.Any(r => (r as ItemDocument)?.Slot is not null);

    private bool ShowWorn =>
        Results.Rows.Any(r => r is ItemDocument { ArmorType: not null } or ItemDocument { PrimaryStat: not null } or
            ItemDocument { Heroes: { Count: > 0 } });

    private bool ShowSchools => Results.Rows.Any(r => Codex.Schools(r).Any());

    protected override void OnParametersSet()
    {
        var asked = Http?.Request.Query ?? Microsoft.AspNetCore.Http.QueryCollection.Empty;

        Query = CodexQuery.Parse(asked, Catalog, out Error);

        if (Error is null && asked.Any(p => p.Value.All(string.IsNullOrEmpty)))
        {
            Nav.NavigateTo("/browse" + Query.ToQueryString(), replace: true);
            return;
        }

        if (Error is null) Results = Search.Run(Query);

        View = new BrowseView(Catalog, Query, Results);
    }
}
