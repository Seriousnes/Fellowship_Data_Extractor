@inject TooltipView Ui

<div class="grp">
    @if ((Entity.ArmorType ?? Entity.GemType) is { } kind)
    {
        <p class="kind">@kind</p>
    }
    @if (Entity.Slot is not null || Level is not null)
    {
        <div class="row">
            @if (Entity.Slot is { } slot)
            {
                <span><img class="gi" alt="" src="@Ui.Chrome.SlotGlyph">@slot</span>
            }
            @if (Level is { } power)
            {
                <span><img class="gi" alt="" src="@Ui.Chrome.ItemPowerGlyph"><span class="power">@power</span></span>
            }
        </div>
    }
    @if (Rung is not null || Temper is not null)
    {
        <div class="row">
            @if (Rung is { } rung)
            {
                <span><span class="rar">@Ui.Rung(Entity, rung)</span></span>
            }
            @if (Temper is { } tempered)
            {
                <span>@tempered</span>
            }
        </div>
    }
    @if (Entity.GemSlot == true || Entity.UniqueEquipped == true)
    {
        <div class="row">
            @if (Entity.GemSlot == true)
            {
                <span><span class="k">@(Query.NoSocket ? "No gem socket" : "Gem socket")</span></span>
            }
            @if (Entity.UniqueEquipped == true)
            {
                <span><span class="k">Unique Equipped</span></span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Entity Entity { get; set; } = new();

    [Parameter] public TooltipQuery Query { get; set; } = new();

    [Parameter] public RarityEntry? Rung { get; set; }

    [Parameter] public int? Level { get; set; }

    [Parameter] public string? Temper { get; set; }
}
