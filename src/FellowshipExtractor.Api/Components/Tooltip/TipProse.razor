@inject TooltipView Ui

<div class="grp">
    @if (Entity.Description is { } description)
    {
        <p class="desc">@Ui.Text(description, Entity.Placeholders, Query, Hero, Entity.Tags)</p>
    }
    @foreach (var detail in Entity.Detail ?? [])
    {
        <p class="note">@Ui.Text(detail, Entity.Placeholders, Query, Hero, Entity.Tags)</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public Entity Entity { get; set; } = new();

    [Parameter] public TooltipQuery Query { get; set; } = new();

    [Parameter] public HeroEntry? Hero { get; set; }
}
