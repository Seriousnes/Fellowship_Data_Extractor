@inject TooltipView Ui

<div class="grp">
    <div class="sec"><img class="gi" alt="" src="@Ui.Chrome.TraitGlyph"><span>Imbued Traits</span>@if (Allocated is not null || Total is not null)
        {<span class="n">(<span class="alloc">@(Allocated ?? 0)</span>@(Total is { } total ? "/" + total : null))</span>}</div>
    @foreach (var line in Lines)
    {
        <div class="row"><span><img class="gi" alt="" src="@Ui.Chrome.ExpandGlyph"><span class="trait">Trait: @line.Name +@line.Rank</span></span></div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<TooltipView.TraitLine> Lines { get; set; } = [];

    [Parameter] public int? Allocated { get; set; }

    [Parameter] public int? Total { get; set; }
}
