@inject TooltipView Ui

@if (Entity.SetBonus is { Count: > 0 } sets)
{
    <div class="grp">
        <div class="sec setbonus"><img class="gi" alt="" src="@Ui.Chrome.SetBonusBadge.Url"><span>Set Bonus</span>@if (Entity.SetCount is { } pieces)
            {<span class="n">(@pieces pieces)</span>}</div>
        <p class="desc">@string.Join(", ", sets)</p>
    </div>
}

@code {
    [Parameter, EditorRequired] public Entity Entity { get; set; } = new();
}
