@* The scalars the row states - cast, cooldown, range, cost - two to a row in the order the game
   prints them, with an odd one left alone on the last row. *@
<div class="grp">
    @for (var at = 0; at < Items.Count; at += 2)
    {
        <div class="row">
            <span><span class="k">@Items[at].Label</span><span class="v" title="@Items[at].Title">@Items[at].Value</span></span>
            @if (at + 1 < Items.Count)
            {
                <span><span class="k">@Items[at + 1].Label</span><span class="v" title="@Items[at + 1].Title">@Items[at + 1].Value</span></span>
            }
        </div>
    }
</div>

@code {
    /// <summary>
    /// The scalars, already formatted and already carrying the arithmetic behind any number this
    /// app worked out rather than read.
    /// </summary>
    [Parameter] public IReadOnlyList<TooltipView.Fact> Items { get; set; } = [];
}
