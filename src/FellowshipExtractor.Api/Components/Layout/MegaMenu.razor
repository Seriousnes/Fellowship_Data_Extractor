@inject ICodexViewService Ui

<nav class="cx-mega" aria-label="Categories">
    <ul class="cx-mega-bar">
        @foreach (var group in Ui.Codex.Menu)
        {
            <li class="cx-mega-group">
                <button type="button" class="cx-mega-open" aria-expanded="false">@group.Label</button>

                <div class="cx-mega-panel">
                    <div class="cx-mega-cols">
                        @foreach (var entry in group.Entries)
                        {
                            var entered = entry.Count.ToString("N0");

                            <a class="cx-mega-head" href="/browse@(entry.Query)">
                                @entry.Label <CountBadge Text="@entered" />
                            </a>

                            @foreach (var part in entry.Sections)
                            {
                                <div class="cx-mega-sec">
                                    <p class="cx-mega-sec-head">@part.Label</p>
                                    <ul>
                                        @foreach (var link in part.Links)
                                        {
                                            var linked = link.Count.ToString("N0");

                                            <li>
                                                <a href="/browse@(link.Query)"
                                                   style="@(link.Colour is null ? null : $"color:{link.Colour}")">
                                                    @link.Label <CountBadge Text="@linked" />
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                    </div>
                </div>
            </li>
        }
    </ul>
</nav>
