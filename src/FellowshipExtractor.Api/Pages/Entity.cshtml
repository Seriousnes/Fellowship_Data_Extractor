@page "/entity/{table}/{netId:int}"
@model EntityModel
@inject CodexView Ui
@{
    var entity = Model.Entity;
    var name = Ui.Name(entity);
    var type = Model.Codex.Types.FirstOrDefault(t => t.Table == entity.Table);

    ViewData["Title"] = name;
    ViewData["Breadcrumb"] = new List<(string Label, string? Href)>
    {
        (Codex.Label(Model.Table), $"/browse?type={Uri.EscapeDataString(Model.Table)}"),
        (name, null),
    };

    var isGem = entity.GemTier is not null;
    var wearable = entity.Stats is { Count: > 0 };
    var chosenHero = Model.Resolved;
    var picksHero = Model.Readings.Count > 1 || entity.Heroes is { Count: > 1 };
    var hasKnobs = picksHero || wearable || isGem;
}

<h1 style="color:@Ui.NameColour(entity)">@name</h1>

<div class="entity">
    <div class="entity-top">
        <div class="entity-tip"
             data-tooltip-for="/api/tooltip/@Uri.EscapeDataString(Model.Table)/@Model.NetId"
             aria-live="polite">
            <p class="empty">Drawing the tooltip&hellip;</p>
        </div>

        <div class="entity-side">
        @if (hasKnobs)
        {
        <div class="entity-knobs panel">
            <div class="panel-head">Read it as</div>

            @if (Model.Readings.Count > 1)
            {
                <p class="card-count">
                    This id reads as @Model.Readings.Count different things. A hero settles it, because a
                    hero fixes both the armour type and the primary stat at once.
                </p>
            }

            @if (picksHero)
            {
                <label class="knob">
                    <span>Hero</span>
                    <select data-tooltip-knob="hero"
                            onchange="location.search = '?hero=' + encodeURIComponent(this.value)">
                        @if (Model.Readings.Count == 1)
                        {
                            <option value="">Any</option>
                        }
                        @foreach (var hero in Ui.Store.Vocabulary.Heroes
                            .Where(h => Model.Readings.Any(r => r.Heroes is null || r.Heroes.Contains(h.Name)))
                            .OrderBy(h => h.Name, StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="@hero.Name" selected="@(hero.Name == chosenHero)">
                                @hero.Name (@hero.ArmorType, @hero.PrimaryStat)
                            </option>
                        }
                    </select>
                </label>
            }

            @if (wearable || isGem)
            {
                <div class="knob">
                    <span>Rarity</span>
                    <div class="rungs">
                        @foreach (var rung in Ui.Store.Vocabulary.Rarities)
                        {
                            var colour = CodexView.Readable(Ui.Tokens.Rarity(rung.Name));
                            <button type="button" data-tooltip-knob="rarity" data-choice="@rung.Tier"
                                    aria-pressed="false" style="@(colour is null ? null : $"color:{colour}")">
                                @(isGem ? rung.GemDisplayName : rung.DisplayName)
                            </button>
                        }
                    </div>
                </div>
            }

            @if (wearable)
            {
                <label class="knob">
                    <span>Item level</span>
                    <input type="number" min="1" max="1000" step="1"
                           value="@StatMagnitudes.MaximumItemLevel" data-tooltip-knob="itemLevel">
                </label>

                <label class="knob">
                    <span>Tempered</span>
                    <input type="number" min="0" max="20" step="1" placeholder="none" data-tooltip-knob="upgrades">
                </label>
            }

        </div>
        }

    <div class="panel">
        <div class="panel-head">Identity</div>
        <table class="facts">
            <tr><th>Gameplay tag</th><td>@entity.Name</td></tr>
            <tr>
                <th>Table</th>
                <td><a href="/browse?type=@Uri.EscapeDataString(Model.Table)">@Codex.Label(Model.Table)</a></td>
            </tr>
            <tr><th>Network id</th><td>@Model.NetId</td></tr>
            <tr>
                <th>Readings of this id</th>
                <td>@Model.Readings.Count@(type is null ? "" : $" of {type.Count:N0} in the table")</td>
            </tr>
            <tr>
                <th>Tooltip</th>
                <td>
                    <a href="/api/tooltip/@Uri.EscapeDataString(Model.Table)/@Model.NetId">
                        /api/tooltip/@Model.Table/@Model.NetId
                    </a>
                </td>
            </tr>
        </table>

        @if (Model.Readings.Count > 1)
        {
            <hr class="rule">
            <p class="mega-sec-head">Every reading</p>
            <ul class="pills">
                @foreach (var reading in Model.Readings)
                {
                    // The reading is addressed by a hero rather than by its position, because the
                    // hero is what the tooltip API takes and what the page is read as. A reading no
                    // hero selects is still listed, and links to the page as it stands.
                    var who = Ui.Store.Vocabulary.Heroes
                        .FirstOrDefault(h => (reading.Heroes is null || reading.Heroes.Contains(h.Name)) &&
                            (reading.ArmorType is null || reading.ArmorType == h.ArmorType) &&
                            (reading.PrimaryStat is null || reading.PrimaryStat == h.PrimaryStat));
                    var where = who is null ? "?" : "?hero=" + Uri.EscapeDataString(who.Name);
                    var tone = reading == entity ? "color:var(--gold-bright)" : null;
                    <li>
                        <a href="@where" style="@tone">
                            @Ui.Name(reading)
                            <span class="n">@(reading.ArmorType ?? "any") / @(reading.PrimaryStat ?? "any")</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
        </div>
    </div>

    @await Html.PartialAsync("_Detail", entity)

    @if (Model.Related.Count > 0)
    {
        <div class="panel">
            <div class="panel-head">More like this</div>
            <ul class="pills">
                @foreach (var (label, href, count) in Model.Related)
                {
                    <li><a href="@href">@label <span class="n">@count.ToString("N0")</span></a></li>
                }
            </ul>
        </div>
    }

    <details class="panel raw-record">
        <summary class="panel-head">The exported record</summary>
        <pre class="raw">@System.Text.Json.JsonSerializer.Serialize(entity, new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true,
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
            DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull,
        })</pre>
    </details>
</div>
