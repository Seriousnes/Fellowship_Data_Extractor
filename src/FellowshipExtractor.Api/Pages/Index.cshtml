@page
@model IndexModel
@inject CodexView Ui
@{
    ViewData["Title"] = null;
}

<section class="hero-band">
    <h1>The Fellowship Codex</h1>
    <p>
        @Model.Store.Count.ToString("N0") entities read straight out of the shipped build - every item,
        ability, effect, talent, trait and creature the game files under a gameplay tag, with the art,
        the tuning numbers and the tooltip the client draws from them.
    </p>
</section>

<div class="panel">
    <div class="panel-head">The roster <span class="n">@Model.Store.Vocabulary.Heroes.Count heroes</span></div>
    <div class="roster">
        @foreach (var hero in Model.Store.Vocabulary.Heroes.OrderBy(h => h.Name, StringComparer.OrdinalIgnoreCase))
        {
            var colour = Ui.HeroColour(hero.Name) ?? "var(--muted)";
            var swatch = Ui.HeroSwatch(hero.Name) ?? "var(--muted)";
            <a href="/browse?type=ItemID&hero=@Uri.EscapeDataString(hero.Name)" style="color:@colour">
                <span class="pip" style="background:@swatch"></span>
                <span class="who">@hero.Name</span>
                <span class="code">@hero.Codename &middot; @hero.ArmorType &middot; @hero.PrimaryStat</span>
            </a>
        }
    </div>
</div>

@foreach (var group in Model.Codex.Menu)
{
    <div class="panel">
        <div class="panel-head">@group.Label</div>
        <div class="cards">
            @foreach (var entry in group.Entries)
            {
                <a class="card" href="/browse@(entry.Query)">
                    <span class="card-name">@entry.Label</span><br>
                    <span class="card-count">@entry.Count.ToString("N0") entities</span>
                    @if (entry.Sections.Count > 0)
                    {
                        <ul class="card-links">
                            @foreach (var link in entry.Sections[0].Links.Take(8))
                            {
                                <li>@link.Label</li>
                            }
                        </ul>
                    }
                </a>
            }
        </div>
    </div>
}

@if (Model.Showcase.Count > 0)
{
    <div class="panel">
        <div class="panel-head">A sample of what is in there</div>
        <div class="cards">
            @foreach (var entity in Model.Showcase)
            {
                <a class="card" href="@Ui.Href(entity)">
                    <span class="linked">
                        <img alt="" loading="lazy" src="@Ui.Icon(entity.Icon)">
                        <span>
                            <span class="card-name" style="color:@Ui.NameColour(entity)">@Ui.Name(entity)</span><br>
                            <span class="card-count">@Codex.Label(entity.Table!)</span>
                        </span>
                    </span>
                </a>
            }
        </div>
    </div>
}
