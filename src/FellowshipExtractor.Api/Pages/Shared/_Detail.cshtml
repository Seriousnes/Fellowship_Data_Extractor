@model FellowshipExtractor.Tooltip.Entity
@inject CodexView Ui
@{
    var facts = Ui.Facts(Model);
    var uncovered = Ui.Uncovered(Model);
}

@if (Model.Description is not null || Model.Detail is { Count: > 0 })
{
    <div class="panel">
        <div class="panel-head">Text</div>
        @if (Model.Description is not null)
        {
            <p class="prose">@Ui.Text(Model.Description, Model.Placeholders, Model.Tags)</p>
        }
        @foreach (var line in Model.Detail ?? [])
        {
            <hr class="rule">
            <p class="prose">@Ui.Text(line, Model.Placeholders, Model.Tags)</p>
        }
    </div>
}

@if (facts.Count > 0 || Model.Tags is { Count: > 0 } || Model.Heroes is { Count: > 0 } ||
     Model.SetBonus is { Count: > 0 } || Model.ScalesOff is { Count: > 0 } ||
     Model.AllowedRoles is { Count: > 0 } || Model.AllowedAttributes is { Count: > 0 })
{
    <div class="panel">
        <div class="panel-head">Details</div>

        @if (facts.Count > 0)
        {
            <div class="pairs">
                <table class="facts">
                    @foreach (var (label, value, unit, href) in facts.Take((facts.Count + 1) / 2))
                    {
                        <tr>
                            <th>@label</th>
                            <td>
                                @if (href is null)
                                {
                                    @value
                                }
                                else
                                {
                                    <a href="@href">@value</a>
                                }
                                <span class="unit">@unit</span>
                            </td>
                        </tr>
                    }
                </table>
                <table class="facts">
                    @foreach (var (label, value, unit, href) in facts.Skip((facts.Count + 1) / 2))
                    {
                        <tr>
                            <th>@label</th>
                            <td>
                                @if (href is null)
                                {
                                    @value
                                }
                                else
                                {
                                    <a href="@href">@value</a>
                                }
                                <span class="unit">@unit</span>
                            </td>
                        </tr>
                    }
                </table>
            </div>
        }

        @if (Model.Tags is { Count: > 0 } tags)
        {
            <hr class="rule">
            <p class="mega-sec-head">Tags</p>
            <ul class="pills">
                @foreach (var tag in tags)
                {
                    var facet = tag.StartsWith("Magic", StringComparison.Ordinal) ||
                                tag.StartsWith("Physical", StringComparison.Ordinal) ? "school" : "tag";
                    var where = $"/browse?type={Uri.EscapeDataString(Model.Table ?? string.Empty)}" +
                                $"&{facet}={Uri.EscapeDataString(tag)}";
                    <li><a href="@where">@Codex.Spaced(tag)</a></li>
                }
            </ul>
        }

        @if (Model.Heroes is { Count: > 0 } heroes)
        {
            <hr class="rule">
            <p class="mega-sec-head">Heroes</p>
            <ul class="pills">
                @foreach (var hero in heroes)
                {
                    var tone = Ui.HeroColour(hero);
                    <li>
                        <a href="/browse?hero=@Uri.EscapeDataString(hero)" style="@(tone is null ? null : $"color:{tone}")">@hero</a>
                    </li>
                }
            </ul>
        }

        @if (Model.SetBonus is { Count: > 0 } sets)
        {
            <hr class="rule">
            <p class="mega-sec-head">Set@(Model.SetCount is { } pieces ? $" ({pieces} pieces)" : "")</p>
            <ul class="pills">
                @foreach (var set in sets)
                {
                    <li><a href="/browse?set=@Uri.EscapeDataString(set)">@set</a></li>
                }
            </ul>
        }

        @if (Model.ScalesOff is { Count: > 0 } scaling)
        {
            <hr class="rule">
            <p class="mega-sec-head">Scales off</p>
            <ul class="pills">
                @foreach (var stat in scaling)
                {
                    <li><span>@Codex.Spaced(stat)</span></li>
                }
            </ul>
        }

        @if (Model.AllowedRoles is { Count: > 0 } roles)
        {
            <hr class="rule">
            <p class="mega-sec-head">Offered to</p>
            <ul class="pills">
                @foreach (var role in roles)
                {
                    <li><span style="color:@(Ui.Tokens.Role(role) ?? "inherit")">@role</span></li>
                }
                @foreach (var stat in Model.AllowedAttributes ?? [])
                {
                    <li><span>@stat</span></li>
                }
            </ul>
        }
    </div>
}

@if (Model.Stats is { Count: > 0 } slots)
{
    <div class="panel">
        <div class="panel-head">
            Stat slots <span class="n">@slots.Count</span>
        </div>
        <p class="card-count">
            A slot's weight is its share of the item's stat budget. The magnitude is not in the build:
            a dynamic item rolls it from its level and rarity when it drops, which is what the tooltip
            above computes.
        </p>
        <ul class="stat-lines">
            @foreach (var slot in slots)
            {
                <li class="@(Ui.Store.PrimaryAttributes.Contains(slot.Stat) || slot.Stat == "Stamina" ? "primary" : "secondary")">
                    <span>@Codex.Spaced(slot.Stat)</span>
                    <span class="w">@slot.Kind &middot; weight @slot.Weight</span>
                </li>
            }
        </ul>
    </div>
}

@if (Model.Placeholders is { Count: > 0 } tokens)
{
    <div class="panel">
        <div class="panel-head">Substitutions <span class="n">@tokens.Count</span></div>
        <p class="card-count">
            What each <code>{Token}</code> in the text above resolves to. A coefficient is multiplied by
            the attribute it names; a spread is the total width of the band the roll lands in, so the
            printed range is the mean less and plus half of it.
        </p>
        @foreach (var (name, token) in tokens.OrderBy(t => t.Key, StringComparer.OrdinalIgnoreCase))
        {
            <div class="token">
                <span class="token-name">{@name}</span>
                <div class="token-read">
                    @if (token.Text is { } word)
                    {
                        @word
                    }
                    else if (token.Coefficient is { } coefficient)
                    {
                        @Codex.Number(coefficient * 100)<text>% </text>
                        @(token.Attribute is { } attribute ? "of " + Codex.Spaced(attribute) : "of the captured attribute")
                    }
                    else if (token.Value is { } value)
                    {
                        @Codex.Number(value)@(token.Percent == true ? "%" : "")<text> </text>@token.Unit
                    }
                    else if (token.FromOwnConstants == true)
                    {
                        <span class="miss">worked out by native code from this entity's own tuning</span>
                    }
                    else
                    {
                        <span class="miss">nothing in the build resolves this token</span>
                    }
                </div>
                <div class="token-work">
                    @if (token.Spread is { } spread)
                    {
                        <text>spread @Codex.Number(spread) (@Codex.Number(100 - spread * 50)% to @Codex.Number(100 + spread * 50)% of the mean) &middot; </text>
                    }
                    @if (token.Format is { } format)
                    {
                        <text>printed as @format &middot; </text>
                    }
                    @if (token.ShowDamageType == true)
                    {
                        <text>speaks its damage school &middot; </text>
                    }
                    @if (token.ScalesOff is { Count: > 0 } scaling)
                    {
                        <text>scales off @string.Join(", ", scaling)</text>
                    }
                </div>
                @if (token.Constants is { Count: > 0 } constants)
                {
                    <ul class="kv">
                        @foreach (var (key, value) in constants)
                        {
                            <li>
                                <span class="k">@key</span>
                                <span class="v @(value is null ? "miss" : null)">@CodexView.Constant(value)</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        }
    </div>
}

@if (Model.Constants is { Count: > 0 } rows)
{
    <div class="panel">
        <div class="panel-head">Tuning rows <span class="n">@rows.Count</span></div>
        <p class="card-count">
            Every shipped tuning value this entity reaches that is not already a field above, under its
            row name with the entity's own namespace stripped.
        </p>
        <ul class="kv">
            @foreach (var (key, value) in rows)
            {
                <li>
                    <span class="k">@key</span>
                    <span class="v @(value is null ? "miss" : null)">@CodexView.Constant(value)</span>
                </li>
            }
        </ul>
    </div>
}

@if (Model.Talents is { Count: > 0 } talents)
{
    <div class="panel">
        <div class="panel-head">Talent-named rows <span class="n">@talents.Count</span></div>
        <p class="card-count">
            Tuning rows whose names name a talent. The name is all this says: a row named for a talent
            is very often unconditional, because a talent folded back into its ability leaves its name
            behind in the row. Where the asset declares a condition it is listed as a gate.
        </p>
        @foreach (var (talent, values) in talents.OrderBy(t => t.Key, StringComparer.OrdinalIgnoreCase))
        {
            <hr class="rule">
            <p class="mega-sec-head">
                @Codex.Spaced(talent)
                @if (Model.TalentGates?.TryGetValue(talent, out var gate) == true)
                {
                    <span class="n">gated on @gate</span>
                }
            </p>
            <ul class="kv">
                @foreach (var (key, value) in values)
                {
                    <li>
                        <span class="k">@key</span>
                        <span class="v @(value is null ? "miss" : null)">@CodexView.Constant(value)</span>
                    </li>
                }
            </ul>
        }
    </div>
}

@if (Model.RankRuns is { Count: > 0 } runs)
{
    <div class="panel">
        <div class="panel-head">Rank progression <span class="n">@runs.Count</span></div>
        <p class="card-count">
            The slash-separated numbers the description prints, matched to the shipped curve row behind
            them. The printed column is what the game shows; the values are what it computes with.
        </p>
        @foreach (var run in runs)
        {
            <hr class="rule">
            <ul class="kv">
                @* The literal is the exact substring of the description the run covers, markup and
                   all, so that printing one rank is a plain Replace. It is shown as it stands
                   rather than rendered, because what it is for is being matched character for
                   character. *@
                <li><span class="k">In the text</span><span class="v"><code>@run.Literal</code></span></li>
                <li>
                    <span class="k">Printed</span>
                    <span class="v prose">
                        @for (var rank = 0; rank < run.Printed.Count; rank++)
                        {
                            @if (rank > 0)
                            {
                                <text> / </text>
                            }
                            @Ui.Text(run.Printed[rank], null, Model.Tags)
                        }
                    </span>
                </li>
                @if (run.Values is { Count: > 0 })
                {
                    <li>
                        <span class="k">Shipped values</span>
                        <span class="v">@string.Join(" / ", run.Values.Select(v => v is null ? "—" : Codex.Number(v.Value)))</span>
                    </li>
                }
                @if (run.Key is not null)
                {
                    <li><span class="k">Tuning row</span><span class="v">@run.Key</span></li>
                }
                @if (run.Transform is not null)
                {
                    <li>
                        <span class="k">Arithmetic</span>
                        <span class="v">@run.Transform@(run.Ticks is { } ticks ? $" over {ticks} ticks" : "")</span>
                    </li>
                }
                @if (run.Disagrees == true)
                {
                    <li><span class="k">Note</span><span class="v miss">printed and computed values disagree</span></li>
                }
            </ul>
        }
    </div>
}

@if (Model.GemOverflow is { } overflow)
{
    <div class="panel">
        <div class="panel-head">Past max power</div>
        <p class="prose">@Ui.Text(overflow.Description, overflow.Placeholders, Model.Tags)</p>
    </div>
}

@if (Model.GrantedTags is { Count: > 0 } granted)
{
    <div class="panel">
        <div class="panel-head">Grants tags <span class="n">@granted.Count</span></div>
        <ul class="pills">
            @foreach (var tag in granted)
            {
                <li><span>@tag</span></li>
            }
        </ul>
    </div>
}

@if (Model.IconInheritedFrom is { } source)
{
    <div class="panel">
        <div class="panel-head">Borrowed art</div>
        <p class="card-count">
            This record ships no art of its own. The image above belongs to
            <a href="@Ui.Href(source.Table, source.NetId)">@source.Name</a>, which is where it was taken
            from.
        </p>
    </div>
}

@if (Model.Grants is { } grants)
{
    <div class="panel">
        <div class="panel-head">
            Grants an ability
            @if (grants.DisplayName is { } name)
            {
                <span class="n">@name</span>
            }
        </div>
        @await Html.PartialAsync("_Detail", grants)
    </div>
}

@if (Model.LegendaryStats is { Count: > 0 } legendaries)
{
    <div class="panel">
        <div class="panel-head">Legendary stats <span class="n">@legendaries.Count</span></div>
        @foreach (var roll in legendaries)
        {
            <hr class="rule">
            <p class="mega-sec-head">@(roll.DisplayName ?? roll.Name)</p>
            @await Html.PartialAsync("_Detail", roll)
        }
    </div>
}

@if (uncovered.Count > 0)
{
    <div class="panel">
        <div class="panel-head">Not yet laid out <span class="n">@uncovered.Count</span></div>
        <p class="card-count">
            Fields the export carries that this page has no section for. They appear here as the JSON
            the extractor wrote rather than being dropped, so a field added upstream is visible before
            anybody remembers to lay it out.
        </p>
        @foreach (var (label, json) in uncovered)
        {
            <hr class="rule">
            <p class="mega-sec-head">@label</p>
            <pre class="raw">@json</pre>
        }
    </div>
}
