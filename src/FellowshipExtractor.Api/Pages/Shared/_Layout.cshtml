@inject CodexView View
@{
    var title = ViewData["Title"] as string;
    var breadcrumb = ViewData["Breadcrumb"] as IReadOnlyList<(string Label, string? Href)> ?? [];
}
<!DOCTYPE html>
<html lang="en" data-theme="fellowship">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(title is null ? "Fellowship Codex" : title + " - Fellowship Codex")</title>
    @* The palette is the game's own design system, written straight out of the export as custom
       properties. Nothing in the stylesheet picks a colour: every rule names one of these. *@
    <style>
        :root {
            @Html.Raw(View.Tokens.CssVariables())
            --chrome-panel: url("@View.Chrome.Panel");
            --chrome-rule: url("@View.Chrome.Rule");
            --chrome-header: url("@View.Chrome.Header(null)");
            --chrome-slot: url("@View.Chrome.SlotPlate");
            --chrome-arrow: url("@View.Chrome.SlotGlyph");
        }

        @Html.Raw(View.RichTextCss("prose"))
    </style>
    <link rel="stylesheet" href="~/css/codex.css" asp-append-version="true">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ctext y='26' font-size='26'%3E%F0%9F%9B%A1%3C/text%3E%3C/svg%3E">
</head>
<body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
        <div class="bar">
            <a class="brand" href="/">
                <span class="brand-mark" aria-hidden="true"></span>
                <span class="brand-name">Fellowship <b>Codex</b></span>
            </a>

            <nav class="mega" aria-label="Categories">
                <ul class="mega-bar">
                    @foreach (var group in View.Codex.Menu)
                    {
                        <li class="mega-group">
                            <button type="button" class="mega-open" aria-expanded="false">@group.Label</button>
                            @* Laid out in CSS columns rather than one column per entity type: a type
                               with six facets and one with none would otherwise leave the panel as a
                               single tall stack beside two empty ones. *@
                            <div class="mega-panel">
                                <div class="mega-cols">
                                    @foreach (var entry in group.Entries)
                                    {
                                        <a class="mega-head" href="/browse@(entry.Query)">
                                            @entry.Label <span class="n">@entry.Count.ToString("N0")</span>
                                        </a>
                                        @foreach (var part in entry.Sections)
                                        {
                                            <div class="mega-sec">
                                                <p class="mega-sec-head">@part.Label</p>
                                                <ul>
                                                    @foreach (var link in part.Links)
                                                    {
                                                        var tone = link.Colour is null ? null : $"color:{link.Colour}";
                                                        <li>
                                                            <a href="/browse@(link.Query)" style="@tone">
                                                                @link.Label <span class="n">@link.Count.ToString("N0")</span>
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </nav>

            <form class="omnibox" action="/browse" method="get" role="search" autocomplete="off">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
                    <path d="M16 16l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                </svg>
                <input type="search" name="q" id="omnibox" placeholder="Search items, abilities, talents, creatures"
                       aria-label="Search the codex" aria-expanded="false" aria-controls="omnibox-results"
                       role="combobox" value="@(ViewData["Query"] as string)">
                <button type="button" class="omnibox-clear" hidden aria-label="Clear search">&times;</button>
                <div class="omnibox-drop" id="omnibox-results" role="listbox" hidden></div>
            </form>
        </div>
    </header>

    @if (breadcrumb.Count > 0)
    {
        <nav class="crumbs" aria-label="Breadcrumb">
            <ol>
                <li><a href="/">Database</a></li>
                @foreach (var (label, href) in breadcrumb)
                {
                    <li>
                        @if (href is null)
                        {
                            <span>@label</span>
                        }
                        else
                        {
                            <a href="@href">@label</a>
                        }
                    </li>
                }
            </ol>
        </nav>
    }

    <main id="main">
        @RenderBody()
    </main>

    <footer class="foot">
        <p>
            Every name, number, colour and texture on this page is read out of the shipped Fellowship
            build by <b>FellowshipExtractor</b>. @View.Store.Count.ToString("N0") entities,
            @View.Store.Vocabulary.Colors.Count design-system colours,
            @View.Store.Vocabulary.Rarities.Count rarity rungs.
        </p>
        <p class="foot-links">
            <a href="/api/catalog">catalog</a>
            <a href="/openapi/v1.json">openapi</a>
        </p>
    </footer>

    <script src="~/js/codex.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
