<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FellowshipExtractor.ServiceDefaults\FellowshipExtractor.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Fellowship.SDK\Fellowship.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Fellowship.SDK" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Storage.Blobs" Version="13.4.6" />

    <!--
      Carries its own dart-sass binaries per RID, so there is no npm, no node and no PATH
      dependency. Its targets run before ResolveScopedCssInputs, which is what lets a
      Foo.razor.scss become the Foo.razor.css the Razor SDK scopes and bundles.
    -->
    <PackageReference Include="AspNetCore.SassCompiler" Version="1.102.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />

    <!--
      Microsoft.AspNetCore.OpenApi 10.0.10 still resolves Microsoft.OpenApi 2.0.0, which carries
      GHSA-v5pm-xwqc-g5wc. Patched in 2.7.5, so the direct reference lifts the transitive one.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

</Project>
