codex.fellowshipanalyzer.com {
	# Lightpanda runs the catalogue filter gate's script, and each page it loads starts a circuit.
	@lightpanda header User-Agent *Lightpanda*
	@lightpandaHint header Sec-Ch-Ua *Lightpanda*
	respond @lightpanda 403
	respond @lightpandaHint 403

	reverse_proxy 127.0.0.1:5280

	log {
		output file /var/log/caddy/codex.log {
			roll_size 10mb
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
			}
		}
	}
}
